#!/bin/sh

#
# updateconf - Manage .@EPKGNEW_EXT@ configuration files
#
# Description:
#   This script helps system administrators merge new configuration files
#   (with .@EPKGNEW_EXT@ extension) with existing ones after package updates.
#

# Directories searched for .@EPKGNEW_EXT@ files. 'backup=' in a recipe can name any
# path inside the package, not only /etc. Override from the environment.
SEARCH_DIRS="${SEARCH_DIRS:-"/etc /boot /opt /usr /var"}"

usage() {
    cat <<EOF
Usage: ${0##*/} [-h | --help]

Review the .@EPKGNEW_EXT@ files that @PROJECT_NAME@ leaves when an update would overwrite
a configuration file listed in 'backup='. For each one the differences
against the installed file are shown and you choose what to do:

    U  Update   replace the current file with the new .@EPKGNEW_EXT@ version
                (your local changes are lost)

    D  Discard  delete the .@EPKGNEW_EXT@ and keep the current file
                (the new defaults are lost)

    E  Edit     open the current file in \$EDITOR to merge by hand, then show
                the diff again; if it ends up identical, the .@EPKGNEW_EXT@ is removed

    K  Keep     leave both files as they are; the .@EPKGNEW_EXT@ shows up again the
                next time you run ${0##*/}

A .@EPKGNEW_EXT@ identical to the current file, or whose current file does not exist,
is removed without asking. A summary of what was done is printed at the end.

Environment:
    EDITOR       editor used by Edit, arguments allowed (default: vim)
    SEARCH_DIRS  directories searched for .@EPKGNEW_EXT@ files (now: $SEARCH_DIRS)

Examples:
    ${0##*/}                   review every pending .@EPKGNEW_EXT@ file
    EDITOR=nano ${0##*/}       use nano for Edit
    SEARCH_DIRS=/etc ${0##*/}  look only in /etc
EOF
}

# Parse arguments
case "$1" in
    -h | --help)
        usage
        exit 0
    ;;

    '') ;;

    *)
        printf "Unknown option: %s\n" "$1" >&2
        printf "Try '%s --help'.\n" "${0##*/}" >&2

        exit 2
    ;;
esac

# Set default editor if not already set
EDITOR="${EDITOR:-vim}"

# Verify editor exists
command -v "$EDITOR" >/dev/null 2>&1 || {
    printf "Editor '%s' not exist. Append 'EDITOR=<your editor>' to %s.\n" "$EDITOR" "${0##*/}"
    exit 2
}

# Check for root privileges
if [ "$(id -u)" -ne 0 ]; then
    printf "This operation need root access. Exiting...\n"
    exit 1
fi

# Find all .@EPKGNEW_EXT@ files. /var/cache is pruned: it holds @PROJECT_NAME@ work dirs,
# whose .@EPKGNEW_EXT@ files belong to packages that are not installed yet.
epkgnew=$(find $SEARCH_DIRS -path /var/cache -prune -o -type f -name '?*.@EPKGNEW_EXT@' -print 2>/dev/null)

# Exit if no .@EPKGNEW_EXT@ files found
if [ -z "$epkgnew" ]; then
    printf "Nothing to do. Exiting...\n"
    exit 0
fi

set -- ${epkgnew}

total="$#"
n=0
failed=0
summary=""

log() {
    summary="$summary$1: $2
"
}

remove_epkgnew() {
    rm -f "$1" || {
        log "FAILED $2" "$1"
        failed=1

        return
    }

    log "$2" "$1"
}

summary() {
    printf 'Summary (%d .@EPKGNEW_EXT@ file(s) found):\n%s' "$total" "$summary"
    exit "$1"
}

trap 'summary 130' INT

# Process each .@EPKGNEW_EXT@ file
for file; do
    n="$((n + 1))"

    # Remove .@EPKGNEW_EXT@ extension to get original filename
    current_file="${file%.*}"

    # If original file doesn't exist, remove the .@EPKGNEW_EXT@ file
    [ -e "$current_file" ] || {
        remove_epkgnew "$file" "removed (no current file)"
        continue
    }

    # Interactive loop for handling this file
    while true; do
        clear

        # Show unified diff between current and new file
        diff -u --color=auto "$current_file" "$file"
        diff_result="$?"

        # If files are identical, remove .@EPKGNEW_EXT@ and continue
        if [ "$diff_result" -eq 0 ]; then
            remove_epkgnew "$file" "removed (identical)"
            break
        fi

        # Display menu
        printf "\nFile [%d/%d]: %s\n" "$n" "$total" "$current_file"
        printf "\n[U]pdate [D]iscard [E]dit [K]eep ?: "

        read -r ACTION || {
            printf "\n"
            log "aborted (EOF)" "$file"

            summary 1
        }

        printf "\n"

        # Process user's choice
        case "$ACTION" in
            U | u)
                mv -f "$file" "$current_file" || {
                    log "FAILED update" "$current_file"
                    failed=1

                    break
                }

                log "updated" "$current_file"
                break
            ;;

            D | d)
                remove_epkgnew "$file" "discarded"
                break
            ;;

            E | e) "$EDITOR" "$current_file" ;;

            K | k)
                log "kept" "$file"
                break
            ;;

            # Invalid option - loop continues to show menu again
            *) ;;
        esac
    done
done

clear
summary "$failed"
