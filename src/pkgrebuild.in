#!/bin/sh

# shellcheck disable=SC2317
#
# pkgrebuild - Rebuild base packages in correct toolchain order
#
# This script rebuilds system toolchain and base packages for emerald package
# manager, ensuring proper build order and dependency resolution.
# POSIX-compliant implementation for maximum portability.

# Vars
PKGDB_DIR="$(pkgadd --print-db-dir)"
TOOLCHAIN_REBUILD=1
BASE_REBUILD=1

# Print informational message to stdout
msg_info() {
    printf "==> %s\n" "$1"
}

# Print error message to stderr
msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

# Display usage information and exit
help() {
    cat <<'EOF'
Usage:
    pkgrebuild <options>

Options:
    (no args)        rebuild toolchain AND base (default)
    -t, --toolchain  rebuild toolchain only
    -b, --base       rebuild base only
    -h, --help       Show this help
EOF
	  exit 0
}

require_root() {
    # Verify root privileges - required for package installation
    if [ "$(id -u)" -ne 0 ]; then
        msg_error "Rebuild packages requires root access!"
        exit 1
    fi
}

# Parse command line options, build toolchain and base by default
parse_opts() {
    while [ -n "$1" ]; do
        case "$1" in
            "") : ;;  # default: rebuild toolchain and base
            -t | --toolchain) BASE_REBUILD=0 ;;
            -b | --base) TOOLCHAIN_REBUILD=0 ;;
            -h | --help) help ;;

            *)
                msg_info "Invalid option! ($1)";
                exit 1
            ;;
        esac

        shift
    done
}

# Rebuild toolchain packages in proper dependency order
toolchain_rebuild() {
    require_root
    msg_info "Rebuilding toolchain..."

    # Iterate through toolchain packages in dependency order
    for tc in $TOOLCHAIN; do
        # Skip if package already rebuilt (recorded in tracking list)
        grep -Fx "$tc" "$LIST" >/dev/null 2>&1 || {
            # Remove -pass1 suffix to get actual package name
            pkgname="$(printf "%s" "$tc" | sed 's/-pass1//')"

            # Force rebuild of package
            emerald build -f "$pkgname" || exit 1

            # Record package as rebuilt (prevents duplicate builds)
            printf "%s\n" "$tc" >> "$LIST"

            # Install rebuilt package to system
            emerald install -r "$pkgname" || exit 1
        }
    done

    msg_info "Rebuilding toolchain done."
}

# Rebuild all base system packages except toolchain components
base_rebuild() {
    require_root

    # Locate base package in database
    BASE=$(find "$PKGDB_DIR" -type f -name 'base' 2>/dev/null | sed 's|.*/||' | head -n 1)

    # Validate that base package was found
    if [ -z "$BASE" ]; then
        msg_error "No base package found in $PKGDB_DIR"
        exit 1
    fi

    msg_info "Rebuilding $BASE..."

    # Get dependency list for base package and process each dependency
    for pkg in $(emerald deplist "$BASE" | awk '{print $2;}'); do
        # Skip toolchain packages - these are handled by toolchain_rebuild()
        case " $TOOLCHAIN " in
            *" $pkg "*) continue ;;
        esac

        # Skip if package already rebuilt (recorded in tracking list)
        grep -Fx "$pkg" "$LIST" >/dev/null 2>&1 || {
            # Force rebuild of package
            emerald build -f "$pkg" || exit 1

            # Record package as rebuilt (prevents duplicate builds)
            printf "%s\n" "$pkg" >> "$LIST"

            # Install rebuilt package to system
            emerald install -r "$pkg" || exit 1
        }
    done

    msg_info "Rebuilding $BASE done."
}

# Define toolchain build order:
TOOLCHAIN="linux-api-headers glibc-pass1 glibc-32-pass1 binutils-pass1 gcc-pass1 glibc glibc-32 binutils gcc libtool libxcrypt libmpc elfutils libmpfr"

# Parse command line arguments
parse_opts "$@"

# Initialize tracking file to record which packages have been rebuilt
# This prevents duplicate builds if script is interrupted and rerun
LIST="/tmp/${0##*/}-list"

touch "$LIST" || {
    msg_error "Cannot create temporary file: $LIST"
    exit 1
}

# Rebuild toolchain 
[ "$TOOLCHAIN_REBUILD" -eq 1 ] && toolchain_rebuild

# Rebuild base
[ "$BASE_REBUILD" -eq 1 ] && base_rebuild

exit 0
