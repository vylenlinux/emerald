#!/bin/sh

#
# mdpurge - remove unused build dependencies
#

set -f

usage() {
    cat <<'EOF'
Usage:
    mdpurge [options] [package ...]

Options:
    -n, --dryrun  print packages without removing them
    -y, --yes     remove without confirmation
    -h, --help    print this help

If package names are provided, only those packages are considered.
Without package names, all eligible build dependencies are considered.
Runtime dependencies and world packages are never removed.
EOF
}

msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

cleanup() {
    [ -z "$TMPDIR" ] || rm -rf "$TMPDIR"
}

contains() {
    grep -Fqx "$1" "$2" 2>/dev/null
}

require_port() {
    emerald path "$1" >/dev/null 2>&1 || {
        msg_error "cannot verify dependencies of '$1'; its port is unavailable"
        exit 1
    }
}

read_list() {
    # Print non-empty, non-comment lines from a list file.
    sed '/^[[:space:]]*$/d;/^[[:space:]]*#/d' "$1"
}

write_world() {
    read_list "$WORLD_FILE" | sort -u > "$TMPDIR/world"

    [ -s "$TMPDIR/world" ] || {
        msg_error "world is empty; nothing can be purged safely"
        exit 1
    }
}

write_installed() {
    find "$PKGDB" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort -u > "$TMPDIR/installed"

    while IFS= read -r pkg; do
        [ -n "$pkg" ] || continue
        require_port "$pkg"
    done < "$TMPDIR/installed"

    while IFS= read -r pkg; do
        contains "$pkg" "$TMPDIR/installed" || {
            msg_error "world package '$pkg' is not installed"
            exit 1
        }

        require_port "$pkg"
    done < "$TMPDIR/world"
}

run_deplist() {
    # $1: mode (runtime or build)
    # $2: package-list file
    # $3: output file
    mode="$1"
    list="$2"
    output="$3"

    # shellcheck disable=SC2046
    set -- $(cat "$list")
    : > "$output"

    [ "$#" -gt 0 ] || return 0

    case "$mode" in
        runtime) emerald deplist -q -a "$@" > "$output" 2>/dev/null ;;
        build) emerald deplist -q -a -m "$@" > "$output" 2>/dev/null ;;
        *) return 2 ;;
    esac
}

write_world_runtime() {
    run_deplist runtime "$TMPDIR/world" "$TMPDIR/world-runtime" || {
        msg_error "cannot build the world runtime dependency graph"
        exit 1
    }
}

write_world_build() {
    run_deplist build "$TMPDIR/world" "$TMPDIR/world-build" || {
        msg_error "cannot build the world build-dependency graph"
        exit 1
    }
}

write_required_runtime() {
    # A candidate must not protect itself, but dependencies of every other
    # installed package must remain protected. Exclude candidates first, then
    # compute the union in one emerald process instead of once per package.
    awk 'NR == FNR {
        candidate[$0] = 1;
        next;
    } !candidate[$0];' "$TMPDIR/candidates" "$TMPDIR/installed" > "$TMPDIR/runtime-roots"

    : > "$TMPDIR/required-runtime"
    [ -s "$TMPDIR/runtime-roots" ] || return 0

    # shellcheck disable=SC2046
    emerald deplist -q -a $(cat "$TMPDIR/runtime-roots") > "$TMPDIR/required-runtime" 2>/dev/null || {
        msg_error "cannot verify runtime dependencies of installed packages"
        exit 1
    }

    sort -u "$TMPDIR/required-runtime" -o "$TMPDIR/required-runtime"
}

write_candidates() {
    if [ -n "$REQUESTED" ]; then
        for pkg in $REQUESTED; do
            printf '%s\n' "$pkg"
        done | sort -u > "$TMPDIR/candidates"

        return 0
    fi

    # Build closure minus world runtime closure. The difference contains
    # build-only packages and runtime dependencies exclusive to them.
    sort -u "$TMPDIR/world-build" > "$TMPDIR/build-set"
    sort -u "$TMPDIR/world-runtime" > "$TMPDIR/runtime-set"

    awk 'NR == FNR {
        keep[$0] = 1;
        next;
    } !keep[$0];' "$TMPDIR/runtime-set" "$TMPDIR/build-set" > "$TMPDIR/candidates"
}

filter_candidates() {
    : > "$TMPDIR/safe"

    while IFS= read -r pkg; do
        [ -n "$pkg" ] || continue

        contains "$pkg" "$TMPDIR/installed" || {
            [ -n "$REQUESTED" ] && msg_error "'$pkg' is not installed; skipping"
            continue
        }

        contains "$pkg" "$TMPDIR/world-build" || {
            [ -n "$REQUESTED" ] && msg_error "'$pkg' is not a current makedepend; skipping"
            continue
        }

        contains "$pkg" "$TMPDIR/world" && continue
        contains "$pkg" "$TMPDIR/world-runtime" && continue
        contains "$pkg" "$TMPDIR/required-runtime" && continue

        printf '%s\n' "$pkg" >> "$TMPDIR/safe"
    done < "$TMPDIR/candidates"

    sort -u "$TMPDIR/safe" -o "$TMPDIR/safe"
}

remove_safe() {
    if [ "$DRYRUN" -eq 1 ]; then
        sed 's/^/  - /' "$TMPDIR/safe"
        return 0
    fi

    # shellcheck disable=SC2046
    emerald remove $(cat "$TMPDIR/safe")
}

DRYRUN=0
YES=0
REQUESTED=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -n | --dryrun) DRYRUN=1 ;;

        -h | --help)
            usage
            exit 0
        ;;

        -*)
            msg_error "unknown option: $1"
            usage >&2

            exit 2
        ;;

        *) REQUESTED="$REQUESTED $1" ;;
    esac

    shift
done

WORLD_FILE="@STATE_DIR@/world"

PKGDB=$(pkgadd --print-db-dir 2>/dev/null) || {
    msg_error "cannot determine the package database directory"
    exit 1
}

TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/mdpurge.XXXXXX") || {
    msg_error "cannot create a temporary directory"
    exit 1
}

trap cleanup 0 1 2 3 15

[ -s "$WORLD_FILE" ] || {
    if [ -z "$REQUESTED" ]; then
        printf "mdpurge: world is empty; nothing to purge.\n"
        exit 0
    fi

    msg_error "world is empty; no package can be verified safely"
    exit 1
}

write_world
write_installed
write_world_runtime
write_world_build
write_candidates
write_required_runtime
filter_candidates

[ -s "$TMPDIR/safe" ] || {
    printf "No safe-to-remove makedepends found.\n"
    exit 0
}

remove_safe
