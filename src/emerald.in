#!/bin/sh

# shellcheck disable=SC2317

# vars
BUILD_SCRIPT="build.eme"
PKGDB_DIR="$(pkgadd --print-db-dir)"
CBUILD_DIR="@STATE_DIR@/cbuild"
WORLD_FILE="@STATE_DIR@/world"
REPO_FILE="${REPO_FILE:-@SYSCONFDIR@/emerald.repo}"
MASK_FILE="${MASK_FILE:-@SYSCONFDIR@/emerald.mask}"
CONFIG_FILE="${CONFIG_FILE:-@SYSCONFDIR@/emerald.conf}"
ALIAS_FILE="${ALIAS_FILE:-@SYSCONFDIR@/emerald.alias}"

# check alias port
grep -qEv '^(#|[[:space:]]*$)' "$ALIAS_FILE" 2>/dev/null && ALIAS_PORT="yes" || ALIAS_PORT="no"

# default value from pkgbuild
SOURCE_DIR="@CACHE_DIR@/sources"
PACKAGE_DIR="@CACHE_DIR@/packages"
CURL_OPTS=""
COMPRESSION_MODE="xz"
NO_STRIP="no"
IGNORE_CHECKSUM="no"
KEEP_DOC="no"
KEEP_GOING="no"
KEEP_LIBTOOL="no"
KEEP_LOCALE="no"
KEEP_MAN="no"
NOCOLOR="no"
THEME="vylen"

# apply emerald.conf
# shellcheck source=@SYSCONFDIR@/emerald.conf
. "${CONFIG_FILE}"

# color themes
colors_dracula() {
    COLOR1='\033[38;5;203m' # pink
    COLOR2='\033[38;5;84m'  # cyan-green
    COLOR3='\033[38;5;228m' # yellow
    COLOR4='\033[38;5;117m' # light blue
    COLOR5='\033[38;5;141m' # purple
    CRESET='\033[0m'        # reset
}

colors_nord() {
    COLOR1='\033[38;5;174m' # soft red
    COLOR2='\033[38;5;108m' # desaturated green
    COLOR3='\033[38;5;179m' # warm yellow
    COLOR4='\033[38;5;109m' # nord blue
    COLOR5='\033[38;5;139m' # nord purple
    CRESET='\033[0m'        # reset
}

colors_vylen() {
    COLOR1='\033[38;5;1m' # red
    COLOR2='\033[38;5;2m' # green
    COLOR3='\033[38;5;3m' # yellow
    COLOR4='\033[38;5;4m' # blue
    COLOR5='\033[36m'     # cyan
    CRESET='\033[0m'      # reset
}

load_colors() {
    # reset all vars
    COLOR1=
    COLOR2=
    COLOR3=
    COLOR4=
    COLOR5=
    CRESET=

    [ "$NOCOLOR" = "yes" ] && return 0

    case "$THEME" in
        dracula) colors_dracula ;;
        nord) colors_nord ;;
        *) colors_vylen ;;
    esac
}

# apply color theme
load_colors

msg_info() {
    printf "%b==>%b %s\n" "$COLOR2" "$CRESET" "$1"
}

msg_error() {
    printf "%bERROR:%b %s\n" "$COLOR1" "$CRESET" "$1" >&2
}

msg_warning() {
    printf "%bWARNING:%b %s\n" "$COLOR3" "$CRESET" "$1" >&2
}

msg_port_not_found() {
    printf "Port '%s' not found.\n" "$1"
}

msg_port_not_installed() {
    printf "Port '%s' not installed.\n" "$1"
}

msg_port_already_installed() {
    printf "Port '%s' already installed.\n" "$1"
}

msg_deps_status() {
    for i in "$@"; do
        if emerald_is_installed "$i"; then
            printf "[%bi%b] %s\n" "$COLOR2" "$CRESET" "$i"
        elif get_port_path "$i" >/dev/null; then
            printf "[-] %s\n" "$i"
        else
            printf "[%bm%b] %s\n" "$COLOR3" "$CRESET" "$i"
        fi
    done

    unset i
}

get_port_path() {
    for repo in $PORT_REPO; do
        if [ -f "$repo/$1/$BUILD_SCRIPT" ]; then
            printf '%s/%s\n' "$repo" "$1"
            return 0
        fi
    done

    return 1
}

require_root() {
    [ "$(id -u)" -ne 0 ] && {
        msg_error "this operation requires root privileges!"
        exit 1
    }
}

get_iversion() {
    [ -f "$PKGDB_DIR/$1" ] || return 1

    read -r _iv _ir _ < "$PKGDB_DIR/$1"
    printf '%s-%s\n' "$_iv" "$_ir"
}

get_version() {
    p=$(get_port_path "$1") || return 1

    awk '/^version=/ {
        v = $0;

        sub(/^version=/, "", v);
        gsub(/["'\'']/, "", v);
    } /^release=/ {
        r = $0;

        sub(/^release=/, "", r);
        gsub(/["'\'']/, "", r)
    } END {
        if (v == "") v = 0;
        if (r == "") r = 0;

        printf "%s-%s", v, r;
    }' "$p/$BUILD_SCRIPT"
}

all_installed() {
    find "$PKGDB_DIR" -maxdepth 1 -type f -printf '%f\n'
}

deps_alias() {
    printf '%s\n' $deps | awk -v alias_file="$ALIAS_FILE" 'BEGIN {
        while ((getline line < alias_file) > 0) {
            if (line ~ /^[[:space:]]*$/ || line ~ /^#/) continue;

            split(line, a);
            alias[a[1]] = a[2];
        }

        close(alias_file);
    } {
        print ($0 in alias) ? alias[$0] : $0;
    }'
}

get_depends() {
    if [ -f "$CBUILD_DIR/${1}.dep" ]; then
        deps_file="$CBUILD_DIR/$1.dep"
    else
        ppath=$(get_port_path "$1") || return 0
        deps_file="$ppath/depends"
    fi

    [ -f "$deps_file" ] || return 0
    deps=$(grep -v '^$' "$deps_file")

    [ "$ALIAS_PORT" = "yes" ] && deps_alias "$deps" || printf "%s" "$deps"
}

confirm() {
    printf "%s (Y/n) " "$1"
    read -r response

    case "$response" in
        [Nn][Oo] | [Nn])
            printf "%s\n" "$2"
            return 2
        ;;

        *) : ;;
    esac

    return 0
}

need_arg() {
    [ "$*" ] || {
        printf "This operation required an arguments!\n"
        exit 1
    }
}

keep_going() {
    [ "$KEEP_GOING" = "yes" ] || [ "$KEEP_GOING_LOCAL" = 1 ]
}

set_term_title() {
    printf "\033]0;%s\a" "$*"
}

summary_show() {
    failed="$1"  # $1 -> list of failed packages
    skipped="$2" # $2 -> list of skipped packages (may be empty)
    action="$3"  # $3 -> action: install, upgrade, build, ...

    # If there is nothing to report, return silently
    [ -n "$failed" ] || [ -n "$skipped" ] || return 0

    # Separate summary from previous output
    printf '\n'

    # Report failed packages
    if [ -n "$failed" ]; then
        msg_error "The following packages failed to $action:"

        for p in $failed; do
            printf "  - %s\n" "$p"
        done
    fi

    # Report skipped packages (if any)
    if [ -n "$skipped" ]; then
        msg_warning "The following packages were skipped:"

        for p in $skipped; do
            printf "  - %s\n" "$p"
        done
    fi
}

summary_title() {
    error="$1"    # $1 -> error flag (0 if success, non-zero if errors occurred)
    done_pkg="$2" # $2 -> list of successfully processed packages
    count="$3"    # $3 -> normal counter (used when no errors occurred)
    total="$4"    # $4 -> total number of packages
    action="$5"   # $5 -> action: installed, upgraded, built, ...

    if [ "$error" -eq 0 ]; then
        # Fast path: no errors, use the normal counter
        set_term_title "$count/$total package(s) $action."
        return 0
    fi

    # When errors occurred, recalculate the number of successfully processed packages
    successful_count="$(printf "%s\n" "$done_pkg" | wc -w)"
    set_term_title "$successful_count/$total package(s) $action."
}

emerald_build() {
    failed_builds=""

    while [ "$1" ]; do
        case $1 in
            -i | -u | -r | -g | -p) ;;
            --log) LOG=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    [ -z "$PKGNAME" ] && {
        printf "Please specify package(s) to build.\n"
        return 1
    }

    for pkg in $PKGNAME; do
        ppath=$(get_port_path "$pkg") || {
            msg_port_not_found "$pkg"

            # If keep going is enabled, log and continue
            if keep_going; then
                failed_builds="$failed_builds $pkg"
                continue
            fi

            return 1
        }

        cd "$ppath" || return 1
            set_term_title "Building $pkg..."

            # Run pkgbuild and capture the result
            if [ "$LOG" ]; then
                pkgbuild $OPTS | tee "/var/log/$pkg-$(get_version "$pkg")-build-$(date +%Y-%m-%d-%H:%M).log"
                _build_ret=$?
            else
                pkgbuild $OPTS
                _build_ret=$?
            fi

            if [ "$_build_ret" -eq 0 ]; then
                settermtitle "Building $pkg done."
            else
                settermtitle "Building $pkg failed."

                if keep_going; then
                    msgwarn "Build failed for '$pkg', continuing with next package..."
                    failed_builds="$failed_builds $pkg"
                else
                    return 1
                fi
            fi
        cd - >/dev/null || return 1
    done

    # Show error summary if exist
    FAILED_PKGS="$failed_builds"
    SKIPPED_PKGS=""

    summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "build"
    [ -n "$FAILED_PKGS" ] && return 1

    return 0
}

human_size() {
    # Converts bytes to a human-readable size with one decimal
    b=$1

    awk -v b="$b" 'BEGIN {
        suf="B K M G T P";
        split(suf, u);

        i = 1;
        val = b;

        while ((val >= 1024) && i < 6) {
            val /= 1024;
            i++;
        }

        printf "%.1f%s", val, u[i];
    }'
}

diff_lists() {
    # Diff lists (all - keep)
    all="$1"
    keep="$2"
    out=""
    oldIFS=$IFS
    IFS='|'

    set -- $all
    IFS=$oldIFS

    for f; do
        case "|$keep|" in
            *"|$f|"*) ;; # keep
            *) out="${out}${out:+|}$f" ;;
        esac
    done

    printf '%s' "$out"
}

show_list() {
    # Show files and sizes
    list="$1"
    dir="$2"

    [ -z "$list" ] && return 0

    # Print list, one file per line
    oldIFS=$IFS
    IFS='|'

    set -- $list
    IFS=$oldIFS

    for f; do
        printf '%s\n' "$f"
    done

    # Calculate total size
    total=0

    for f; do
        [ -f "$dir/$f" ] || continue

        sz=$(wc -c <"$dir/$f" 2>/dev/null || printf "0\n")
        total=$((total + sz))
    done

    printf "Total size %s: %s\n\n" "${dir##*/}" "$(human_size "$total")"
}

emerald_cache() {
    require_root "Clear old caches"

    clean_pkg=1
    clean_src=1

    case "${1:-}" in
        "") : ;;  # default: clean both
        -p | --pkg) clean_src=0 ;;
        -s | --src) clean_pkg=0 ;;

        -h | --help)
            cat <<'EOF'
Usage: emerald cache [pkg|src]

  (no args)   clean packages AND sources cache
  -p, --pkg   clean packages cache only
  -s, --src   clean sources cache only
EOF
            return 0
        ;;

        *)
            msg_error "Invalid argument: $1"
            return 1
        ;;
    esac

    # Internal lists (compact with | separator)
    allpkg=""
    allsrc=""
    keeppkg=""
    keepsrc=""

    # Scan package cache
    if [ "$clean_pkg" -eq 1 ]; then
        for f in $(find "$PACKAGE_DIR" -type f 2>/dev/null); do
            file=${f##*/}
            allpkg="${allpkg}${allpkg:+|}$file"
        done
    fi

    # Scan source cache
    if [ "$clean_src" -eq 1 ]; then
        for f in $(find "$SOURCE_DIR" -type f 2>/dev/null); do
            file=${f##*/}
            allsrc="${allsrc}${allsrc:+|}$file"
        done
    fi

    # Scan PKGDB to determine what to keep
    for portname in $(all_installed); do
        # Cache portpath to avoid calling get_port_path multiple times
        portpath=$(get_port_path "$portname")

        if [ -z "$portpath" ]; then
            msg_error "$portname archived, remove it."
            continue
        fi

        # Keep packages - use get_iversion function
        if [ "$clean_pkg" -eq 1 ]; then
            pvr=$(get_iversion "$portname")
            [ -n "$pvr" ] && pkgname="${portname}-${pvr}.epkg.tar.${COMPRESSION_MODE}"

            keeppkg="${keeppkg}${keeppkg:+|}$pkgname"
        fi

        # Keep sources - read from .checksums file
        if [ "$clean_src" -eq 1 ]; then
            checksums_file="$portpath/.checksums"

            if [ -f "$checksums_file" ]; then
                # Read checksum and filename directly (space-separated)
                while read -r _ filename; do
                    # Skip empty lines and ensure filename exists
                    [ -n "$filename" ] && keepsrc="${keepsrc}${keepsrc:+|}$filename"
                done < "$checksums_file"
            fi
        fi
    done

    to_remove_pkg=""
    to_remove_src=""

    [ "$clean_pkg" -eq 1 ] && to_remove_pkg=$(diff_lists "$allpkg" "$keeppkg")
    [ "$clean_src" -eq 1 ] && to_remove_src=$(diff_lists "$allsrc" "$keepsrc")

    show_list "$to_remove_pkg" "$PACKAGE_DIR"
    show_list "$to_remove_src" "$SOURCE_DIR"

    # Nothing to remove?
    if [ -z "$to_remove_pkg" ] && [ -z "$to_remove_src" ]; then
        msg_info "Cache is already clean."
        return 0
    fi

    # Confirm deletion
    if confirm "Remove old caches?" "Old caches are kept."; then
        # delete in parallel
        [ -n "$to_remove_pkg" ] && printf '%s' "$to_remove_pkg" | tr '|' '\n' | xargs -P "$(nproc)" -I{} rm -f "$PACKAGE_DIR/{}"
        [ -n "$to_remove_src" ] && printf '%s' "$to_remove_src" | tr '|' '\n' | xargs -P "$(nproc)" -I{} rm -f "$SOURCE_DIR/{}"

        msg_info "Old caches removed!"
    fi
}

emerald_cat() {
    need_arg "$@"

    PPATH=$(get_port_path "$1") || {
        msg_port_not_found "$1"
        return 1
    }

    cat "$PPATH/$BUILD_SCRIPT"
}

emerald_config() {
    printf '%b%s%b %s\n' "$COLOR5" "MAINOPTS:" "$CRESET" "$MAINOPTS"
    printf '%b%s%b %s\n' "$COLOR5" "REPO_FILE:" "$CRESET" "$REPO_FILE"
    printf '%b%s%b %s\n' "$COLOR5" "MASK_FILE:" "$CRESET" "$MASK_FILE"
    printf '%b%s%b %s\n' "$COLOR5" "CONFIG_FILE:" "$CRESET" "$CONFIG_FILE"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "CFLAGS:" "$CRESET" "$COLOR2" "$CFLAGS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "CXXFLAGS:" "$CRESET" "$COLOR2" "$CXXFLAGS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "FCFLAGS:" "$CRESET" "$COLOR2" "$FCFLAGS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "FFLAGS:" "$CRESET" "$COLOR2" "$FFLAGS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "MAKEFLAGS:" "$CRESET" "$COLOR2" "$MAKEFLAGS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "LDFLAGS:" "$CRESET" "$COLOR2" "$LDFLAGS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "RUSTFLAGS:" "$CRESET" "$COLOR2" "$RUSTFLAGS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "CURL_OPTS:" "$CRESET" "$COLOR4" "$CURL_OPTS" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "COMPRESSION_MODE:" "$CRESET" "$COLOR4" "$COMPRESSION_MODE" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "NO_STRIP:" "$CRESET" "$COLOR4" "$NO_STRIP" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "IGNORE_CHECKSUM:" "$CRESET" "$COLOR4" "$IGNORE_CHECKSUM" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "KEEP_LIBTOOL:" "$CRESET" "$COLOR4" "$KEEP_LIBTOOL" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "KEEP_LOCALE:" "$CRESET" "$COLOR4" "$KEEP_LOCALE" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "KEEP_MAN:" "$CRESET" "$COLOR4" "$KEEP_MAN" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "KEEP_DOC:" "$CRESET" "$COLOR4" "$KEEP_DOC" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "KEEP_GOING:" "$CRESET" "$COLOR4" "$KEEP_GOING" "$CRESET"
    printf '%b%s%b %s\n' "$COLOR5" "SOURCE_DIR:" "$CRESET" "$SOURCE_DIR"
    printf '%b%s%b %s\n\n' "$COLOR5" "PACKAGE_DIR:" "$CRESET" "$PACKAGE_DIR"
    printf '%b%s%b\n' "$COLOR5" "PORT_REPO:" "$CRESET"

    for i in $PORT_REPO; do
        printf '  - %s\n' "${i}"
    done

    return 0
}

emerald_dependent() {
    need_arg "$@"

    get_port_path "$1" >/dev/null 2>&1 || {
        msg_port_not_found "$1"
        return 1
    }

    for repo in $PORT_REPO; do
        awk -v pkg="$1" 'FNR == 1 {
            f = FILENAME;
        } $0 == pkg {
            found = 1;
        } found {
            n = split(f, a, "/");
            print a[n-1];

            found = 0;
            nextfile;
        }' "$repo"/*/depends 2>/dev/null
    done | sort -u | while read -r dpd; do
        msg_deps_status "$dpd"
    done
}

emerald_depends() {
    need_arg "$@"

    get_port_path "$1" >/dev/null || {
        msg_port_not_found "$1"
        return 1
    }

    depends=$(get_depends "$1")
    msg_deps_status $depends
}

deplist() {
    # shellcheck disable=SC3043
    local pkg="$1"

    # skip excluded dependencies
    case " $exclude " in
        *" $pkg "*) return 0 ;;
    esac

    # check for circular dependencies
    case " $CHECK " in
        *" $pkg "*) return 0 ;;
    esac

    # add package to currently processing
    CHECK="$CHECK $pkg "

    # check dependencies
    for dep in $(get_depends "$pkg"); do
        if [ "$quick" = 1 ] && emerald_is_installed "$dep"; then
            continue
        fi

        case " $DEP " in
            *" $dep "*) continue ;;
        esac

        if ! get_port_path "$dep" >/dev/null 2>&1; then
            MISSINGDEP="$MISSINGDEP $dep($pkg) "
        else
            deplist "$dep"
        fi
    done

    # add dependency to list
    case " $DEP " in
        *" $pkg "*) ;;

        *)
            if [ "$quick" = 1 ]; then
                emerald_is_installed "$pkg" || DEP="$DEP $pkg "
            else
                DEP="$DEP $pkg "
            fi
        ;;
    esac

    # remove from processing list
    CHECK=$(printf "%s" "$CHECK" | sed "s/ $pkg / /g")
}

emerald_deplist() {
    # parse arguments
    OLDIFS=$IFS
    IFS=,

    while [ "$1" ]; do
        case $1 in
            -q) quick=1 ;;

            --exclude=*)
                for i in ${1#*=}; do
                    exclude="$exclude $i "
                done
            ;;

            -*) ;;
            *) PKG="$PKG $1 " ;;
        esac

        shift
    done

    IFS=$OLDIFS

    [ -z "$PKG" ] && {
        printf "Please specify port(s) to list dependencies.\n"
        return 1
    }

    # validate packages
    for p in $PKG; do
        if get_port_path "$p" >/dev/null 2>&1; then
            PPKG="$PPKG $p "
        elif [ "$quick" != 1 ]; then
            msg_port_not_found "$p"
        fi
    done

    # process dependencies
    for p in $PPKG; do
        deplist "$p"
    done

    [ "$DEP" ] || return 0

    if [ "$quick" = 1 ]; then
        printf "%s\n" $DEP
        return 0
    fi

    msg_deps_status $DEP

    if [ "$MISSINGDEP" ]; then
        for m in $MISSINGDEP; do
            printf "Missing deps: %s\n" "$m" | sed 's/(/ (/'
        done
    fi
}

dup_status() {
    IFS='|' read -r dversion drelease <<EOF
$(awk '/^version=/ {
    gsub(/version=|["'\'']/, "");
    gsub(/[^A-Za-z0-9._+-]/, "");

    v = $0;
} /^release=/ {
    gsub(/release=|["'\'']/, "");
    gsub(/[^A-Za-z0-9._+-]/, "");

    r = $0;
} END {
    printf "%s|%s", v, r;
}' "$2/$1/$BUILD_SCRIPT")
EOF

    emerald_is_installed "$1" && ins=$(printf "[%bi%b]" "$COLOR2" "$CRESET") || ins="[ ]"
    printf "%b %b(%s)%b %s %b%s-%s%b\n" "$ins" "$COLOR5" "${2##*/}" "$CRESET" "$1" "$COLOR4" "$dversion" "$drelease" "$CRESET"
}

emerald_dup() {
    dup=$(find "$PORT_REPO" -type d -printf '%P\n'| sort | uniq -d)

    if [ -z "$dup" ]; then
        msg_info "No duplicate ports found."
        return 0
    fi

    for dport in $dup; do
        for drepo in $PORT_REPO; do
            [ -d "$drepo/$dport" ] && dup_status "$dport" "$drepo"
        done
    done
}

emerald_files() {
    need_arg "$@"

    ! emerald_is_installed "$1" && {
        msg_port_not_installed "$1"
        return 0
    }

    cat "$PKGDB_DIR/$1"
}

emerald_foreign() {
    foreign_found=0

    for pkg in $(all_installed); do
        if ! get_port_path "$pkg" >/dev/null; then
            iversion=$(get_iversion "$pkg")
            printf "%s %s\n" "$pkg" "$iversion"

            foreign_found=1
        fi
    done

    [ "$foreign_found" -eq 0 ] && msg_info "No foreign packages found."
    return 0
}

emerald_help() {
    cat <<'EOF'
Usage:
    emerald <options> [<arg>]

Options:
    sync                   <arg>    update ports database (use portsync arg)
                                    -p, --prune   prune local git repository
                                    -r, --reset   reset git repositories

    build        <ports>   <arg>    build ports (use pkgbuild arg, except '-i', '-u', '-r', '-g', & '-p')
                                    -f            force rebuild package
				    -k            keep going building next package on error
                                    -m            skip checksum checking
                                    -o            fetch sources only
                                    -q, --quiet   show only status messages and errors
                                    -w            keep working directory
                                    -y            skip ask user confirmation
                                    -C, --clean   remove downloaded sources and prebuilt packages
                                    --log         log build process (/var/log/name-version-release-date.log)

    install      <ports>   <arg>    install ports (use pkgbuild arg, except '-i' & '-u')
                                    -c            ignore conflict when installing package
                                    -f            force rebuild package
				    -k            keep going installing next package on error
                                    -m            skip checksum checking
                                    -n            skip dependencies
                                    -o            fetch sources only
                                    -q, --quiet   show only status messages and errors
                                    -r            reinstall
                                    -w            keep working directory
                                    -y            skip ask user confirmation
                                    --exclude=*   exclude dependencies, comma separated
                                    --no-backup   skip backup when reinstalling package

    upgrade      <ports>   <arg>    upgrade ports (use pkgbuild arg, except '-i' & '-r')
	                            -c            ignore conflict when installing package
                                    -f            force rebuild package
				    -k            keep going upgrading next package on error
                                    -m            skip checksum checking
                                    -n            skip dependencies
                                    -o            fetch sources only
                                    -q, --quiet   show only status messages and errors
                                    -w            keep working directory
                                    -y            skip ask user confirmation
                                    --exclude=*   exclude dependencies, comma separated
                                    --no-backup   skip backup when upgrading package

    sysup                  <arg>    full system upgrade (use pkgbuild arg, except '-i', '-r'  & '-u')
                                    -c            ignore conflict when installing package
                                    -f            force rebuild package
				    -k            keep going upgrading next package on error
                                    -m            skip checksum checking
                                    -n            skip dependencies
                                    -o            fetch sources only
                                    -q, --quiet   show only status messages and errors
                                    -w            keep working directory
                                    -y            skip ask user confirmation
                                    --exclude=*   exclude dependencies, comma separated
                                    --no-backup   skip backup when upgrading package

    remove       <ports>   <arg>    remove installed ports (use pkgdel arg)
                                    -y            skip ask user confirmation

    deplist      <ports>            print all dependencies for ports
                                    -q            skip installed ports
                                    --exclude=*   exclude dependencies, comma separated

    redeps       <ports>   <arg>    find redundant dependencies
                                    -f, --fix     fix (remove) redundant port deps

    cache                           (no args)   clean packages AND sources cache
                                    -p, --pkg   clean packages cache only
                                    -s, --src   clean sources cache only

    cat          <port>             print build.eme
    config                          print emerald config
    dependent    <port>             print reverse dependencies
    depends      <port>             print dependencies
    dup                             print duplicate ports
    files        <port>             print files installed
    foreign                         print foreign ports
    help                            print this help
    hook  <stage> <action> <port>   run port hook on demand (run 'emerald hook' for help)
    info         <port>             print information
    installed                       print all installed ports
    integrity                       check installed port integrity
    is-installed  <port>            check whether port is installed (status 0=installed, 1=not installed)
    locate       <file>             print location of file in ports repo
    missing-deps                    print missing dependencies
    orphan                          print orphan installed ports
    outdated                        print outdated ports
    path         <port>             print path in repo
    provide      <file>             print ports provided file
    purge        [ports]            remove installed ports and its orphan dependencies

    search       <pattern>          find ports in repo
                                    -n, --name   search in port names only

    trigger      [ports]            run system trigger
    world        [ports]            print/add/remove world list

Global options:
    --append-repo=<repo path>       append custom local repo path (can use multiple times)
    --prepend-repo=<repo path>      prepend custom local repo path (can use multiple times)
    --override-repo=<repo path>     override repo in $REPO_FILE with custom local repo (can use multiple times)
    --repo-file=<repo file>         use custom repo file (default: $REPO_FILE)
    --config-file=<config file>     use custom config file (default: $CONFIG_FILE)
    --alias-file=<alias file>       use custom alias file (default: $ALIAS_FILE)
    --mask-file=<mask file>         use custom mask file (default: $MASK_FILE)
EOF
}

emerald_info() {
    need_arg "$@"

    ppath=$(get_port_path "$1") || {
        msg_port_not_found "$1"
        return 1
    }

    IFS='|' read -r version release commit desc maint homep <<EOF
$(awk '/^version=/ {
    sub(/version=/, "");
    gsub(/"/, "");

    v = $0;
} /^release=/ {
    sub(/release=/, "");
    r = $0;
} /^commit=/ {
    sub(/commit=/, "");
    gsub(/"/, "");

    c = $0;
} /^description=/ {
    sub(/description=/, "");
    gsub(/"/, "");

    d = $0;
} /^maintainer=/ {
    sub(/maintainer=/, "");
    gsub(/"/, "");

    m = $0;
} /^homepage=/ {
    sub(/homepage=/, "");
    gsub(/"/, "");

    h = $0;
} END {
    printf "%s|%s|%s|%s|%s|%s", v, r, c, d, m, h;
}' "$ppath/$BUILD_SCRIPT")
EOF

    # Read installed version
    iver="$(get_iversion "$1")"
    [ -z "$iver" ] && iver="Not installed"

    # Read depends file
    deps=$(get_depends "$1" | tr '\n' ' ')
    deps_out=""

    [ -z "$deps" ] && deps_out="None" || {
        for pkg in $deps; do
            emerald_is_installed "${pkg}" && deps_out=$(printf "%s%b%s%b " "${deps_out}" "${COLOR2}" "${pkg}" "${CRESET}") || deps_out=$(printf "%s%b%s%b " "${deps_out}" "${COLOR1}" "${pkg}" "${CRESET}")
        done
    }

    # Check dependent (required by)
    required_by="$(emerald_dependent "$1" | awk '{printf "%s ", $2}')"
    required_by_out=""

    [ -z "${required_by}" ] && required_by_out="None" || {
        for pkg in $required_by; do
            emerald_is_installed "${pkg}" && required_by_out=$(printf "%s%b%s%b " "${required_by_out}" "${COLOR2}" "${pkg}" "${CRESET}") || required_by_out=$(printf "%s%b%s%b " "${required_by_out}" "${COLOR1}" "${pkg}" "${CRESET}")
        done
    }

    printf '%b%s%b %s\n' "$COLOR5" "Description:" "$CRESET" "$desc"
    printf '%b%s%b %s\n' "$COLOR5" "Maintainer:" "$CRESET" "$maint"
    printf '%b%s%b %s\n' "$COLOR5" "Homepage:" "$CRESET" "$homep"
    printf '%b%s%b %s\n' "$COLOR5" "Path:" "$CRESET" "$ppath"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "Name:" "$CRESET" "$COLOR2" "$1" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "Version:" "$CRESET" "$COLOR4" "$version" "$CRESET"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "Release:" "$CRESET" "$COLOR4" "$release" "$CRESET"
    [ "$commit" ] && printf '%b%s%b %s\n' "$COLOR5" "Commit:" "$CRESET" "$commit"
    printf '%b%s%b %b%s%b\n' "$COLOR5" "Installed:" "$CRESET" "$COLOR2" "$iver" "$CRESET"
    printf '%b%s%b %s\n' "$COLOR5" "Depends:" "$CRESET" "$deps_out"
    printf '%b%s%b %s\n' "$COLOR5" "Required by:" "$CRESET" "$required_by_out"
}

hook() {
    # hook <stage> <action> [port]
    # if using -o (download only), dont run hook
    [ "$DOWNLOAD_ONLY" = 1 ] && return 0

    # silent sanity check
    [ "$1" ] && [ "$2" ] || return 0

    hook_stage="$1"
    hook_action="$2"
    port="$3"

    if [ "$port" ]; then
        hook_dir="$(get_port_path "$port")" || return 1
    else
        hook_dir="."
    fi

    hook="$hook_dir/$hook_stage-$hook_action"

    # hook are optional
    if [ -f "$hook" ]; then
        msg_info "hook $hook_stage-$hook_action"
        sh "$hook"
    fi
}

emerald_hook() {
    require_root

    if [ -z "$1" ] || [ -z "$2" ] || [ -z "$3" ]; then
        msg_warning "Usage: emerald hook <stage> <action> <port>"

        msg_info "emerald hook <pre|post> <install|remove> <port>"
        msg_info "Example: emerald hook post install linux"

        return 1
    fi

    stage="$1"
    action="$2"
    port="$3"

    case "$stage" in
        pre | post) ;;

        *)
            msg_error "stage must be 'pre' or 'post'"
            return 1
        ;;
    esac

    case "$action" in
        install | remove) ;;

        *)
            msg_error "action must be 'install' or 'remove'"
            return 1
        ;;
    esac

    hook "$stage" "$action" "$port"
}

emerald_install() {
    require_root "Installing package"

    failed_installs=""
    skipped_installs=""

    while [ "$1" ]; do
        case $1 in
            -i | -u) ;;
            -r) REINSTALL=1 ;;

            -o)
                DOWNLOAD_ONLY=1;
                OPTS="$OPTS $1"
            ;;

            -y | --yes) NOCONFIRM=1 ;;
            -n) NO_DEP=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            --exclude=*) EXOPT=$1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    [ -z "$PKGNAME" ] && {
        printf "Please specify package(s) to install.\n"
        return 1
    }

    # if reinstall, dont calculate dep, just reinstall it then exit
    if [ "$REINSTALL" = 1 ]; then
        error=0

        for ii in $PKGNAME; do
            if ! ppath=$(get_port_path "$ii"); then
                msg_port_not_found "$ii"

                if keep_going; then
                    failed_installs="$failed_installs $ii"
                    continue
                else
                    return 1
                fi
            elif ! emerald_is_installed "$ii"; then
                msg_port_not_installed "$ii"

                if keep_going; then
                    failed_installs="$failed_installs $ii"
                    continue
                else
                    return 1
                fi
            else
                cd "$ppath" || return 1
                    set_term_title "Reinstalling $ii..."

                    if pkgbuild $OPTS -r; then
                        done_pkg="$done_pkg $ii"
                    else
                        if keep_going; then
                            msg_warning "Reinstall failed for '$ii', continuing with next package..."

                            failed_installs="$failed_installs $ii"
                            error=1
                        else
                            error=1

                            cd - >/dev/null || return 1
                            break
                        fi
                    fi
                cd - >/dev/null || return 1
            fi
        done

        [ "$done_pkg" ] && emerald_trigger "$done_pkg"

        # Show error summary if exist
        FAILED_PKGS="$failed_installs"
        SKIPPED_PKGS="$skipped_installs"

        summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "reinstall"
        set_term_title "Package(s) reinstalled."

        return "$error"
    fi

    # No dep
    if [ "$NO_DEP" = 1 ]; then
        error=0

        for ii in $PKGNAME; do
            if ! ppath=$(get_port_path "$ii"); then
                msg_port_not_found "$ii"

                if keep_going; then
                    failed_installs="$failed_installs $ii"
                    continue
                else
                    return 1
                fi
            elif emerald_is_installed "$ii"; then
                msg_port_already_installed "$ii"
                skipped_installs="$skipped_installs $ii"

                continue
            else
                cd "$ppath" || return 1
                    set_term_title "Installing $ii..."

                    if pkgbuild -i $OPTS; then
                        done_pkg="$done_pkg $ii"
                        world_add "$ii"
                    else
                        if keep_going; then
                            msg_warning "Install failed for '$ii', continuing with next package..."

                            failed_installs="$failed_installs $ii"
                            error=1
                        else
                            error=1

                            cd - >/dev/null || return 1
                            break
                        fi
                    fi
                cd - >/dev/null || return 1
            fi
        done

        [ "$done_pkg" ] && emerald_trigger "$done_pkg"

        # Show error summary if exist
        FAILED_PKGS="$failed_installs"
        SKIPPED_PKGS=""

        summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "install"
        set_term_title "Package(s) installed."

        return "$error"
    fi

    for i in $PKGNAME; do
        if ! get_port_path "$i" >/dev/null 2>&1; then
            msg_port_not_found "$i"
        elif emerald_is_installed "$i"; then
            msg_port_already_installed "$i"
        else
            IPKG="$IPKG $i"
        fi
    done

    [ "$IPKG" ] || return 0

    printf "Resolving dependencies...\n"
    INST="$(emerald_deplist -q "$IPKG" "$EXOPT")"

    if [ "$INST" ]; then
        printf "\n"

        pkgcount=0
        installmsg="ACTION#PORTNAME#VERSION"

        for pkg in $INST; do
            pkgcount=$(( pkgcount + 1 ))
            installmsg="$installmsg install#$pkg#$(get_version "$pkg")"
        done

        printf "%s\n" "$installmsg" | tr ' ' '\n' | tr '#' ' ' | column -t
        printf "\n"
        printf "( %s install )\n" "$pkgcount"
        printf "\n"

        [ "$NOCONFIRM" != 1 ] && {
            confirm "Continue install package(s)?" "Package installation cancelled." || exit $?
            printf "\n"
        }

        error=0
        count=0
        total=$(printf "%s\n" "$INST" | wc -w)

        for int in $INST; do
            count=$(( count + 1 ))

            if portpathh=$(get_port_path "$int"); then
                cd "$portpathh" || return 1
                    set_term_title "[ $count/$total ] installing $int..."
                    hook "pre" "install"

                    if pkgbuild -i $OPTS; then
                        case " $IPKG " in
                            *" $int "*) world_add "$int" ;;
                        esac

                        hook "post" "install"
                        done_pkg="$done_pkg $int"
                    else
                        if keep_going; then
                            msg_warning "Install failed for '$int', continuing with next package..."

                            failed_installs="$failed_installs $int"
                            error=1
                        else
                            error=1

                            cd - >/dev/null || return 1
                            break
                        fi
                    fi
                cd - >/dev/null || return 1
            else
                msg_warning "Skipping missing package: $int"
                skipped_installs="$skipped_installs $int"
            fi

            unset portpathh
        done

        [ "$done_pkg" ] && emerald_trigger "$done_pkg"

        # Show error summary if exist
        FAILED_PKGS="$failed_installs"
        SKIPPED_PKGS="$skipped_installs"

        summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "install"
        summary_title "$error" "$done_pkg" "$count" "$total" "installed"

        return "$error"
    fi
}

emerald_installed() {
    find "$PKGDB_DIR" -maxdepth 1 -type f | while IFS= read -r _f; do
        read -r _v _r _ < "$_f"
        printf '%s %s-%s\n' "${_f##*/}" "$_v" "$_r"
    done
}

emerald_integrity() {
    require_root

    if [ "$1" ]; then
        pkg="$1"
        printf "Checking '%s' integrity...\n" "$pkg"

        [ -f "$PKGDB_DIR/$pkg" ] || {
            msg_port_not_installed "$pkg"
            return 1
        }

        found=0

        {
            read -r _ # skip header

            while IFS= read -r line; do
                [ -e "/$line" ] && continue
                found=1

                [ -L "/$line" ] && printf "broken symlink %s: /%s\n" "$pkg" "$line" || printf "file missing %s: /%s\n" "$pkg" "$line"
            done
        } < "$PKGDB_DIR/$pkg"

        [ "$found" -eq 0 ] && msg_info "'$pkg' integrity is OK!"
        return 0
    fi

    printf "Checking ports integrity...\n"
    interr=$(mktemp) || return 1

    # shellcheck disable=SC2016
    all_installed | xargs -P "$(nproc)" -I{} sh -c '
        pkg="$1"
        db="$2/$pkg"
        interr="$3"

        [ -f "$db" ] || exit 0

        {
            read -r _

            while IFS= read -r line; do
                [ -e "/$line" ] && continue

                # mark error
                printf 1 >> "$interr"

                [ -L "/$line" ] && printf "broken symlink %s: /%s\n" "$pkg" "$line" || printf "missing file %s: /%s\n" "$pkg" "$line"
		        done
        } < "$db"
    ' _ {} "$PKGDB_DIR" "$interr"

    [ ! -s "$interr" ] && msg_info "No integrity issues found!"
    rm -f "$interr"
}

emerald_is_installed() {
    [ -n "$1" ] && [ -f "$PKGDB_DIR/$1" ]
}

emerald_locate() {
    need_arg "$@"

    for repo in $PORT_REPO; do
        grep -Ri "$@" "$repo"/*/.pkgfiles 2>/dev/null | sed 's/:/ /;s/\/\.pkgfiles//' | awk '{print $1,$4}'
    done
}

emerald_missing_deps() {
    printf "Checking ports missing deps...\n"
    found=0

    while IFS= read -r pkg; do
        get_port_path "$pkg" >/dev/null || continue
        depends=$(get_depends "$pkg")

        [ -z "$depends" ] && continue
        msd=""

        for d in $depends; do
            emerald_is_installed "$d" || msd="$msd $d"
        done

        if [ -n "$msd" ]; then
            msg_info "$pkg:$msd"
            found=1
        fi
    done <<EOF
$(all_installed)
EOF

    [ "$found" -eq 0 ] && msg_info "No ports missing deps found!"
    return 0
}

emerald_orphan() {
    if [ -f "$WORLD_FILE" ]; then
        while IFS= read -r i; do
            case " $* " in
                *" $i "*) continue ;;
            esac

            case " $DEP " in
                *" $i "*) continue ;;
            esac

            deplist "$i"
        done < "$WORLD_FILE"
    fi

    all_installed | awk -v dep=" $DEP " '{if (index(dep, " " $0 " ") == 0) print}'
}

version_compare() {
    [ "$1" = "$2" ] && return 0

    # - If sorted (exit code 0): $1 <= $2, but we know $1 != $2, so $1 < $2 → return 1
    # - If not sorted (exit code 1): $1 > $2 → return 2
    printf '%s\n%s\n' "$1" "$2" | sort -VC && return 1 || return 2
}

check_outdated() {
    _MASKED_LIST=$(awk '!/^[[:space:]]*$/ && !/^#/ {printf "%s ", $0}' "$MASK_FILE" 2>/dev/null)

    for pkg in $(all_installed); do
        # Check NEW_INSTALLED
        NEW_INSTALLED=0

        pvr=$(get_version "$pkg") || continue
        ivr=$(get_iversion "$pkg") || continue

        [ "$pvr" = "$ivr" ] && continue

        pversion=${pvr%-*}
        prelease=${pvr#*-}

        iversion=${ivr%-*}
        irelease=${ivr#*-}

        if [ "$pversion" != "$iversion" ]; then
            version_compare "$pversion" "$iversion"
            [ $? -eq 1 ] && NEW_INSTALLED=1
        elif [ "$prelease" != "$irelease" ]; then
            version_compare "$prelease" "$irelease"
            [ $? -eq 1 ] && NEW_INSTALLED=1
        fi

        # Check MASKED
        MASKED=0

        case " $_MASKED_LIST " in
            *" $pkg "*) MASKED=1 ;;
        esac

        # Example 'glib#2.87.0-1#2.88.1-1#1#0'
        printf "%s#%s#%s#%s#%s\n" "$pkg" "$ivr" "$pvr" "$NEW_INSTALLED" "$MASKED"
    done
}

emerald_outdated() {
    out=$(check_outdated)

    [ -z "$out" ] && {
        msg_info "All packages are up to date."
        return 0
    }

    printf '%s\n' "$out" | while IFS='#' read -r pname oldver newver newins masked; do
        unset ii

        [ "$newins" -eq 1 ] && ii=" [newer installed]"
        [ "$masked" -eq 1 ] && ii="$ii [masked]"

        printf "%s %s => %s%s\n" "$pname" "$oldver" "$newver" "$ii"
    done
}

emerald_path() {
    need_arg "$@"

    PPATH=$(get_port_path "$1") || {
        msg_port_not_found "$1"
        return 1
    }

    printf "%s\n" "$PPATH"
}

emerald_provide() {
    need_arg "$@"
    grep -RF "$1" "$PKGDB_DIR" | sed "s:$PKGDB_DIR/::" | tr : "\t"
}

emerald_purge() {
    require_root "Purging package"

    while [ "$1" ]; do
        case $1 in
            -*) PURGEOPTS="$PURGEOPTS $1" ;;
            *) PURGENAME="$PURGENAME $1" ;;
        esac

        shift
    done

    if [ "$PURGENAME" ]; then
        for i in $PURGENAME; do
            emerald_is_installed "$i" || {
                msg_port_not_installed "$i"
                needexit=1
            }
        done
    fi

    [ "$needexit" ] && exit 1
    printf "Resolving dependencies...\n"

    orphan=$(emerald_orphan "$PURGENAME")

    if [ "$PURGENAME" ]; then
        for purge in $PURGENAME; do
            unset DEP pkg
            deplist "$purge"

            for ii in $DEP; do
                case " $orphan " in
                    *" $ii "*) pkg="$pkg $ii" ;;
                esac
            done

            [ -z "$pkg" ] && printf "Cant purge '%s', it required by other package(s)...\n" "$purge"
            [ "$remove" ] && remove="$remove $pkg" || remove="$pkg"
        done
    else
        remove=$orphan
    fi

    [ -z "$remove" ] && {
        printf "No orphan packages found...\n"
        return 0
    }

    emerald_remove $remove $PURGEOPTS
}

emerald_redeps() {
    need_arg "$@"

    if [ "$1" ]; then
        while [ "$1" ]; do
            case $1 in
                --fix | -f) fix="yes" ;;
                --help | -h) emerald_help ;;
                *) pkg="$pkg $1" ;;
            esac

            shift
        done
    fi

    ppath=$(get_port_path $pkg) || {
        msg_port_not_found $pkg
        return 1
    }

    for i in $pkg; do
        deps_i=$(get_depends "$i")
        [ "$deps_i" ] || continue

        for d in $deps_i; do
            for dd in $deps_i; do
                [ "$dd" = "$d" ] && continue

                [ "$(emerald deplist "$d" | awk '{print $2}' | grep -x "$dd")" ] && {
                    printf "[%s] %s (already pulled from %s)\n" "$i" "$dd" "$d"

                    [ "$fix" = "yes" ] && {
                        deps_file="$ppath/depends"
                        [ -f "$CBUILD_DIR/$i.dep" ] && deps_file="$CBUILD_DIR/$i.dep"

                        sed -i "/^$dd$/d" "$deps_file"
                        msg_info " $dd removed from $i $(basename "$deps_file")"
                    }
                }
            done
        done
    done
}

emerald_remove() {
    require_root "Removing package"

    while [ "$1" ]; do
        case $1 in
            -y | --yes) NOCONFIRM=1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    [ -z "$PKGNAME" ] && {
        printf "Please specify package(s) to remove.\n"
        return 1
    }

    for i in $PKGNAME; do
        if ! emerald_is_installed "$i"; then
            msg_port_not_installed "$i"
            continue
        fi

        IPKG="$IPKG $i"
    done

    [ "$IPKG" ] || return 0
    printf "Removing packages...\n\n"

    pkgcount=0
    count=0
    installmsg="ACTION#PORTNAME#VERSION"

    for pkg in $IPKG; do
        pkgcount=$(( pkgcount + 1 ))
        installmsg="$installmsg remove#$pkg#$(get_iversion "$pkg")"
    done

    printf "%s\n" "$installmsg" | tr ' ' '\n' | tr '#' ' ' | column -t
    printf "\n"
    printf "( %s remove )\n" "$pkgcount"
    printf "\n"

    [ "$NOCONFIRM" != 1 ] && {
        confirm "Continue remove package(s)?" "Package removing cancelled." || exit $?
        printf "\n"
    }

    for pkg in $IPKG; do
        count=$(( count + 1 ))
        set_term_title "[ $count/$pkgcount ] Removing $pkg..."

        hook "pre" "remove" "$pkg"
        printf "remove: %s %s...\n" "$pkg" "$(get_iversion "$pkg")"

        pkgdel "$pkg" $OPTS || {
            error=1
            break
        }

        world_del "$pkg"
        hook "post" "remove" "$pkg"
    done

    set_term_title "$pkgcount package(s) removed."
}

emerald_search() {
    need_arg "$@"

    NAME_ONLY=0
    PATTERN=""

    while [ "$1" ]; do
        case $1 in
            -n | --name) NAME_ONLY=1 ;;

            -*)
                msg_error "Invalid search option: $1";
                return 1
            ;;

            *) PATTERN="$1" ;;
        esac

        shift
    done

    [ -z "$PATTERN" ] && {
        printf "Please specify a search pattern.\n"
        return 1
    }

    _sr_found=0

    for repo in $PORT_REPO; do
        [ -d "$repo" ] || continue

        _sr_out=$(awk -v pat="$PATTERN" -v nonly="$NAME_ONLY" 'FNR == 1 {
            if ((NR > 1) && matched) printf "%s|%s|%s|%s\n", name, ver, rel, desc;
            name = ver = rel = desc = "";
            matched = 0;
        } /^name=/ {
            sub(/^name=/, "");
            gsub(/"/, "");

            name = $0;
            if (name ~ pat) matched = 1;
        } /^version=/ {
            sub(/^version=/, "");
            gsub(/"/, "");

            ver = $0;
        } /^release=/ {
            sub(/^release=/, "");
            gsub(/"/, "");

            rel = $0;
        } /^description=/ {
            sub(/^description=/, "");
            gsub(/"/, "");

            desc = $0;
            if (!nonly && desc ~ pat) matched = 1;
        } END {
            if (matched) printf "%s|%s|%s|%s\n", name, ver, rel, desc;
        }' "$repo"/*/"$BUILD_SCRIPT" 2>/dev/null | sort)

        [ -n "$_sr_out" ] || continue
        _sr_found=1

        printf '%s\n' "$_sr_out" | while IFS='|' read -r name version release desc; do
            emerald_is_installed "$name" && ins=$(printf "[%bi%b]" "$COLOR2" "$CRESET") || ins="[ ]"
            printf "%b %b(%s)%b %b%s%b %b%s-%s%b %s\n" "$ins" "$COLOR5" "${repo##*/}" "$CRESET" "$COLOR2" "$name" "$CRESET" "$COLOR4" "$version" "$release" "$CRESET" "$desc"
        done
    done

    [ "$_sr_found" -eq 0 ] && msg_info "No matching package found."
    return 0
}

emerald_sync() {
    portsync "$@"
}

emerald_sysup() {
    require_root "Upgrading package"
    failed_upgrades=""

    while [ "$1" ]; do
        case $1 in
            -i | -u | -r ) ;;

            -o)
                DOWNLOAD_ONLY=1
                OPTS="$OPTS $1"
            ;;

            -y | --yes) NOCONFIRM=1 ;;
            -n) NO_DEP=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            --exclude=*) EXOPT=$1 ;;
            -*) OPTS="$OPTS $1" ;;
        esac

        shift
    done

    printf "Checking for outdated packages...\n"
    PKGOUTDATE=$(check_outdated)

    # filter out masked (format: name#ivr#pvr#newer_installed#masked)
    for i in $PKGOUTDATE; do
        case $i in
            *#1) continue ;; # masked: skip, example: 'glib#2.87.0-1#2.88.1-1#1#1'
            *) ii="$ii ${i%%#*}" ;;
        esac
    done

    EXPKG=${EXOPT#*=}

    for i in $ii; do
        # Wrap list and item with commas so first/last entries are always surrounded by delimiters.
        case ",$EXPKG," in
            *",$i,"*) ;;
            *) PKG="$PKG $i" ;;
        esac
    done

    [ -z "$PKG" ] && {
        printf "All packages are up to date.\n"
        return 0
    }

    case " $PKG " in
        *" emerald "*)
            printf "\n"
            msg_warning "Please upgrade 'emerald' first."

            msg_info "Run 'emerald upgrade emerald' as root."
            return 1
        ;;
    esac

    UPGPKG=0
    NEWPKG=0
    installmsg="ACTION#PORTNAME#VERSION#INSTALLED"

    if [ "$NO_DEP" != 1 ]; then
        printf "Resolving dependencies...\n"
        DEP=$(emerald_deplist "$PKG" "$EXOPT" | awk '{print $2}')

        printf "\n"

        for d in $DEP; do
            case " $PKG " in
                *" $d "*)
                    installmsg="$installmsg upgrade#$d#$(get_version "$d")#$(get_iversion "$d")"

                    WILLINSTALL="$WILLINSTALL $d"
                    UPGPKG=$(( UPGPKG + 1 ))
                ;;

                *)
                    if ! emerald_is_installed "$d" && get_port_path "$d" >/dev/null 2>&1; then
                        installmsg="$installmsg install#$d#$(get_version "$d")#$(get_iversion "$d")"

                        WILLINSTALL="$WILLINSTALL $d"
                        NEWPKG=$(( NEWPKG + 1 ))
                    fi
                ;;
            esac
        done
    else
        printf "\n"

        for dd in $PKG; do
            printf "[%bu%b] %s  " "$COLOR2" "$CRESET" "$dd"

            WILLINSTALL="$WILLINSTALL $dd"
            UPGPKG=$(( UPGPKG + 1 ))
        done
    fi

    printf "%s\n" "$installmsg" | tr ' ' '\n' | tr '#' ' ' | column -t
    printf "\n"
    printf "( %s upgrade, %s new install )\n" "$UPGPKG" "$NEWPKG"
    printf "\n"

    [ "$NOCONFIRM" != 1 ] && {
        confirm "Continue upgrade/install these package(s)?" "Package upgrade cancelled." || exit $?
        printf "\n"
    }

    error=0
    count=0
    total=$(printf "%s\n" "$WILLINSTALL" | wc -w)

    for inst in $WILLINSTALL; do # install all required dependencies and target packages itself
        count=$(( count + 1 ))

        cd "$(get_port_path "$inst")" || return 1
            if ! emerald_is_installed "$inst"; then
                set_term_title "[ $count/$total ] Installing $inst..."
                hook "pre" "install"

                if pkgbuild -i $OPTS; then
                    hook "post" "install"
                    done_pkg="$done_pkg $inst"
                else
                    if keep_going; then
                        msg_warning "Install failed for '$inst', continuing with next package..."

                        failed_upgrades="$failed_upgrades $inst"
                        error=1
                    else
                        error=1

                        cd - >/dev/null || return 1
                        break
                    fi
                fi
            else
                set_term_title "[ $count/$total ] Upgrading $inst..."
                hook "pre" "install"

                if pkgbuild -u $OPTS; then
                    hook "post" "install"
                    done_pkg="$done_pkg $inst"
                else
                    if keep_going; then
                        msg_warning "Upgrade failed for '$inst', continuing with next package..."

                        failed_upgrades="$failed_upgrades $inst"
                        error=1
                    else
                        error=1

                        cd - >/dev/null || return 1
                        break
                    fi
                fi
            fi
        cd - >/dev/null || return 1
    done

    [ "$done_pkg" ] && emerald_trigger "$done_pkg"

    # Show error summary if exist
    FAILED_PKGS="$failed_upgrades"
    SKIPPED_PKGS=""

    summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "upgrade"
    summary_title "$error" "$done_pkg" "$count" "$total" "upgraded"

    return "$error"
}

trigger_fc_cache() {
    command -v fc-cache >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/share/fonts/" && {
        msg_info "Updating fontconfig cache..."
        fc-cache -sf
    }
}

trigger_gdk_pixbuf_cache() {
    command -v gdk-pixbuf-query-loaders >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gdk-pixbuf-2.0/2.10.0/loaders/" && {
        msg_info "Probing GDK-Pixbuf loader modules..."
        gdk-pixbuf-query-loaders --update-cache
    }
}

trigger_gio_modules() {
    command -v gio-querymodules >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gio/modules/" && {
        msg_info "Updating GIO module cache..."
        gio-querymodules /usr/lib/gio/modules
    }
}

trigger_glib_schema() {
    command -v glib-compile-schemas >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/share/glib-2.0/schemas/" && {
        msg_info "Compiling GSettings XML schema files..."
        glib-compile-schemas /usr/share/glib-2.0/schemas
    }
}

trigger_gtk2_immodules() {
    command -v gtk-query-immodules-2.0 >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gtk-2.0/2.10.0/immodules/" && {
        msg_info "Probing GTK2 input method modules..."
        gtk-query-immodules-2.0 --update-cache
    }
}

trigger_gtk3_immodules() {
    command -v gtk-query-immodules-3.0 >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gtk-3.0/3.0.0/immodules/" && {
        msg_info "Probing GTK3 input method modules..."
        gtk-query-immodules-3.0 --update-cache
    }
}

trigger_icon_cache() {
    command -v gtk-update-icon-cache >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/share/icons/" && {
        msg_info "Updating icon theme caches..."

        for dir in /usr/share/icons/*; do
            [ -d "$dir" ] || continue # skip non-directory entries in /usr/share/icons

            if [ -e "$dir/index.theme" ]; then
                gtk-update-icon-cache -q "$dir" 2>/dev/null
                continue
            fi

            rm -f "$dir/icon-theme.cache"
            rmdir "$dir" 2>/dev/null
        done
    }
}

trigger_udevdb() {
    command -v udevadm >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^etc/udev/hwdb.d/" && {
        msg_info "Updating hardware database..."
        udevadm hwdb --update
    }
}

trigger_fontcache() {
    command -v mkfontdir >/dev/null || return 0
    command -v mkfontscale >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/share/fonts/" && {
        msg_info "Updating X fontdir indices..."

        for dir in $(find /usr/share/fonts -maxdepth 1 -type d \( ! -path /usr/share/fonts \)); do
            rm -f "$dir/fonts.scale" "$dir/fonts.dir" "$dir/.uuid"
            rmdir "$dir" 2>/dev/null

            [ -d "$dir" ] || continue

            mkfontdir "$dir"
            mkfontscale "$dir"
        done
    }
}

trigger_desktop_database() {
    command -v update-desktop-database >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/share/applications/" && {
        msg_info "Updating desktop file MIME type cache..."
        update-desktop-database --quiet
    }
}

trigger_mime_database() {
    command -v update-mime-database >/dev/null || return 0

    printf '%s\n' "$PKGFILES" | grep -q "^usr/share/mime/" && {
        msg_info "Updating the MIME type database..."
        update-mime-database /usr/share/mime
    }
}

emerald_trigger() {
    require_root "Run trigger"

    if [ "$DOWNLOAD_ONLY" != 1 ]; then
        [ "$#" -gt 0 ] || set -- $(all_installed)

        # Read all DB files once in memory
        # shellcheck disable=SC2068
        PKGFILES=$(for _p in $@; do
            cat "$PKGDB_DIR/$_p" 2>/dev/null
        done)

        for t in mime_database desktop_database fontcache fc_cache udevdb icon_cache gtk3_immodules gtk2_immodules glib_schema gio_modules gdk_pixbuf_cache; do
            trigger_$t
        done
    fi
}

emerald_upgrade() {
    require_root "Upgrading package"
    failed_upgrades=""

    while [ "$1" ]; do
        case $1 in
            -i | -r) ;;
            -y | --yes) NOCONFIRM=1 ;;

            -o)
                DOWNLOAD_ONLY=1;
                OPTS="$OPTS $1"
            ;;

            -n) NO_DEP=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            --exclude=*) EXOPT=$1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    [ -z "$PKGNAME" ] && {
        printf "Please specify package(s) to upgrade.\n"
        return 1
    }

    for pkg in $PKGNAME; do
        if ! emerald_is_installed "$pkg"; then
            msg_port_not_installed "$pkg"

            if keep_going; then
                failed_upgrades="$failed_upgrades $pkg"
                continue
            else
                continue
            fi
        elif ! get_port_path "$pkg" >/dev/null 2>&1; then
            printf "Package '%s' not exist.\n" "$pkg"

            if keep_going; then
                failed_upgrades="$failed_upgrades $pkg"
                continue
            else
                continue
            fi
        else
            if [ "$(get_iversion "$pkg")" = "$(get_version "$pkg")" ]; then
                printf "Package '%s' is up to date.\n" "$pkg"
                continue
            fi
        fi

        upkg="$upkg $pkg"
    done

    [ "$upkg" ] || return 0

    UPGPKG=0
    NEWPKG=0
    installmsg="ACTION#PORTNAME#VERSION#INSTALLED"

    if [ "$NO_DEP" != 1 ]; then
        printf "Resolving dependencies...\n"
        DEP=$(emerald_deplist "$upkg" "$EXOPT" | awk '{print $2}')
        printf "\n"

        for d in $DEP; do
            case " $upkg " in
                *" $d "*)
                    installmsg="$installmsg upgrade#$d#$(get_version "$d")#$(get_iversion "$d")"

                    WILLINSTALL="$WILLINSTALL $d"
                    UPGPKG=$(( UPGPKG + 1 ))
                ;;

                *)
                    if ! emerald_is_installed "$d" && get_port_path "$d" >/dev/null 2>&1; then
                        installmsg="$installmsg install#$d#$(get_version "$d")#$(get_iversion "$d")"

                        WILLINSTALL="$WILLINSTALL $d"
                        NEWPKG=$(( NEWPKG + 1 ))
                    fi
                ;;
            esac
        done
    else
        printf "\n"

        for dd in $upkg; do
            installmsg="$installmsg upgrade#$dd#$(get_version "$dd")#$(get_iversion "$dd")"

            WILLINSTALL="$WILLINSTALL $dd"
            UPGPKG=$(( UPGPKG + 1 ))
        done
    fi

    printf "%s\n" "$installmsg" | tr ' ' '\n' | tr '#' ' ' | column -t
    printf "\n"
    printf "( %s upgrade, %s new install )\n" "$UPGPKG" "$NEWPKG"
    printf "\n"

    [ "$NOCONFIRM" != 1 ] && {
        confirm "Continue upgrade/install these package(s)?" "Package upgrade cancelled." || exit $?
        printf "\n"
    }

    error=0
    count=0
    total=$(printf "%s\n" "$WILLINSTALL" | wc -w)

    for inst in $WILLINSTALL; do # install all required dependencies and target packages itself
        count=$(( count + 1 ))

        cd "$(get_port_path "$inst")" || return 1
            if ! emerald_is_installed "$inst"; then
                set_term_title "[ $count/$total ] Installing $inst..."
                hook "pre" "install"

                if pkgbuild -i $OPTS; then
                    hook "post" "install"
                    done_pkg="$done_pkg $inst"
                else
                    if keep_going; then
                        msg_warning "Install failed for '$inst', continuing with next package..."

                        failed_upgrades="$failed_upgrades $inst"
                        error=1
                    else
                        error=1

                        cd - >/dev/null || return 1
                        break
                    fi
                fi
            else
                set_term_title "[ $count/$total ] Upgrading $inst..."
                hook "pre" "install"

                if pkgbuild -u $OPTS; then
                    hook "post" "install"
                    done_pkg="$done_pkg $inst"
                else
                    if keep_going; then
                        msg_warning "Upgrade failed for '$inst', continuing with next package..."

                        failed_upgrades="$failed_upgrades $inst"
                        error=1
                    else
                        error=1

                        cd - >/dev/null || return 1
                        break
                    fi
                fi
            fi
        cd - >/dev/null || return 1
    done

    [ "$done_pkg" ] && emerald_trigger "$done_pkg"

    # Show error summary if exist
    FAILED_PKGS="$failed_upgrades"
    SKIPPED_PKGS=""

    summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "upgrade"
    summary_title "$error" "$done_pkg" "$count" "$total" "upgraded"

    return "$error"
}

world_add() {
    grep -qx "$1" "$WORLD_FILE" && return

    emerald_is_installed "$1" || {
        msg_port_not_installed "$1"
        return 1
    }

    printf "%s\n" "$1" >> "$WORLD_FILE"

    sort "$WORLD_FILE" -o "$WORLD_FILE" # sort world
    sed '/^$/d' -i "$WORLD_FILE" # delete empty lines
}

world_del() {
    grep -qx "$1" "$WORLD_FILE" || return
    sed "/^$1$/d;/^$/d" -i "$WORLD_FILE"
}

emerald_world() {
    if [ -z "$1" ]; then
        [ -s "$WORLD_FILE" ] && cat "$WORLD_FILE" || printf "world is empty\n"
        return 0
    fi

    require_root
    touch "$WORLD_FILE"

    while [ "$1" ]; do
        if ! grep -qx "$1" "$WORLD_FILE"; then
            if world_add "$1"; then
                printf "world: '%s' added to world\n" "$1"
            fi

            shift
            continue
        fi

        printf "world: '%s' deleted from world\n" "$1"
        world_del "$1"

        shift
    done
}

# check for 'pkgadd', required for package database path
command -v pkgadd >/dev/null 2>&1 || {
    printf "'pkgadd' not found in \$PATH!\n"
    exit 1
}

mode=$1

if [ -z "$mode" ]; then
    printf "Run '%s help' to see available options.\n" "${0##*/}"
    exit 2
fi

func="$(printf '%s' "$mode" | tr '-' '_')"

if ! command -v "emerald_$func" >/dev/null 2>&1; then
    printf "%s: unknown subcommand '%s'. See '%s help'.\n" "${0##*/}" "$mode" "${0##*/}"
    exit 2
fi

shift

for opt in "$@"; do
    case $opt in
        --append-repo=*) APPENDREPO="$APPENDREPO ${opt#*=}" ;;
        --prepend-repo=*) PREPENDREPO="$PREPENDREPO ${opt#*=}" ;;
        --override-repo=*) OVERRIDEREPO="$OVERRIDEREPO ${opt#*=}" ;;
        --repo=*) PORT_REPO="$PORT_REPO ${opt#*=}" ;;
        --repo-file=*) REPO_FILE="${opt#*=}" ;;
        --alias-file=*) ALIAS_FILE="${opt#*=}" ;;
        --config-file=*) CONFIG_FILE="${opt#*=}" ;;
        --*) MAINOPTS="$MAINOPTS $opt" ;;

        -[!-]?*)
            _rest=${opt#-}

            while [ -n "$_rest" ]; do
                _chr="${_rest%"${_rest#?}"}"
                MAINOPTS="$MAINOPTS -$_chr"
                _rest=${_rest#?}
            done
        ;;

        *) MAINOPTS="$MAINOPTS $opt" ;;
    esac

    shift
done

if [ -f "$REPO_FILE" ]; then
    for repodir in $(awk '!/^[[:space:]]*$/ && !/^#/ {print $1}' "$REPO_FILE"); do
        PORT_REPO="$PORT_REPO $repodir"
    done
fi

[ "$OVERRIDEREPO" ] && PORT_REPO="$OVERRIDEREPO" || PORT_REPO="$PREPENDREPO $PORT_REPO $APPENDREPO"

for f in $REPO_FILE $ALIAS_FILE $MASK_FILE $CONFIG_FILE; do
    if [ ! -f "$f" ]; then
        msg_error "file not found: $f"
        exit 3
    fi
done

"emerald_$func" $MAINOPTS
exit $?
