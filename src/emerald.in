#!/bin/sh

# shellcheck disable=SC2317

# vars
BUILD_SCRIPT="@BUILD_SCRIPT@"
PKGDB_DIR="$(pkgadd --print-db-dir)"
CBUILD_DIR="@STATE_DIR@/cbuild"
WORLD_FILE="@STATE_DIR@/world"
REPO_FILE="${REPO_FILE:-@SYSCONFDIR@/emerald.repo}"
MASK_FILE="${MASK_FILE:-@SYSCONFDIR@/emerald.mask}"
CONFIG_FILE="${CONFIG_FILE:-@SYSCONFDIR@/emerald.conf}"
ALIAS_FILE="${ALIAS_FILE:-@SYSCONFDIR@/emerald.alias}"

# default value from pkgbuild
SOURCE_DIR="@CACHE_DIR@/sources"
PACKAGE_DIR="@CACHE_DIR@/packages"
CURL_OPTS=""
COMPRESSION_MODE="xz"
NO_STRIP="no"
IGNORE_CHECKSUM="no"
KEEP_DOC="no"
KEEP_GOING="no"
KEEP_LIBTOOL="no"
KEEP_LOCALE="yes"
KEEP_MAN="yes"
KEEP_INFO="yes"
KEEP_HELP="no"
NOCOLOR="no"
THEME="vylen"

# color themes
colors_dracula() {
    COLOR1='\033[38;5;203m' # pink
    COLOR2='\033[38;5;84m'  # cyan-green
    COLOR3='\033[38;5;228m' # yellow
    COLOR4='\033[38;5;117m' # light blue
    COLOR5='\033[38;5;141m' # purple
    CRESET='\033[0m'        # reset
}

colors_nord() {
    COLOR1='\033[38;5;174m' # soft red
    COLOR2='\033[38;5;108m' # desaturated green
    COLOR3='\033[38;5;179m' # warm yellow
    COLOR4='\033[38;5;109m' # nord blue
    COLOR5='\033[38;5;139m' # nord purple
    CRESET='\033[0m'        # reset
}

colors_vylen() {
    COLOR1='\033[38;5;1m' # red
    COLOR2='\033[38;5;2m' # green
    COLOR3='\033[38;5;3m' # yellow
    COLOR4='\033[38;5;4m' # blue
    COLOR5='\033[36m'     # cyan
    CRESET='\033[0m'      # reset
}

load_colors() {
    # reset all vars
    COLOR1=
    COLOR2=
    COLOR3=
    COLOR4=
    COLOR5=
    CRESET=

    [ "$NOCOLOR" = "yes" ] && return 0

    case "$THEME" in
        dracula) colors_dracula ;;
        nord) colors_nord ;;
        *) colors_vylen ;;
    esac
}

msg_info() {
    printf "%b==>%b %s\n" "$COLOR2" "$CRESET" "$1"
}

msg_error() {
    printf "%bERROR:%b %s\n" "$COLOR1" "$CRESET" "$1" >&2
}

msg_warning() {
    printf "%bWARNING:%b %s\n" "$COLOR3" "$CRESET" "$1" >&2
}

msg_port_not_found() {
    printf "Port '%s' not found.\n" "$1"
}

msg_port_not_installed() {
    printf "Port '%s' not installed.\n" "$1"
}

msg_port_already_installed() {
    printf "Port '%s' already installed.\n" "$1"
}

msg_deps_status() {
    for i in "$@"; do
        if emerald_is_installed "$i"; then
            printf "[%bi%b] %s\n" "$COLOR2" "$CRESET" "$i"
            continue
        fi

        if get_port_path "$i" >/dev/null; then
            printf "[-] %s\n" "$i"
            continue
        fi

        printf "[%bm%b] %s\n" "$COLOR3" "$CRESET" "$i"
    done

    unset i
}

get_port_path() {
    for repo in $PORT_REPO; do
        if [ -f "$repo/$1/$BUILD_SCRIPT" ]; then
            printf '%s/%s\n' "$repo" "$1"
            return 0
        fi
    done

    return 1
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        msg_error "this operation requires root privileges!"
        exit 1
    fi
}

get_iversion() {
    [ -f "$PKGDB_DIR/$1" ] || return 1

    read -r _iv _ir _ < "$PKGDB_DIR/$1"
    printf '%s-%s\n' "$_iv" "$_ir"
}

get_version() {
    PPATH=$(get_port_path "$1") || return 1

    awk '/^version=/ {
        v = $0;

        sub(/^version=/, "", v);
        gsub(/["'\'']/, "", v);
    } /^release=/ {
        r = $0;

        sub(/^release=/, "", r);
        gsub(/["'\'']/, "", r)
    } END {
        if (v == "") v = 0;
        if (r == "") r = 0;

        printf "%s-%s\n", v, r;
    }' "$PPATH/$BUILD_SCRIPT"
}

all_installed() {
    find "$PKGDB_DIR" -maxdepth 1 -type f -printf '%f\n'
}

deps_alias() {
    printf '%s\n' $deps | awk -v alias_file="$ALIAS_FILE" 'BEGIN {
        while ((getline line < alias_file) > 0) {
            if (line ~ /^[[:space:]]*$/ || line ~ /^#/) continue;

            split(line, a);
            alias[a[1]] = a[2];
        }

        close(alias_file);
    } {
        print ($0 in alias) ? alias[$0] : $0;
    }'
}

get_depends() {
    PPATH=$(get_port_path "$1") || return 0
    deps_file="$PPATH/depends"

    [ -f "$CBUILD_DIR/${1}.dep" ] && deps_file="$CBUILD_DIR/$1.dep"
    [ -f "$deps_file" ] || return 0

    deps=$(grep -v '^$' "$deps_file")
    [ "$ALIAS_PORT" = "yes" ] && deps_alias "$deps" || printf "%s" "$deps"
}

get_conflicts() {
    PPATH=$(get_port_path "$1") || return 0

    conflicts_file="$PPATH/conflicts"
    [ -f "$conflicts_file" ] || return 0

    awk '/^[[:space:]]*#/ || /^[[:space:]]*$/ {
        next;
    } {
        sub(/[[:space:]]*#.*/, "");
        for (i = 1; i <= NF; i++) print $i;
    }' "$conflicts_file"
}

check_conflicts() {
    _conflict_pkg="$1"

    for _conflict in $(get_conflicts "$_conflict_pkg"); do
        if emerald_is_installed "$_conflict"; then
            msg_error "Port '$_conflict_pkg' conflicts with installed port '$_conflict'."
            exit 1
        fi
    done
}

confirm() {
    printf "%s (Y/n) " "$1"
    read -r response

    case "$response" in
        [Nn][Oo] | [Nn])
            printf "%s\n" "$2"
            return 2
        ;;
    esac

    return 0
}

need_arg() {
    if [ -z "$1" ]; then
        printf "This operation required an arguments!\n"
        exit 1
    fi
}

keep_going() {
    [ "$KEEP_GOING" = "yes" ] || [ "$KEEP_GOING_LOCAL" = 1 ]
}

set_term_title() {
    printf "\033]0;%s\a" "$1"
}

summary_show() {
    failed="$1"  # $1 -> list of failed packages
    skipped="$2" # $2 -> list of skipped packages (may be empty)
    action="$3"  # $3 -> action: install, upgrade, build, ...

    # If there is nothing to report, return silently
    [ -n "$failed" ] || [ -n "$skipped" ] || return 0

    # Separate summary from previous output
    printf '\n'

    # Report failed packages
    if [ -n "$failed" ]; then
        msg_error "The following packages failed to $action:"

        for p in $failed; do
            printf "  - %s\n" "$p"
        done
    fi

    # Report skipped packages (if any)
    if [ -n "$skipped" ]; then
        msg_warning "The following packages were skipped:"

        for p in $skipped; do
            printf "  - %s\n" "$p"
        done
    fi
}

summary_title() {
    error="$1"    # $1 -> error flag (0 if success, non-zero if errors occurred)
    done_pkg="$2" # $2 -> list of successfully processed packages
    count="$3"    # $3 -> normal counter (used when no errors occurred)
    total="$4"    # $4 -> total number of packages
    action="$5"   # $5 -> action: installed, upgraded, built, ...

    if [ "$error" -eq 0 ]; then
        # Fast path: no errors, use the normal counter
        set_term_title "$count/$total package(s) $action."
        return 0
    fi

    # When errors occurred, recalculate the number of successfully processed packages
    successful_count="$(printf "%s\n" "$done_pkg" | wc -w)"
    set_term_title "$successful_count/$total package(s) $action."
}

emerald_build() {
    need_arg "${@}"
    failed_builds=""

    while [ -n "$1" ]; do
        case $1 in
            -i | -u | -r | -g | -p) ;;
            --log) LOG=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    for pkg in $PKGNAME; do
        PPATH=$(get_port_path "$pkg") || {
            msg_port_not_found "$pkg"

            # If keep going is enabled, log and continue
            if keep_going; then
                failed_builds="$failed_builds $pkg"
                continue
            fi

            return 1
        }

        cd "$PPATH" || return 1
            set_term_title "Building $pkg..."

            # Run pkgbuild and capture the result
            case "$LOG" in
                1) pkgbuild $OPTS | tee "/var/log/$pkg-$(get_version "$pkg")-build-$(date +%Y%m%d-%H%M).log" ;;
                *) pkgbuild $OPTS ;;
            esac

            _build_ret="$?"

            if [ "$_build_ret" -ne 0 ]; then
                set_term_title "Building $pkg failed."

                if keep_going; then
                    msg_warning "Build failed for '$pkg', continuing with next package..."
                    failed_builds="$failed_builds $pkg"

                    cd - >/dev/null || return 1
                    continue
                fi

                return 1
            fi

            set_term_title "Building $pkg done."
        cd - >/dev/null || return 1
    done

    # Show error summary if exist
    FAILED_PKGS="$failed_builds"
    SKIPPED_PKGS=""

    summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "build"
    [ -n "$FAILED_PKGS" ] && return 1

    return 0
}

human_size() {
    # Converts bytes to a human-readable size with one decimal
    b="$1"

    awk -v b="$b" 'BEGIN {
        suf="B K M G T P";
        split(suf, u);

        i = 1;
        val = b;

        while ((val >= 1024) && (i < 6)) {
            val /= 1024;
            i++;
        }

        printf "%.1f%s", val, u[i];
    }'
}

diff_lists() {
    awk -v all="$1" -v keep="$2" 'BEGIN {
        n = split(keep, k, "|");
        for (i = 1; i <= n; i++) keep_set[k[i]] = 1;

        m = split(all, a, "|");
        out = "";

        for (i = 1; i <= m; i++) {
            if (!(a[i] in keep_set)) out = out (out ? "|" : "") a[i];
        }

        printf "%s", out;
    }'
}

show_list() {
    # Show files and sizes
    list="$1"
    dir="$2"

    [ -z "$list" ] && return 0

    # Print list, one file per line
    oldIFS=$IFS
    IFS='|'

    set -- $list
    IFS=$oldIFS

    for f; do
        printf '%s\n' "$f"
    done

    # Calculate total size
    total=0

    for f; do
        [ -f "$dir/$f" ] || continue

        sz=$(wc -c <"$dir/$f" 2>/dev/null || printf "0\n")
        total=$((total + sz))
    done

    printf "Total size %s: %s\n\n" "${dir##*/}" "$(human_size "$total")"
}

emerald_cache() {
    require_root "Clear old caches"

    clean_pkg=1
    clean_src=1

    case "${1:-}" in
        "") : ;;  # default: clean both

        -p | --pkg) clean_src=0 ;;
        -s | --src) clean_pkg=0 ;;

        -h | --help)
            cat <<'EOF'
Usage:
    @PROJECT_NAME@ cache <arg>

Options:
    (no args)  clean packages AND sources cache
    -p, --pkg  clean packages cache only
    -s, --src  clean sources cache only
EOF
            return 0
        ;;

        *)
            msg_error "Invalid argument: $1"
            return 1
        ;;
    esac

    # Internal lists (compact with | separator)
    all_pkg=""
    all_src=""
    keep_pkg=""
    keep_src=""

    # Scan package cache
    if [ "$clean_pkg" -eq 1 ]; then
        # shellcheck disable=SC2044
        for f in $(find "$PACKAGE_DIR" -type f 2>/dev/null); do
            file=${f##*/}
            all_pkg="${all_pkg}${all_pkg:+|}$file"
        done
    fi

    # Scan source cache
    if [ "$clean_src" -eq 1 ]; then
        # shellcheck disable=SC2044
        for f in $(find "$SOURCE_DIR" -type f 2>/dev/null); do
            file=${f##*/}
            all_src="${all_src}${all_src:+|}$file"
        done
    fi

    # Scan PKGDB to determine what to keep
    for portname in $(all_installed); do
        PPATH=$(get_port_path "$portname") || {
            msg_error "$portname archived, remove it."
            continue
        }

        # Keep packages - use get_iversion function
        if [ "$clean_pkg" -eq 1 ]; then
            pvr=$(get_iversion "$portname")
            [ -z "$pvr" ] || pkgname="${portname}-${pvr}.epkg.tar.${COMPRESSION_MODE}"

            keep_pkg="${keep_pkg}${keep_pkg:+|}$pkgname"
        fi

        # Keep sources - read from @CHECKSUMS_FILE@ file
        if [ "$clean_src" -eq 1 ]; then
            checksums_file="$PPATH/@CHECKSUMS_FILE@"

            if [ -f "$checksums_file" ]; then
                # Read checksum and filename directly (space-separated)
                while read -r _ filename; do
                    # Skip empty lines and ensure filename exists
                    [ -n "$filename" ] && keep_src="${keep_src}${keep_src:+|}$filename"
                done < "$checksums_file"
            fi
        fi
    done

    to_remove_pkg=""
    to_remove_src=""

    [ "$clean_pkg" -eq 1 ] && to_remove_pkg=$(diff_lists "$all_pkg" "$keep_pkg")
    [ "$clean_src" -eq 1 ] && to_remove_src=$(diff_lists "$all_src" "$keep_src")

    show_list "$to_remove_pkg" "$PACKAGE_DIR"
    show_list "$to_remove_src" "$SOURCE_DIR"

    # Nothing to remove?
    if [ -z "$to_remove_pkg" ] && [ -z "$to_remove_src" ]; then
        msg_info "Cache is already clean."
        return 0
    fi

    if confirm "Remove old caches?" "Old caches are kept."; then
        # delete in parallel
        [ -z "$to_remove_pkg" ] || printf '%s' "$to_remove_pkg" | tr '|' '\n' | xargs -P "$(nproc)" -I{} rm -f "$PACKAGE_DIR/{}"
        [ -z "$to_remove_src" ] || printf '%s' "$to_remove_src" | tr '|' '\n' | xargs -P "$(nproc)" -I{} rm -f "$SOURCE_DIR/{}"

        msg_info "Old caches removed!"
    fi
}

emerald_cat() {
    need_arg "$@"

    PPATH=$(get_port_path "$1") || {
        msg_port_not_found "$1"
        return 1
    }

    cat "$PPATH/$BUILD_SCRIPT"
}

emerald_config() {
    printf '%bMAINOPTS:%b %s\n' "$COLOR5" "$CRESET" "$MAINOPTS"
    printf '%bREPO_FILE:%b %s\n' "$COLOR5" "$CRESET" "$REPO_FILE"
    printf '%bMASK_FILE:%b %s\n' "$COLOR5" "$CRESET" "$MASK_FILE"
    printf '%bALIAS_FILE:%b %s\n' "$COLOR5" "$CRESET" "$ALIAS_FILE"
    printf '%bCONFIG_FILE:%b %s\n' "$COLOR5" "$CRESET" "$CONFIG_FILE"
    printf '%bCFLAGS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$CFLAGS" "$CRESET"
    printf '%bCXXFLAGS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$CXXFLAGS" "$CRESET"
    printf '%bFCFLAGS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$FCFLAGS" "$CRESET"
    printf '%bFFLAGS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$FFLAGS" "$CRESET"
    printf '%bMAKEFLAGS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$MAKEFLAGS" "$CRESET"
    printf '%bLDFLAGS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$LDFLAGS" "$CRESET"
    printf '%bRUSTFLAGS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$RUSTFLAGS" "$CRESET"
    printf '%bCURL_OPTS:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$CURL_OPTS" "$CRESET"
    printf '%bCOMPRESSION_MODE:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$COMPRESSION_MODE" "$CRESET"
    printf '%bNO_STRIP:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$NO_STRIP" "$CRESET"
    printf '%bIGNORE_CHECKSUM:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$IGNORE_CHECKSUM" "$CRESET"
    printf '%bKEEP_LIBTOOL:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$KEEP_LIBTOOL" "$CRESET"
    printf '%bKEEP_LOCALE:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$KEEP_LOCALE" "$CRESET"
    printf '%bKEEP_MAN:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$KEEP_MAN" "$CRESET"
    printf '%bKEEP_INFO:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$KEEP_INFO" "$CRESET"
    printf '%bKEEP_DOC:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$KEEP_DOC" "$CRESET"
    printf '%bKEEP_HELP:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$KEEP_HELP" "$CRESET"
    printf '%bKEEP_GOING:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$KEEP_GOING" "$CRESET"
    printf '%bSOURCE_DIR:%b %s\n' "$COLOR5" "$CRESET" "$SOURCE_DIR"
    printf '%bPACKAGE_DIR:%b %s\n\n' "$COLOR5" "$CRESET" "$PACKAGE_DIR"
    printf '%bPORT_REPO:%b\n' "$COLOR5" "$CRESET"

    for i in $PORT_REPO; do
        printf '  - %s\n' "${i}"
    done

    _cfg_aliased=$(list_show "$ALIAS_FILE")

    if [ -n "$_cfg_aliased" ]; then
        printf '\n%bALIASED PORTS:%b\n' "$COLOR5" "$CRESET"

        printf '%s\n' "$_cfg_aliased" | while read -r _cfg_real _cfg_al _; do
            printf '  - %s -> %s\n' "$_cfg_real" "$_cfg_al"
        done
    fi

    _cfg_masked=$(list_show "$MASK_FILE")

    if [ -n "$_cfg_masked" ]; then
        printf '\n%bMASKED PORTS:%b\n' "$COLOR5" "$CRESET"

        printf '%s\n' "$_cfg_masked" | while IFS= read -r _cfg_m; do
            _mk_ver="$(get_iversion "$_cfg_m")"
            printf '  - %s == %s\n' "$_cfg_m" "$_mk_ver"
        done
    fi

    return 0
}

get_dependent() {
    get_port_path "$1" >/dev/null 2>&1 || return 1

    for repo in $PORT_REPO; do
        awk -v pkg="$1" 'FNR == 1 {
            f = FILENAME;
        } $0 == pkg {
            found = 1;
        } found {
            n = split(f, a, "/");
            print a[n - 1];

            found = 0;
            nextfile;
        }' "$repo"/*/depends 2>/dev/null
    done | sort -u
}

emerald_dependent() {
    need_arg "${@}"

    depends=$(get_dependent "$1") || {
        msg_port_not_found "$1"
        return 1
    }

    for dep in $depends; do
        msg_deps_status "$dep"
    done
}

emerald_depends() {
    need_arg "$@"

    get_port_path "$1" >/dev/null || {
        msg_port_not_found "$1"
        return 1
    }

    depends=$(get_depends "$1")
    msg_deps_status $depends
}

emerald_conflicts() {
    need_arg "$@"

    get_port_path "$1" >/dev/null || {
        msg_port_not_found "$1"
        return 1
    }

    conflicts=$(get_conflicts "$1")
    msg_deps_status $conflicts
}

deplist() {
    # Resolve in a single awk pass, visiting dependencies in post-order exactly like
    # the former recursive shell version (no forks per port, ~90x faster resolution).
    # Args:  "<ports>"  (space separated; may be passed as one quoted string)
    # Reads: quick, exclude, skip_root, ALIAS_PORT, PORT_REPO, CBUILD_DIR, PKGDB_DIR
    # Appends to: DEP, MISSING_DEP
    _dl_alias=""

    if [ "$ALIAS_PORT" = "yes" ]; then
        _dl_alias="$ALIAS_FILE"
    fi

    _dl_out=$(awk \
        -v repos="$PORT_REPO" \
        -v build_script="$BUILD_SCRIPT" \
        -v cbuild_dir="$CBUILD_DIR" \
        -v pkgdb_dir="$PKGDB_DIR" \
        -v alias_file="$_dl_alias" \
        -v quick="$quick" \
        -v exclude="$exclude" \
        -v skip_root="$skip_root" \
        -v roots="$*" \
        -v initial_deps="$DEP" \
        -v initial_missing="$MISSING_DEP" \
    'function file_exists(path, result) {
        result = (getline _line < path);
        close(path);

        return result >= 0;
    }

    # Find the first repository providing the build script.
    function find_port(package, repo_idx, port_path) {
        if (package in port_path_cache) return port_path_cache[package];
        port_path_cache[package] = "";

        for (repo_idx = 1; repo_idx <= repo_count; repo_idx++) {
            port_path = sprintf("%s/%s", repo[repo_idx], package);

            if (file_exists(sprintf("%s/%s", port_path, build_script))) {
                port_path_cache[package] = port_path;
                break;
            }
        }

        return port_path_cache[package];
    }

    function is_installed(package) {
        if (package == "") return 0;
        if (!(package in installed)) installed[package] = file_exists(sprintf("%s/%s", pkgdb_dir, package));

        return installed[package];
    }

    # Load package dependencies.
    function load_deps(package, dep_file, port_path, line, word_count, word_idx, dependency, dep_idx) {
        if (package in dep_count) return;

        dep_count[package] = 0;
        dep_file = sprintf("%s/%s.dep", cbuild_dir, package);

        if (!file_exists(dep_file)) {
            port_path = find_port(package);
            if (port_path == "") return;

            dep_file = sprintf("%s/depends", port_path);
            if (!file_exists(dep_file)) return;
        }

        while ((getline line < dep_file) > 0) {
            word_count = split(line, words);

            for (word_idx = 1; word_idx <= word_count; word_idx++) {
                dependency = words[word_idx];
                if (alias_on && (dependency in alias)) dependency = alias[dependency];

                if (dependency != "") {
                    dep_idx = ++dep_count[package];
                    dependencies[package, dep_idx] = dependency;
                }
            }
        }

        close(dep_file);
    }

    function add_to_order(package) {
        in_order[package] = 1;
        order[++order_count] = package;
    }

    # Recursively resolve package dependencies.
    function resolve_deps(package, dep_idx, dependency) {
        if ((package in excluded) || (package in resolving)) return;

        resolving[package] = 1;
        load_deps(package);

        for (dep_idx = 1; dep_idx <= dep_count[package]; dep_idx++) {
            dependency = dependencies[package, dep_idx];

            if ((quick == 1) && is_installed(dependency)) continue;
            if (dependency in in_order) continue;

            if (find_port(dependency) == "") {
                missing = sprintf("%s %s(%s) ", missing, dependency, package);
                continue;
            }

            resolve_deps(dependency);
        }

        if (!(package in in_order) && !((quick == 1) && is_installed(package))) add_to_order(package);
        delete resolving[package];
    } BEGIN {
        repo_count    = split(repos, repo);
        exclude_count = split(exclude, names);

        for (idx = 1; idx <= exclude_count; idx++) excluded[names[idx]] = 1;
        initial_dep_count = split(initial_deps, names);

        for (idx = 1; idx <= initial_dep_count; idx++) {
            if (!(names[idx] in in_order)) add_to_order(names[idx]);
        }

        if (alias_file != "") {
            alias_on = 1;

            while ((getline line < alias_file) > 0) {
                if (line ~ /^[[:space:]]*$/ || line ~ /^#/) continue;

                split(line, names);
                alias[names[1]] = names[2];
            }

            close(alias_file);
        }

        root_count = split(roots, names);

        for (idx = 1; idx <= root_count; idx++) {
            if ((skip_root == 1) && (names[idx] in in_order)) continue;
            resolve_deps(names[idx]);
        }

        printf "D";
        for (idx = 1; idx <= order_count; idx++) printf " %s", order[idx];
        printf "\nM %s %s\n", initial_missing, missing;
    }')

    {
        read -r _dl_t DEP
        read -r _dl_t MISSING_DEP
    } <<EOF
$_dl_out
EOF
}

emerald_deplist() {
    need_arg "${@}"

    # reset accumulators
    PKG=""
    quick=""
    exclude=""

    # parse arguments
    OLDIFS=$IFS
    IFS=,

    while [ -n "$1" ]; do
        case $1 in
            -q | --quick) quick=1 ;;

            --exclude=*)
                for i in ${1#*=}; do
                    exclude="$exclude $i "
                done
            ;;

            -*) ;;
            *) PKG="$PKG $1 " ;;
        esac

        shift
    done

    IFS=$OLDIFS

    # validate packages
    for p in $PKG; do
        get_port_path "$p" >/dev/null 2>&1 || {
            [ "$quick" != 1 ] && msg_port_not_found "$p"
            continue
        }

        PPKG="$PPKG $p "
    done

    # process dependencies
    deplist "$PPKG"

    [ -n "$DEP" ] || return 0

    if [ "$quick" = 1 ]; then
        printf "%s\n" $DEP
        return 0
    fi

    msg_deps_status $DEP

    if [ -n "$MISSING_DEP" ]; then
        for m in $MISSING_DEP; do
            printf "Missing deps: %s\n" "$m" | sed 's/(/ (/'
        done
    fi
}

dup_status() {
    IFS='|' read -r dversion drelease <<EOF
$(awk '/^version=/ {
    gsub(/version=|["'\'']/, "");
    gsub(/[^A-Za-z0-9._+-]/, "");

    v = $0;
} /^release=/ {
    gsub(/release=|["'\'']/, "");
    gsub(/[^A-Za-z0-9._+-]/, "");

    r = $0;
} END {
    printf "%s|%s", v, r;
}' "$2/$1/$BUILD_SCRIPT")
EOF

    emerald_is_installed "$1" && ins=$(printf "[%bi%b]" "$COLOR2" "$CRESET") || ins="[ ]"
    printf "%b %b(%s)%b %s %b%s-%s%b\n" "$ins" "$COLOR5" "${2##*/}" "$CRESET" "$1" "$COLOR4" "$dversion" "$drelease" "$CRESET"
}

emerald_dup() {
    # shellcheck disable=SC2086
    dup=$(find $PORT_REPO -mindepth 1 -maxdepth 1 -type d -printf '%P\n' 2>/dev/null | sort | uniq -d)

    if [ -z "$dup" ]; then
        msg_info "No duplicate ports found."
        return 0
    fi

    for dport in $dup; do
        for drepo in $PORT_REPO; do
            [ -d "$drepo/$dport" ] && dup_status "$dport" "$drepo"
        done
    done
}

emerald_files() {
    need_arg "$@"

    emerald_is_installed "$1" || {
        msg_port_not_installed "$1"
        return 0
    }

    tail -n +2 "$PKGDB_DIR/$1"
}

emerald_foreign() {
    foreign_found=0

    for pkg in $(all_installed); do
        get_port_path "$pkg" >/dev/null || {
            iversion=$(get_iversion "$pkg")
            printf "%s %s\n" "$pkg" "$iversion"

            foreign_found=1
        }
    done

    [ "$foreign_found" -ne 0 ] || msg_info "No foreign packages found."
    return 0
}

emerald_help() {
    cat <<EOF
Usage:
    @PROJECT_NAME@ <options> [<arg>]

Options:
    search       <pattern>         find ports in repo
                                   -n, --name   search in port names only

    sync                   <arg>   update ports database (use portsync arg)
                                   -p, --prune  prune local git repository
                                   -r, --reset  reset git repositories

    build        <ports>   <arg>   build ports (use pkgbuild arg, except '-i', '-u', '-r', '-g', & '-p')
                                   -f           force rebuild package
                                   -k           keep going building next package on error
                                   -m           skip checksum checking
                                   -o           fetch sources only
                                   -q, --quiet  show only status messages and errors
                                   -w           keep working directory
                                   -y           skip ask user confirmation
                                   -C, --clean  remove downloaded sources and prebuilt packages
                                   --log        log build process (/var/log/name-version-release-date.log)
                                   --jobs=<N>   override parallel build jobs (default: JOBS in config, or nproc)

    install      <ports>   <arg>   install ports (use pkgbuild arg, except '-i' & '-u')
                                   -c           ignore conflict when installing package
                                   -f           force rebuild package
                                   -k           keep going installing next package on error
                                   -m           skip checksum checking
                                   -n           skip dependencies
                                   -o           fetch sources only
                                   -q, --quiet  show only status messages and errors
                                   -r           reinstall
                                   -w           keep working directory
                                   -y, --yes    skip ask user confirmation
                                   --exclude=*  exclude dependencies, comma separated
                                   --no-backup  skip backup when reinstalling package
                                   --jobs=<N>   override parallel build jobs (default: JOBS in config, or nproc)

    upgrade      <ports>   <arg>   upgrade ports (use pkgbuild arg, except '-i' & '-r')
                                   -c           ignore conflict when installing package
                                   -f           force rebuild package
                                   -k           keep going upgrading next package on error
                                   -m           skip checksum checking
                                   -n           skip dependencies
                                   -o           fetch sources only
                                   -q, --quiet  show only status messages and errors
                                   -w           keep working directory
                                   -y, --yes    skip ask user confirmation
                                   --exclude=*  exclude dependencies, comma separated
                                   --no-backup  skip backup when upgrading package
                                   --jobs=<N>   override parallel build jobs (default: JOBS in config, or nproc)

    sysup                  <arg>   full system upgrade (use pkgbuild arg, except '-i', '-r'  & '-u')
                                   -c           ignore conflict when installing package
                                   -f           force rebuild package
                                   -k           keep going upgrading next package on error
                                   -m           skip checksum checking
                                   -n           skip dependencies
                                   -o           fetch sources only
                                   -q, --quiet  show only status messages and errors
                                   -w           keep working directory
                                   -y, --yes    skip ask user confirmation
                                   --exclude=*  exclude dependencies, comma separated
                                   --no-backup  skip backup when upgrading package
                                   --jobs=<N>   override parallel build jobs (default: JOBS in config, or nproc)

    remove       <ports>   <arg>   remove installed ports (use pkgdel arg)
                                   -y, --yes    skip ask user confirmation

    deplist      <ports>           print all dependencies for ports
                                   -q, --quick  skip installed ports
                                   --exclude=*  exclude dependencies, comma separated

    redeps       <ports>   <arg>   find redundant dependencies
                                   -w, --world  check redundant entries in world
                                   -f, --fix    fix (remove) redundant port deps / world entries

    cache                          (no args)    clean packages AND sources cache
                                   -p, --pkg    clean packages cache only
                                   -s, --src    clean sources cache only

    cat          <port>            print $BUILD_SCRIPT
    config                         print @PROJECT_NAME@ config
    dependent    <port>            print reverse dependencies
    depends      <port>            print dependencies
    conflicts    <port>            print conflicting ports
    dup                            print duplicate ports
    files        <port>            print files installed
    foreign                        print foreign ports
    help                           print this help
    hook  <stage> <action> <port>  run port hook on demand (run '@PROJECT_NAME@ hook' for help)
    info         <port>            print information
    installed                      print all installed ports
    integrity                      check installed port integrity
    is-installed  <port>           check whether port is installed (status 0=installed, 1=not installed)
    locate       <file>            print location of file in ports repo
    alias        <arg>             manage aliased ports (run '@PROJECT_NAME@ alias help' for usage)
    mask         <arg>             manage masked ports (run '@PROJECT_NAME@ mask help' for usage)
    missing-deps                   print missing dependencies
    orphan                         print orphan installed ports
    outdated                       print outdated ports
    path         <port>            print path in repo
    provide      <file>            print ports provided file
    purge        [ports]           remove installed ports and its orphan dependencies
    trigger      [ports]           run system trigger
    world        [ports]           print/add/remove world list
    list                           print all available ports
    version                        print version information and exit

Global options:
    --append-repo=<repo path>      append custom local repo path (can use multiple times)
    --prepend-repo=<repo path>     prepend custom local repo path (can use multiple times)
    --override-repo=<repo path>    override repo in $REPO_FILE with custom local repo (can use multiple times)
    --repo-file=<repo file>        use custom repo file (default: $REPO_FILE)
    --config-file=<config file>    use custom config file (default: $CONFIG_FILE)
    --alias-file=<alias file>      use custom alias file (default: $ALIAS_FILE)
    --mask-file=<mask file>        use custom mask file (default: $MASK_FILE)
EOF
}

emerald_list() {
    find "@PORTS_DIR@" -mindepth 2 -maxdepth 2 -type d | while IFS= read -r p; do
        printf '%s\n' "${p##*/}"
    done
}

emerald_version() {
    printf "%s v%s\n" "@PROJECT_NAME@" "@PROJECT_VERSION@"
    exit 0
}

format_deps() {
    _dep="$1"

    if [ -z "$_dep" ]; then
        printf 'None'
        return
    fi

    for pkg in $_dep; do
        color="$(emerald_is_installed "$pkg" && printf '%b' "$COLOR2" || printf '%b' "$COLOR1")"
        printf "%b%s%b " "$color" "$pkg" "$CRESET"
    done
}

emerald_info() {
    need_arg "$@"

    while [ -n "$1" ]; do
        case $1 in
            --field=*) FIELD="${1#*=}" ;;
            *) PKGNAME="$1" ;;
        esac

        shift
    done

    PPATH=$(get_port_path "$PKGNAME") || {
        msg_port_not_found "$PKGNAME"
        return 1
    }

    IFS='|' read -r version release commit description maintainer homepage <<EOF
$(awk '/^version=/ {
    sub(/version=/, "");
    gsub(/"/, "");

    v = $0;
} /^release=/ {
    sub(/release=/, "");
    r = $0;
} /^commit=/ {
    sub(/commit=/, "");
    gsub(/"/, "");

    c = $0;
} /^description=/ {
    sub(/description=/, "");
    gsub(/"/, "");

    d = $0;
} /^maintainer=/ {
    sub(/maintainer=/, "");
    gsub(/"/, "");

    m = $0;
} /^homepage=/ {
    sub(/homepage=/, "");
    gsub(/"/, "");

    h = $0;
} END {
    printf "%s|%s|%s|%s|%s|%s", v, r, c, d, m, h;
}' "$PPATH/$BUILD_SCRIPT")
EOF

    # Read installed version
    iver="$(get_iversion "$PKGNAME")"
    [ -z "$iver" ] && iver="Not installed"

    # Read depends file
    deps=$(get_depends "$PKGNAME" | tr '\n' ' ')
    deps_out=$(format_deps "$deps")

    # Check conflicts
    conflicts=$(get_conflicts "$PKGNAME" | tr '\n' ' ')
    conflicts_out=$(format_deps "$conflicts")

    # Check dependent (required by)
    required_by=$(get_dependent "$PKGNAME" | tr '\n' ' ')
    required_by_out=$(format_deps "$required_by")

    # Check alias: the queried port can appear as either the 'real' name
    # (1st field) or the 'alias' name (2nd field) in $ALIAS_FILE, e.g. for
    # a line "rust rust-lang", both '@PROJECT_NAME@ info rust' and '@PROJECT_NAME@ info rust-lang'
    # must report the relationship.
    port_alias=$(awk -v pkg="$PKGNAME" '!/^[[:space:]]*$/ && !/^#/ {
        if ($1 == pkg) {
            print $2;
            exit;
        }

        if ($2 == pkg) {
            print $1;
            exit;
        }
    }' "$ALIAS_FILE")

    [ -z "$port_alias" ] && port_alias="None"

    # Check masked (exact first-field match, '-' is not a word char so grep -w won't do)
    masked="No"
    grep -qE "^$PKGNAME([[:space:]]|$)" "$MASK_FILE" 2>/dev/null && masked="Yes"

    if [ -n "$FIELD" ]; then
        case "$FIELD" in
            description) printf '%s\n' "$description" ;;
            maintainer) printf '%s\n' "$maintainer" ;;
            homepage) printf '%s\n' "$homepage" ;;
            path) printf '%s\n' "$PPATH" ;;
            name) printf '%s\n' "$PKGNAME" ;;
            version) printf '%s\n' "$version" ;;
            release) printf '%s\n' "$release" ;;
            commit) [ -z "$commit" ] || printf '%s\n' "$commit" ;;
            installed) printf '%s\n' "$iver" ;;
            aliased) printf '%s\n' "$port_alias" ;;
            masked) printf '%s\n' "$masked" ;;
            depends) printf '%s\n' "$deps_out" ;;
            conflicts) printf '%s\n' "$conflicts_out" ;;
            required-by) printf '%s\n' "$required_by_out" ;;

            *)
                printf 'Unknown field: %s\n' "$FIELD" >&2
                return 1
            ;;
        esac

        return 0
    fi

    printf '%bDescription:%b %s\n' "$COLOR5" "$CRESET" "$description"
    printf '%bMaintainer:%b %s\n' "$COLOR5" "$CRESET" "$maintainer"
    printf '%bHomepage:%b %s\n' "$COLOR5" "$CRESET" "$homepage"
    printf '%bPath:%b %s\n' "$COLOR5" "$CRESET" "$PPATH"
    printf '%bName:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$PKGNAME" "$CRESET"
    printf '%bVersion:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$version" "$CRESET"
    printf '%bRelease:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR4" "$release" "$CRESET"
    [ -z "$commit" ] || printf '%bCommit:%b %s\n' "$COLOR5" "$CRESET" "$commit"
    printf '%bInstalled:%b %b%s%b\n' "$COLOR5" "$CRESET" "$COLOR2" "$iver" "$CRESET"
    printf '%bAliased:%b %s\n' "$COLOR5" "$CRESET" "$port_alias"
    printf '%bMasked:%b %s\n' "$COLOR5" "$CRESET" "$masked"
    printf '%bDepends:%b %s\n' "$COLOR5" "$CRESET" "$deps_out"
    printf '%bConflicts:%b %s\n' "$COLOR5" "$CRESET" "$conflicts_out"
    printf '%bRequired by:%b %s\n' "$COLOR5" "$CRESET" "$required_by_out"
}

hook() {
    # hook <stage> <action> [port] [current-version] [new-version]
    # if using -o (download only), dont run hook
    [ "$DOWNLOAD_ONLY" = 1 ] && return 0
    # if using -r (reinstall), dont run hook
    [ "$REINSTALL" = 1 ] && return 0

    hook_stage="$1"
    hook_action="$2"
    port="$3"
    current_version="$4"
    new_version="$5"
    hook_dir="$(get_port_path "$port")"

    # Hooks receive the installed version as $1 and the version being
    # installed as $2. Explicit versions keep post hooks stable after the
    # package database is updated.
    if [ "$#" -lt 5 ]; then
        case "$hook_action" in
            install)
                new_version=$(get_version "$port")
                [ "$hook_stage" = "post" ] && current_version=$(get_iversion "$port")
            ;;

            upgrade)
                current_version=$(get_iversion "$port")
                new_version=$(get_version "$port")
            ;;

            remove) current_version=$(get_iversion "$port") ;;
        esac
    fi

    current_version="${current_version%-*}"
    new_version="${new_version%-*}"

    hook="$hook_dir/$port.install"
    hook_function="${hook_stage}_${hook_action}"

    # The single install file and each function in it are optional.
    if [ -f "$hook" ]; then
        (
            cd "$hook_dir" || exit 1

            # shellcheck source=$port.install
            . "./$port.install" || exit 1
            command -v "$hook_function" >/dev/null 2>&1 || exit 0

            msg_info "$port: hook ${hook_stage}-${hook_action}"
            "$hook_function" "$current_version" "$new_version"
        )
    fi
}

emerald_hook() {
    require_root

    if [ -z "$1" ] || [ -z "$2" ] || [ -z "$3" ]; then
        msg_warning "Usage: @PROJECT_NAME@ hook <stage> <action> <port>"

        msg_info "@PROJECT_NAME@ hook <pre|post> <install|upgrade|remove> <port>"
        msg_info "Example: @PROJECT_NAME@ hook post install linux"

        return 1
    fi

    stage="$1"
    action="$2"
    port="$3"

    case "$stage" in
        pre | post) ;;

        *)
            msg_error "stage must be 'pre' or 'post'"
            return 1
        ;;
    esac

    case "$action" in
        install | upgrade | remove) ;;

        *)
            msg_error "action must be 'install', 'upgrade' or 'remove'"
            return 1
        ;;
    esac

    hook "$stage" "$action" "$port"
}

emerald_install() {
    require_root "Installing package"
    need_arg "${@}"

    failed_installs=""
    skipped_installs=""

    while [ -n "$1" ]; do
        case $1 in
            -i | -u) ;;
            -r) REINSTALL=1 ;;

            -o)
                DOWNLOAD_ONLY=1
                OPTS="$OPTS $1"
            ;;

            -y | --yes) NOCONFIRM=1 ;;
            -n) NO_DEP=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            --exclude=*) EXOPT=$1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    # if reinstall, dont calculate dep, just reinstall it then exit
    if [ "$REINSTALL" = 1 ]; then
        error=0

        for ii in $PKGNAME; do
            PPATH=$(get_port_path "$ii") || {
                msg_port_not_found "$ii"

                if keep_going; then
                    failed_installs="$failed_installs $ii"
                    continue
                fi

                return 1
            }

            emerald_is_installed "$ii" || {
                msg_port_not_installed "$ii"

                if keep_going; then
                    failed_installs="$failed_installs $ii"
                    continue
                fi

                return 1
            }

            check_conflicts "$ii"

            cd "$PPATH" || return 1
                set_term_title "Reinstalling $ii..."

                pkgbuild -r $OPTS || {
                    error=1

                    if keep_going; then
                        msg_warning "Reinstall failed for '$ii', continuing with next package..."
                        failed_installs="$failed_installs $ii"

                        cd - >/dev/null || return 1
                        continue
                    fi

                    cd - >/dev/null || return 1
                    break
                }

                done_pkg="$done_pkg $ii"
            cd - >/dev/null || return 1
        done

        [ -n "$done_pkg" ] && emerald_trigger "$done_pkg"

        # Show error summary if exist
        FAILED_PKGS="$failed_installs"
        SKIPPED_PKGS="$skipped_installs"

        summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "reinstall"
        set_term_title "Package(s) reinstalled."

        return "$error"
    fi

    # No dep
    if [ "$NO_DEP" = 1 ]; then
        error=0

        for ii in $PKGNAME; do
            PPATH=$(get_port_path "$ii") || {
                msg_port_not_found "$ii"

                if keep_going; then
                    failed_installs="$failed_installs $ii"
                    continue
                fi

                return 1
            }

            if emerald_is_installed "$ii"; then
                msg_port_already_installed "$ii"
                skipped_installs="$skipped_installs $ii"

                continue
            fi

            check_conflicts "$ii"

            cd "$PPATH" || return 1
                set_term_title "Installing $ii..."

                pkgbuild -i $OPTS || {
                    error=1

                    if keep_going; then
                        msg_warning "Install failed for '$ii', continuing with next package..."
                        failed_installs="$failed_installs $ii"

                        cd - >/dev/null || return 1
                        continue
                    fi

                    cd - >/dev/null || return 1
                    break
                }

                done_pkg="$done_pkg $ii"
                world_add "$ii"
            cd - >/dev/null || return 1
        done

        [ -n "$done_pkg" ] && emerald_trigger "$done_pkg"

        # Show error summary if exist
        FAILED_PKGS="$failed_installs"
        SKIPPED_PKGS=""

        summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "install"
        set_term_title "Package(s) installed."

        return "$error"
    fi

    for i in $PKGNAME; do
        get_port_path "$i" >/dev/null 2>&1 || {
            msg_port_not_found "$i"
            continue
        }

        if emerald_is_installed "$i"; then
            msg_port_already_installed "$i"
            continue
        fi

        IPKG="$IPKG $i"
    done

    [ -n "$IPKG" ] || return 0

    printf "Resolving dependencies...\n"
    INST="$(emerald_deplist -q "$IPKG" "$EXOPT")"

    if [ -n "$INST" ]; then
        printf "\n"

        pkgcount=0
        install_msg="ACTION#PORTNAME#VERSION"

        for pkg in $INST; do
            pkgcount=$(( pkgcount + 1 ))
            install_msg="$install_msg install#$pkg#$(get_version "$pkg")"
        done

        printf "%s\n" "$install_msg" | tr ' ' '\n' | tr '#' ' ' | column -t
        printf "\n"
        printf "( %s install )\n" "$pkgcount"
        printf "\n"

        if [ "$NOCONFIRM" != 1 ]; then
            confirm "Continue install package(s)?" "Package installation cancelled." || exit $?
            printf "\n"
        fi

        error=0
        count=0
        total=$(printf "%s\n" "$INST" | wc -w)

        for inst in $INST; do
            count=$(( count + 1 ))

            PPATH=$(get_port_path "$inst") || {
                msg_warning "Skipping missing package: $inst"
                skipped_installs="$skipped_installs $inst"

                continue
            }

            check_conflicts "$inst"

            cd "$PPATH" || return 1
                install_version=$(get_version "$inst")

                set_term_title "[ $count/$total ] installing $inst..."
                hook pre install "$inst" "" "$install_version"

                pkgbuild -i $OPTS || {
                    error=1

                    if keep_going; then
                        msg_warning "Install failed for '$inst', continuing with next package..."
                        failed_installs="$failed_installs $inst"

                        cd - >/dev/null || return 1
                        continue
                    fi

                    cd - >/dev/null || return 1
                    break
                }

                case " $IPKG " in
                    *" $inst "*) world_add "$inst" ;;
                esac

                hook post install "$inst" "$install_version" "$install_version"
                done_pkg="$done_pkg $inst"
            cd - >/dev/null || return 1
        done

        [ -z "$done_pkg" ] || emerald_trigger "$done_pkg"

        # Show error summary if exist
        FAILED_PKGS="$failed_installs"
        SKIPPED_PKGS="$skipped_installs"

        summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "install"
        summary_title "$error" "$done_pkg" "$count" "$total" "installed"

        return "$error"
    fi
}

emerald_installed() {
    find "$PKGDB_DIR" -maxdepth 1 -type f | while IFS= read -r _f; do
        read -r _v _r _ < "$_f"
        printf '%s %s-%s\n' "${_f##*/}" "$_v" "$_r"
    done
}

emerald_integrity() {
    require_root

    if [ -n "$1" ]; then
        pkg="$1"
        printf "Checking '%s' integrity...\n" "$pkg"

        [ -f "$PKGDB_DIR/$pkg" ] || {
            msg_port_not_installed "$pkg"
            return 1
        }

        found=0

        {
            read -r _ # skip header

            while IFS= read -r line; do
                [ -e "/$line" ] && continue
                found=1

                [ -L "/$line" ] && printf "broken symlink %s: /%s\n" "$pkg" "$line" || printf "file missing %s: /%s\n" "$pkg" "$line"
            done
        } < "$PKGDB_DIR/$pkg"

        if [ "$found" -eq 0 ]; then
            msg_info "'$pkg' integrity is OK!"
            return 0
        fi

        return 1
    fi

    printf "Checking ports integrity...\n"
    interr=$(mktemp) || return 1

    # shellcheck disable=SC2016
    all_installed | xargs -P "$(nproc)" -I{} sh -c '
        pkg="$1"
        db="$2/$pkg"
        interr="$3"

        [ -f "$db" ] || exit 0

        {
            read -r _

            while IFS= read -r line; do
                [ -e "/$line" ] && continue

                # mark error
                printf 1 >> "$interr"

                [ -L "/$line" ] && printf "broken symlink %s: /%s\n" "$pkg" "$line" || printf "file missing %s: /%s\n" "$pkg" "$line"
            done
        } < "$db"
    ' _ {} "$PKGDB_DIR" "$interr"

    status=1

    [ -s "$interr" ] || {
        msg_info "No integrity issues found!"
        status=0
    }

    rm -f "$interr"
    return "$status"
}

emerald_is_installed() {
    [ -n "$1" ] && [ -f "$PKGDB_DIR/$1" ]
}

emerald_locate() {
    need_arg "$@"

    for repo in $PORT_REPO; do
        grep -Ri "$1" "$repo"/*/@PKGFILES_FILE@ 2>/dev/null | sed 's/:/ /;s|/@PKGFILES_FILE@||' | awk '{printf "%s %s\n", $1, $4;}'
    done
}

emerald_missing_deps() {
    printf "Checking ports missing deps...\n"
    found=0

    while IFS= read -r pkg; do
        get_port_path "$pkg" >/dev/null || continue
        depends=$(get_depends "$pkg")

        [ -z "$depends" ] && continue
        msd=""

        for d in $depends; do
            emerald_is_installed "$d" || msd="$msd $d"
        done

        if [ -n "$msd" ]; then
            msg_info "$pkg:$msd"
            found=1
        fi
    done <<EOF
$(all_installed)
EOF

    if [ "$found" -eq 0 ]; then
        msg_info "No ports missing deps found!"
        return 0
    fi

    return 1
}

emerald_orphan() {
    if [ -f "$WORLD_FILE" ]; then
        _world_roots=""

        while IFS= read -r i; do
            case " $* " in
                *" $i "*) continue ;;
            esac

            _world_roots="$_world_roots $i"
        done < "$WORLD_FILE"

        skip_root=1
        deplist "$_world_roots"
        skip_root=0
    fi

    all_installed | awk -v dep=" $DEP " '{
        if (index(dep, " " $0 " ") == 0) print;
    }'
}

version_compare() {
    [ "$1" = "$2" ] && return 0

    # - If sorted (exit code 0): $1 <= $2, but we know $1 != $2, so $1 < $2 → return 1
    # - If not sorted (exit code 1): $1 > $2 → return 2
    printf '%s\n%s\n' "$1" "$2" | LC_ALL=C sort -VC && return 1 || return 2
}

check_outdated() {
    _MASKED_LIST=$(awk '!/^[[:space:]]*$/ && !/^#/ {
        printf "%s ", $0;
    }' "$MASK_FILE" 2>/dev/null)

    # Build port version map in memory (first-repo-wins via dedup).
    _vmap=$(for _repo in $PORT_REPO; do
        awk 'FNR == 1 {
            if (name != "") printf "%s %s-%s\n", name, (ver ? ver : 0), (rel ? rel : 0);
            name = ver = rel = "";
        } /^name=/ {
            sub(/^name=/, "");
            gsub(/[^[:alnum:]._+~-]/, "");

            name = $0;
        } /^version=/ {
            sub(/^version=/, "");
            gsub(/[^[:alnum:]._+~-]/, "");

            ver = $0;
        } /^release=/ {
            sub(/^release=/, "");
            gsub(/[^[:alnum:]._+~-]/, "");

            rel = $0;
        } END {
            if (name != "") printf "%s %s-%s\n", name, (ver ? ver : 0), (rel ? rel : 0);
        }' "$_repo"/*/"$BUILD_SCRIPT" 2>/dev/null
    done | awk '!seen[$1]++;')

    [ -n "$_vmap" ] || return 0

    # Pipe installed map (built with shell read builtins, zero extra forks) into
    # a single awk that loads portver[] from _vmap and joins in memory.
    for _pkg in $(all_installed); do
        read -r _v _r _ < "$PKGDB_DIR/$_pkg" && printf '%s %s-%s\n' "$_pkg" "$_v" "$_r"
    done | awk -v vmap="$_vmap" 'BEGIN {
        n = split(vmap, lines, "\n");

        for (i = 1; i <= n; i++) {
            if (split(lines[i], a, " ") == 2) portver[a[1]] = a[2];
        }
    } ($1 in portver) && (portver[$1] != $2) {
        printf "%s#%s#%s\n", $1, $2, portver[$1];
    }' | while IFS='#' read -r pkgname ivr pvr; do
        NEW_INSTALLED=0

        pversion=${pvr%-*}
        prelease=${pvr#*-}

        iversion=${ivr%-*}
        irelease=${ivr#*-}

        if [ "$pversion" != "$iversion" ]; then
            version_compare "$pversion" "$iversion"
            [ "$?" -ne 1 ] || NEW_INSTALLED=1
        elif [ "$prelease" != "$irelease" ]; then
            version_compare "$prelease" "$irelease"
            [ "$?" -ne 1 ] || NEW_INSTALLED=1
        fi

        MASKED=0

        case " $_MASKED_LIST " in
            *" $pkgname "*) MASKED=1 ;;
        esac

        # Example: 'glib#2.87.0-1#2.88.1-1#1#0'
        printf "%s#%s#%s#%s#%s\n" "$pkgname" "$ivr" "$pvr" "$NEW_INSTALLED" "$MASKED"
    done
}

emerald_outdated() {
    out=$(check_outdated)

    if [ -z "$out" ]; then
        msg_info "All packages are up to date."
        return 0
    fi

    printf '%s\n' "$out" | while IFS='#' read -r pname oldver newver newins masked; do
        unset ii

        [ "$newins" = 1 ] && ii=" [newer installed]"
        [ "$masked" = 1 ] && ii="$ii [masked]"

        printf "%s %s => %s%s\n" "$pname" "$oldver" "$newver" "$ii"
    done
}

emerald_path() {
    need_arg "$@"

    PPATH=$(get_port_path "$1") || {
        msg_port_not_found "$1"
        return 1
    }

    printf "%s\n" "$PPATH"
}

emerald_provide() {
    need_arg "$@"
    grep -RF "$1" "$PKGDB_DIR" | sed "s:$PKGDB_DIR/::" | tr : "\t"
}

emerald_purge() {
    require_root "Purging package"
    need_arg "$@"

    while [ -n "$1" ]; do
        case $1 in
            -*) PURGE_OPTS="$PURGE_OPTS $1" ;;
            *) PURGE_NAME="$PURGE_NAME $1" ;;
        esac

        shift
    done

    for i in $PURGE_NAME; do
        emerald_is_installed "$i" || {
            msg_port_not_installed "$i"
            need_exit=1
        }
    done

    [ "$need_exit" = 1 ] && exit 1

    printf "Resolving dependencies...\n"
    orphan=$(emerald_orphan "$PURGE_NAME" | tr '\n' ' ')

    for purge in $PURGE_NAME; do
        unset DEP pkg
        deplist "$purge"

        for ii in $DEP; do
            case " $orphan $PURGE_NAME " in
                *" $ii "*) pkg="$pkg $ii" ;;
            esac
        done

        [ -n "$remove" ] && remove="$remove $pkg" || remove="$pkg"
    done

    if [ -z "$remove" ]; then
        printf "No orphan packages found...\n"
        return 0
    fi

    remove=$(printf '%s\n' $remove | awk '!seen[$0]++;') # remove duplicate shared dependencies
    emerald_remove $remove $PURGE_OPTS
}

redeps_world() {
    [ "$fix" = 1 ] && require_root
    printf "Checking world redeps...\n"

    [ -s "$WORLD_FILE" ] || {
        msg_info "world is empty"
        return 0
    }

    # Stale entries are reported and removed from the active world set.
    _world=""
    _stale=""
    _found=0

    while IFS= read -r _pkg; do
        [ -n "$_pkg" ] || continue

        emerald_is_installed "$_pkg" || {
            printf "[world] %s (not installed)\n" "$_pkg"
            _stale="$_stale $_pkg"

            _found=1
            continue
        }

        get_port_path "$_pkg" >/dev/null || {
            printf "[world] %s (no port found)\n" "$_pkg"
            _found=1
        }

        _world="$_world $_pkg"
    done < "$WORLD_FILE"

    if [ "$fix" = 1 ]; then
        for _pkg in $_stale; do
            world_del "$_pkg"
            msg_info " $_pkg removed from world"
        done
    fi

    # A world entry removed from _active can no longer act as a puller.
    _active=$_world

    for _root in $_world; do
        case " $_active " in
            *" $_root "*) ;;
            *) continue ;;
        esac

        DEP=""
        deplist "$_root"

        for _dep in $_active; do
            [ "$_dep" = "$_root" ] && continue

            case " $DEP " in
                *" $_dep "*)
                    printf "[world] %s (already pulled from %s)\n" "$_dep" "$_root"

                    _found=1
                    _remaining=""

                    for _pkg in $_active; do
                        [ "$_pkg" = "$_dep" ] || _remaining="$_remaining $_pkg"
                    done

                    _active=$_remaining

                    if [ "$fix" = 1 ]; then
                        world_del "$_dep"
                        msg_info " $_dep removed from world"
                    fi
                ;;
            esac
        done
    done

    [ "$_found" -eq 1 ] || msg_info "No redeps found in world!"
}

emerald_redeps() {
    need_arg "$@"

    while [ -n "$1" ]; do
        case $1 in
            --world | -w) world=1 ;;
            --fix | -f) fix=1 ;;
            --help | -h) emerald_help ;;
            *) pkg="$pkg $1" ;;
        esac

        shift
    done

    [ "$world" = 1 ] && redeps_world

    for i in $pkg; do
        PPATH=$(get_port_path "$i") || {
            msg_port_not_found "$i"
            continue
        }

        printf "Checking %s redeps...\n" "$i"
        deps_i=$(get_depends "$i")

        if [ -z "$deps_i" ]; then
            msg_info "No depends found in $i!"
            continue
        fi

        _rd_found=0

        for d in $deps_i; do
            # resolve the closure of $d once, not once per sibling dependency
            DEP="" # deplist() seeds its output with $DEP
            deplist "$d"

            for dd in $deps_i; do
                [ "$dd" = "$d" ] && continue

                case " $DEP " in
                    *" $dd "*) found=1 ;;
                    *) found=0 ;;
                esac

                if [ "$found" -eq 1 ]; then
                    printf "[%s] %s (already pulled from %s)\n" "$i" "$dd" "$d"
                    _rd_found=1

                    if [ "$fix" = 1 ]; then
                        deps_file="$PPATH/depends"
                        [ -f "$CBUILD_DIR/$i.dep" ] && deps_file="$CBUILD_DIR/$i.dep"

                        sed -i "/^$dd$/d" "$deps_file"
                        msg_info "$dd removed from $i ${deps_file##*/}"
                    fi
                fi
            done
        done

        [ "$_rd_found" = 1 ] || msg_info "No redeps found in $i!"
    done
}

emerald_remove() {
    require_root "Removing package"
    need_arg "${@}"

    while [ -n "$1" ]; do
        case $1 in
            -y | --yes) NOCONFIRM=1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    for i in $PKGNAME; do
        emerald_is_installed "$i" || {
            msg_port_not_installed "$i"
            continue
        }

        IPKG="$IPKG $i"
    done

    [ -n "$IPKG" ] || return 0
    printf "Removing packages...\n\n"

    pkgcount=0
    count=0
    install_msg="ACTION#PORTNAME#VERSION"

    for pkg in $IPKG; do
        pkgcount=$(( pkgcount + 1 ))
        install_msg="$install_msg remove#$pkg#$(get_iversion "$pkg")"
    done

    printf "%s\n" "$install_msg" | tr ' ' '\n' | tr '#' ' ' | column -t
    printf "\n"
    printf "( %s remove )\n" "$pkgcount"
    printf "\n"

    if [ "$NOCONFIRM" != 1 ]; then
        confirm "Continue remove package(s)?" "Package removing cancelled." || exit $?
        printf "\n"
    fi

    for pkg in $IPKG; do
        count=$(( count + 1 ))
        set_term_title "[ $count/$pkgcount ] Removing $pkg..."

        remove_version=$(get_iversion "$pkg")

        hook pre remove "$pkg" "$remove_version" ""
        printf "remove: %s %s...\n" "$pkg" "$(get_iversion "$pkg")"

        pkgdel "$pkg" $OPTS || {
            error=1
            break
        }

        world_del "$pkg"
        hook post remove "$pkg" "$remove_version" ""
    done

    set_term_title "$pkgcount package(s) removed."
    return "${error:-0}"
}

emerald_search() {
    need_arg "$@"

    NAME_ONLY=0
    PATTERN=""

    while [ -n "$1" ]; do
        case $1 in
            -n | --name) NAME_ONLY=1 ;;

            -*)
                msg_error "Invalid search option: $1"
                return 1
            ;;

            *) PATTERN="$1" ;;
        esac

        shift
    done

    _sr_found=0

    for repo in $PORT_REPO; do
        [ -d "$repo" ] || continue

        _sr_out=$(awk -v pat="$PATTERN" -v nonly="$NAME_ONLY" 'FNR == 1 {
            if ((NR > 1) && matched) printf "%s|%s|%s|%s\n", name, ver, rel, desc;
            name = ver = rel = desc = "";
            matched = 0;
        } /^name=/ {
            sub(/^name=/, "");
            gsub(/"/, "");

            name = $0;
            if (name ~ pat) matched = 1;
        } /^version=/ {
            sub(/^version=/, "");
            gsub(/"/, "");

            ver = $0;
        } /^release=/ {
            sub(/^release=/, "");
            gsub(/"/, "");

            rel = $0;
        } /^description=/ {
            sub(/^description=/, "");
            gsub(/"/, "");

            desc = $0;
            if (!nonly && desc ~ pat) matched = 1;
        } END {
            if (matched) printf "%s|%s|%s|%s\n", name, ver, rel, desc;
        }' "$repo"/*/"$BUILD_SCRIPT" 2>/dev/null | sort)

        [ -n "$_sr_out" ] || continue
        _sr_found=1

        printf '%s\n' "$_sr_out" | while IFS='|' read -r name version release description; do
            emerald_is_installed "$name" && ins=$(printf "[%bi%b]" "$COLOR2" "$CRESET") || ins="[ ]"
            printf "%b %b(%s)%b %b%s%b %b%s-%s%b %s\n" "$ins" "$COLOR5" "${repo##*/}" "$CRESET" "$COLOR2" "$name" "$CRESET" "$COLOR4" "$version" "$release" "$CRESET" "$description"
        done
    done

    [ "$_sr_found" -ne 0 ] || msg_info "No matching package found."
    return 0
}

emerald_sync() {
    portsync "$@"
}

# do_upgrade_install - resolve deps for $1, confirm, install/upgrade set
# and run trigger + summary. Shared by 'emerald_sysup' and 'emerald_upgrade'.
# Args: $1  space separated list of target ports to upgrade/install
# Reads (set by caller): $NO_DEP, $EXOPT, $NOCONFIRM, $OPTS, $failed_upgrades
# Returns: 0 on success, 1 if any package failed (unless keep_going)
do_upgrade_install() {
    targets="$1"
    install_msg="ACTION#PORTNAME#VERSION#INSTALLED"

    UPGPKG=0
    NEWPKG=0

    case "$NO_DEP" in
        1)
            printf "\n"

            for dd in $targets; do
                install_msg="$install_msg upgrade#$dd#$(get_version "$dd")#$(get_iversion "$dd")"

                WILL_INSTALL="$WILL_INSTALL $dd"
                UPGPKG=$(( UPGPKG + 1 ))
            done
        ;;

        *)
            printf "Resolving dependencies...\n\n"
            DEP=$(emerald_deplist "$targets" "$EXOPT" | awk '$1 ~ /^\[/ {print $2;}')

            for d in $DEP; do
                case " $targets " in
                    *" $d "*)
                        install_msg="$install_msg upgrade#$d#$(get_version "$d")#$(get_iversion "$d")"

                        WILL_INSTALL="$WILL_INSTALL $d"
                        UPGPKG=$(( UPGPKG + 1 ))
                    ;;

                    *)
                        if ! emerald_is_installed "$d" && get_port_path "$d" >/dev/null 2>&1; then
                            install_msg="$install_msg install#$d#$(get_version "$d")#$(get_iversion "$d")"

                            WILL_INSTALL="$WILL_INSTALL $d"
                            NEWPKG=$(( NEWPKG + 1 ))
                        fi
                    ;;
                esac
            done
        ;;
    esac

    printf "%s\n" "$install_msg" | tr ' ' '\n' | tr '#' ' ' | column -t
    printf "\n"
    printf "( %s upgrade, %s new install )\n" "$UPGPKG" "$NEWPKG"
    printf "\n"

    if [ "$NOCONFIRM" != 1 ]; then
        confirm "Continue upgrade/install these package(s)?" "Package upgrade cancelled." || exit $?
        printf "\n"
    fi

    error=0
    count=0
    total=$(printf "%s\n" "$WILL_INSTALL" | wc -w)

    for inst in $WILL_INSTALL; do # install all required dependencies and target packages itself
        count=$(( count + 1 ))

        cd "$(get_port_path "$inst")" || return 1
            emerald_is_installed "$inst" || {
                check_conflicts "$inst"
                install_version=$(get_version "$inst")

                hook pre install "$inst" "" "$install_version"
                set_term_title "[ $count/$total ] Installing $inst..."

                pkgbuild -i $OPTS || {
                    error=1

                    if keep_going; then
                        msg_warning "Install failed for '$inst', continuing with next package..."
                        failed_upgrades="$failed_upgrades $inst"

                        cd - >/dev/null || return 1
                        continue
                    fi

                    cd - >/dev/null || return 1
                    break
                }

                hook post install "$inst" "$install_version" "$install_version"
                done_pkg="$done_pkg $inst"

                cd - >/dev/null || return 1
                continue
            }

            current_version=$(get_iversion "$inst")
            upgrade_version=$(get_version "$inst")

            hook pre upgrade "$inst" "$current_version" "$upgrade_version"
            set_term_title "[ $count/$total ] Upgrading $inst..."

            pkgbuild -u $OPTS || {
                error=1

                if keep_going; then
                    msg_warning "Upgrade failed for '$inst', continuing with next package..."
                    failed_upgrades="$failed_upgrades $inst"

                    cd - >/dev/null || return 1
                    continue
                fi

                cd - >/dev/null || return 1
                break
            }

            hook post upgrade "$inst" "$current_version" "$upgrade_version"
            done_pkg="$done_pkg $inst"
        cd - >/dev/null || return 1
    done

    [ -z "$done_pkg" ] || emerald_trigger "$done_pkg"

    # Show error summary if exist
    FAILED_PKGS="$failed_upgrades"
    SKIPPED_PKGS=""

    summary_show "$FAILED_PKGS" "$SKIPPED_PKGS" "upgrade"
    summary_title "$error" "$done_pkg" "$count" "$total" "upgraded"

    return "$error"
}

emerald_sysup() {
    require_root "Upgrading package"
    failed_upgrades=""

    while [ -n "$1" ]; do
        case $1 in
            -i | -u | -r ) ;;

            -o)
                DOWNLOAD_ONLY=1
                OPTS="$OPTS $1"
            ;;

            -y | --yes) NOCONFIRM=1 ;;
            -n) NO_DEP=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            --exclude=*) EXOPT=$1 ;;
            -*) OPTS="$OPTS $1" ;;
        esac

        shift
    done

    printf "Checking for outdated packages...\n"
    PKG_OUTDATE=$(check_outdated)

    # filter out masked (format: name#ivr#pvr#newer_installed#masked)
    for i in $PKG_OUTDATE; do
        case $i in
            *#1) continue ;; # masked: skip, example: 'glib#2.87.0-1#2.88.1-1#1#1'
            *) ii="$ii ${i%%#*}" ;;
        esac
    done

    EXPKG=${EXOPT#*=}

    for i in $ii; do
        # Wrap list and item with commas so first/last entries are always surrounded by delimiters.
        case ",$EXPKG," in
            *",$i,"*) ;;
            *) PKG="$PKG $i" ;;
        esac
    done

    if [ -z "$PKG" ]; then
        printf "All packages are up to date.\n"
        return 0
    fi

    case " $PKG " in
        *" @PROJECT_NAME@ "*)
            printf "\n"
            msg_warning "Please upgrade '@PROJECT_NAME@' first."

            msg_info "Run '@PROJECT_NAME@ upgrade @PROJECT_NAME@' as root."
            return 1
        ;;
    esac

    do_upgrade_install "$PKG"
}

trigger_fc_cache() {
    command -v fc-cache >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/share/fonts/"; then
        msg_info "Updating fontconfig cache..."
        fc-cache -sf
    fi
}

trigger_gdk_pixbuf_cache() {
    command -v gdk-pixbuf-query-loaders >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gdk-pixbuf-2.0/2.10.0/loaders/"; then
        msg_info "Probing GDK-Pixbuf loader modules..."
        gdk-pixbuf-query-loaders --update-cache
    fi
}

trigger_gio_modules() {
    command -v gio-querymodules >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gio/modules/"; then
        msg_info "Updating GIO module cache..."
        gio-querymodules /usr/lib/gio/modules
    fi
}

trigger_glib_schema() {
    command -v glib-compile-schemas >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/share/glib-2.0/schemas/"; then
        msg_info "Compiling GSettings XML schema files..."
        glib-compile-schemas /usr/share/glib-2.0/schemas
    fi
}

trigger_gtk2_immodules() {
    command -v gtk-query-immodules-2.0 >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gtk-2.0/2.10.0/immodules/"; then
        msg_info "Probing GTK2 input method modules..."
        gtk-query-immodules-2.0 --update-cache
    fi
}

trigger_gtk3_immodules() {
    command -v gtk-query-immodules-3.0 >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/lib/gtk-3.0/3.0.0/immodules/"; then
        msg_info "Probing GTK3 input method modules..."
        gtk-query-immodules-3.0 --update-cache
    fi
}

trigger_icon_cache() {
    command -v gtk-update-icon-cache >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/share/icons/"; then
        msg_info "Updating icon theme caches..."

        for dir in /usr/share/icons/*; do
            [ -d "$dir" ] || continue # skip non-directory entries in /usr/share/icons

            if [ -e "$dir/index.theme" ]; then
                gtk-update-icon-cache -q "$dir" 2>/dev/null
                continue
            fi

            rm -f "$dir/icon-theme.cache"
            rmdir "$dir" 2>/dev/null
        done
    fi
}

trigger_udevdb() {
    command -v udevadm >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^etc/udev/hwdb.d/"; then
        msg_info "Updating hardware database..."
        udevadm hwdb --update
    fi
}

trigger_fontcache() {
    command -v mkfontdir >/dev/null || return 0
    command -v mkfontscale >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/share/fonts/"; then
        msg_info "Updating X fontdir indices..."

        find /usr/share/fonts -maxdepth 1 -type d ! -path /usr/share/fonts | while IFS= read -r dir; do
            rm -f "$dir/fonts.scale" "$dir/fonts.dir" "$dir/.uuid"
            rmdir "$dir" 2>/dev/null

            [ -d "$dir" ] || continue

            mkfontdir "$dir"
            mkfontscale "$dir"
        done
    fi
}

trigger_desktop_database() {
    command -v update-desktop-database >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/share/applications/"; then
        msg_info "Updating desktop file MIME type cache..."
        update-desktop-database --quiet
    fi
}

trigger_mime_database() {
    command -v update-mime-database >/dev/null || return 0

    if printf '%s\n' "$PKGFILES" | grep -q "^usr/share/mime/"; then
        msg_info "Updating the MIME type database..."
        update-mime-database /usr/share/mime
    fi
}

emerald_trigger() {
    require_root "Run trigger"

    if [ "$DOWNLOAD_ONLY" != 1 ]; then
        # shellcheck disable=SC2046
        [ "$#" -gt 0 ] || set -- $(all_installed)

        # Read all DB files once in memory
        # shellcheck disable=SC2068
        PKGFILES=$(for _p in $@; do
            cat "$PKGDB_DIR/$_p" 2>/dev/null
        done)

        for t in mime_database desktop_database fontcache fc_cache udevdb icon_cache gtk3_immodules gtk2_immodules glib_schema gio_modules gdk_pixbuf_cache; do
            "trigger_${t}"
        done
    fi
}

emerald_upgrade() {
    require_root "Upgrading package"
    need_arg "${@}"

    failed_upgrades=""

    while [ -n "$1" ]; do
        case $1 in
            -i | -r) ;;
            -y | --yes) NOCONFIRM=1 ;;

            -o)
                DOWNLOAD_ONLY=1
                OPTS="$OPTS $1"
            ;;

            -n) NO_DEP=1 ;;
            -k) KEEP_GOING_LOCAL=1 ;;
            --exclude=*) EXOPT=$1 ;;
            -*) OPTS="$OPTS $1" ;;
            *) PKGNAME="$PKGNAME $1" ;;
        esac

        shift
    done

    for pkg in $PKGNAME; do
        emerald_is_installed "$pkg" || {
            msg_port_not_installed "$pkg"

            if keep_going; then
                failed_upgrades="$failed_upgrades $pkg"
                continue
            fi

            continue
        }

        get_port_path "$pkg" >/dev/null 2>&1 || {
            printf "Package '%s' not exist.\n" "$pkg"

            if keep_going; then
                failed_upgrades="$failed_upgrades $pkg"
                continue
            fi

            continue
        }

        if [ "$(get_iversion "$pkg")" = "$(get_version "$pkg")" ]; then
            printf "Package '%s' is up to date.\n" "$pkg"
            continue
        fi

        upkg="$upkg $pkg"
    done

    [ -n "$upkg" ] || return 0
    do_upgrade_install "$upkg"
}

# Generic flat-file list manager, shared by 'alias' and 'mask' commands.
# Entries are matched/replaced by their first whitespace-separated field only,
# so 'mask' (1 field: "port") and 'alias' (2 fields: "real alias") both work.
# grep -w is NOT used here: '-' is not a word character, so it would fail to
# treat e.g. "foo-bar" as a distinct key from "foo". An explicit anchored ERE
# is used instead for exact first-field matching.
list_show() {
    # $1 = file to list
    awk '!/^[[:space:]]*$/ && !/^#/' "$1"
}

list_add() {
    # $1 = file to update
    # $2.. = fields of the new entry (joined with a space)
    _la_file="$1"
    shift

    _la_entry="$*"
    [ -n "$_la_entry" ] || return 1

    _la_key=$(printf '%s' "$_la_entry" | awk '{print $1;}')
    # drop any existing entry for this key first, so add == "add or update"
    grep -qE "^$_la_key([[:space:]]|$)" "$_la_file" 2>/dev/null && sed -i "/^$_la_key\([[:space:]]\|\$\)/d" "$_la_file"

    printf "%s\n" "$_la_entry" >> "$_la_file"
    sort -u "$_la_file" -o "$_la_file"
}

list_del() {
    # $1 = file to update
    # $2 = key (first field) to remove
    _ld_file="$1"
    _ld_key="$2"

    grep -qE "^$_ld_key([[:space:]]|$)" "$_ld_file" 2>/dev/null || return 1
    sed -i "/^$_ld_key\([[:space:]]\|\$\)/d" "$_ld_file"
}

world_add() {
    grep -qx "$1" "$WORLD_FILE" && return

    emerald_is_installed "$1" || {
        msg_port_not_installed "$1"
        return 1
    }

    printf "%s\n" "$1" >> "$WORLD_FILE"
    sort -u "$WORLD_FILE" -o "$WORLD_FILE" # sort world
}

world_del() {
    grep -qx "$1" "$WORLD_FILE" || return
    sed "/^$1$/d;/^$/d" -i "$WORLD_FILE"
}

emerald_world() {
    if [ -z "$1" ]; then
        if [ -s "$WORLD_FILE" ]; then
            cat "$WORLD_FILE"
            return 0
        fi

        msg_info "world is empty"
        return 0
    fi

    require_root
    touch "$WORLD_FILE"

    while [ -n "$1" ]; do
        grep -qx "$1" "$WORLD_FILE" || {
            world_add "$1" && msg_info "world: '%s' added to world\n" "$1"

            shift
            continue
        }

        msg_info "world: '%s' deleted from world\n" "$1"
        world_del "$1"

        shift
    done
}

emerald_alias() {
    case "$1" in
        list)
            _al_out=$(list_show "$ALIAS_FILE")

            if [ -z "$_al_out" ]; then
                msg_info "No aliased ports found!"
                return 0
            fi

            printf '%s\n' "$_al_out"
        ;;

        add)
            require_root

            if [ -z "$2" ] || [ -z "$3" ]; then
                msg_error "Usage: @PROJECT_NAME@ alias add <real> <alias>"
                return 1
            fi

            list_add "$ALIAS_FILE" "$2" "$3"
            msg_info "alias: '$2' -> '$3' added"
        ;;

        remove)
            require_root

            if [ -z "$2" ]; then
                msg_error "Usage: @PROJECT_NAME@ alias remove <real>"
                return 1
            fi

            list_del "$ALIAS_FILE" "$2" || {
                msg_error "alias: '$2' not found"
                return 1
            }

            msg_info "alias: '$2' removed"
        ;;

        help)
            cat <<'EOF'
Usage:
    @PROJECT_NAME@ alias <command> [args]

Commands:
    list                list aliased ports
    add <real> <alias>  add/update alias: <real> is a dep of <alias> (installed port)
    remove <real>       remove alias for <real>
    help                show this help
EOF
        ;;

        *)
            msg_error "Invalid alias command: $1"
            printf "Run '@PROJECT_NAME@ alias help' to see available options.\n"

            return 1
        ;;
    esac
}

emerald_mask() {
    case "$1" in
        list)
            _ma_out=$(list_show "$MASK_FILE")

            if [ -z "$_ma_out" ]; then
                msg_info "No masked ports found!"
                return 0
            fi

            printf '%s\n' "$_ma_out" | while IFS= read -r _ma_pkg; do
                _ma_ver=$(get_iversion "$_ma_pkg")

                if [ -z "$_ma_ver" ]; then
                    printf '%s\n' "$_ma_pkg"
                    return 0
                fi

                printf '%s == %s\n' "$_ma_pkg" "$_ma_ver"
            done
        ;;

        add)
            require_root
            shift

            if [ -z "$1" ]; then
                msg_error "Usage: @PROJECT_NAME@ mask add <port1> <port2>..."
                return 1
            fi

            for _mk_port in "$@"; do
                list_add "$MASK_FILE" "$_mk_port"
                msg_info "mask: '$_mk_port' added"
            done
        ;;

        remove)
            require_root
            shift

            if [ -z "$1" ]; then
                msg_error "Usage: @PROJECT_NAME@ mask remove <port1> <port2>..."
                return 1
            fi

            for _mk_port in "$@"; do
                list_del "$MASK_FILE" "$_mk_port" || {
                    msg_error "mask: '$_mk_port' not found"
                    continue
                }

                msg_info "mask: '$_mk_port' removed"
            done
        ;;

        help)
            cat <<'EOF'
Usage:
    @PROJECT_NAME@ mask <command> [args]

Commands:
    list            list masked ports (excluded from '@PROJECT_NAME@ sysup')
    add    <ports>  add ports to mask
    remove <ports>  remove ports from mask
    help            show this help
EOF
        ;;

        *)
            msg_error "Invalid mask command: $1"
            printf "Run '@PROJECT_NAME@ mask help' to see available options.\n"

            return 1
        ;;
    esac
}

# check for 'pkgadd', required for package database path
command -v pkgadd >/dev/null 2>&1 || {
    msg_error "'pkgadd' not found in \$PATH!\n"
    exit 1
}

mode="$1"

if [ -z "$mode" ]; then
    printf "Run '%s help' to see available options.\n" "${0##*/}"
    exit 2
fi

func="$(printf '%s' "$mode" | tr '-' '_')"

command -v "emerald_$func" >/dev/null 2>&1 || {
    printf "%s: unknown subcommand '%s'. See '%s help'.\n" "${0##*/}" "$mode" "${0##*/}"
    exit 2
}

shift

for opt in "$@"; do
    case $opt in
        --append-repo=*) APPENDREPO="$APPENDREPO ${opt#*=}" ;;
        --prepend-repo=*) PREPENDREPO="$PREPENDREPO ${opt#*=}" ;;
        --override-repo=*) OVERRIDEREPO="$OVERRIDEREPO ${opt#*=}" ;;
        --repo=*) PORT_REPO="$PORT_REPO ${opt#*=}" ;;
        --repo-file=*) REPO_FILE="${opt#*=}" ;;
        --alias-file=*) ALIAS_FILE="${opt#*=}" ;;
        --config-file=*) CONFIG_FILE="${opt#*=}" ;;
        --mask-file=*) MASK_FILE="${opt#*=}" ;;
        --*) MAINOPTS="$MAINOPTS $opt" ;;

        -[!-]?*)
            _rest=${opt#-}

            while [ -n "$_rest" ]; do
                _chr="${_rest%"${_rest#?}"}"
                MAINOPTS="$MAINOPTS -$_chr"

                _rest=${_rest#?}
            done
        ;;

        *) MAINOPTS="$MAINOPTS $opt" ;;
    esac

    shift
done

if [ -f "$REPO_FILE" ]; then
    # shellcheck disable=SC2013
    for repo_dir in $(awk '!/^[[:space:]]*$/ && !/^#/ {
        print $1;
    }' "$REPO_FILE"); do
        PORT_REPO="$PORT_REPO $repo_dir"
    done
fi

[ -z "$OVERRIDEREPO" ] && PORT_REPO="$PREPENDREPO $PORT_REPO $APPENDREPO" || PORT_REPO="$OVERRIDEREPO"

for f in "${REPO_FILE}" "${ALIAS_FILE}" "${MASK_FILE}" "${CONFIG_FILE}"; do
    [ -f "$f" ] || {
        msg_error "file not found: $f"
        exit 3
    }
done

# check alias port
grep -qEv '^(#|[[:space:]]*$)' "$ALIAS_FILE" 2>/dev/null && ALIAS_PORT="yes" || ALIAS_PORT="no"

# apply emerald.conf
# shellcheck source=@SYSCONFDIR@/emerald.conf
. "${CONFIG_FILE}"

# apply color theme
load_colors

"emerald_$func" $MAINOPTS
exit $?
