#!/bin/sh

# shellcheck disable=SC2317
#
# pkgbuild - Package build utility
# POSIX-compliant shell script for build packages
#

msg_info() {
    printf "==> %s\n" "$1"
}

msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

do_service() {
    for _svc in "$@"; do
        _svc_dir="$SRC/files/services/$_svc"

        [ -d "$_svc_dir" ] || {
            msg_error "Service directory not found: $_svc_dir"
            return 1
        }

        # Install init.d (required)
        if [ -f "$_svc_dir/init.d/$_svc" ]; then
            install -Dm755 "$_svc_dir/init.d/$_svc" "$PKG/etc/init.d/$_svc"
            msg_info "Installed: /etc/init.d/$_svc"
        elif [ -f "$_svc_dir/$_svc.initd" ]; then
            install -Dm755 "$_svc_dir/$_svc.initd" "$PKG/etc/init.d/$_svc"
            msg_info "Installed: /etc/init.d/$_svc"
        else
            msg_error "No init.d found for $_svc"
            return 1
        fi

        # Install conf.d (optional)
        if [ -f "$_svc_dir/conf.d/$_svc" ]; then
            install -Dm644 "$_svc_dir/conf.d/$_svc" "$PKG/etc/conf.d/$_svc"
            msg_info "Installed: /etc/conf.d/$_svc"
        elif [ -f "$_svc_dir/$_svc.confd" ]; then
            install -Dm644 "$_svc_dir/$_svc.confd" "$PKG/etc/conf.d/$_svc"
            msg_info "Installed: /etc/conf.d/$_svc"
        fi
    done
}

do_pam() {
    for _pam in "$@"; do
        _pam_dir="$SRC/files/pam.d"

        [ -d "$_pam_dir" ] || {
            msg_error "PAM directory not found: $_pam_dir"
            return 1
        }

        [ -f "$_pam_dir/$_pam" ] || {
            msg_error "No PAM config found for $_pam"
            return 1
        }

        # Install pam.d config (required)
        install -Dm644 "$_pam_dir/$_pam" -t "$PKG/etc/pam.d/"
        msg_info "Installed: /etc/pam.d/$_pam"
    done
}

do_revdep() {
    _revdep_file="$SRC/files/$name.revdep"

    [ -f "$_revdep_file" ] || {
        msg_error "Revdep file not found: $_revdep_file"
        return 1
    }

    install -d "$PKG/etc/revdep.d"
    envsubst < "$_revdep_file" > "$PKG/etc/revdep.d/$name.conf"

    msg_info "Installed: /etc/revdep.d/$name.conf"
}

parse_git_url() {
    _url="$1"
    _url="${_url#git+}"

    case "$_url" in
        *#*)
            _git_url="${_url%%#*}"
            _fragment="${_url#*#}"

            case "$_fragment" in
                branch=*)
                    _ref_type="branch"
                    _ref="${_fragment#branch=}"
                ;;

                commit=*)
                    _ref_type="commit"
                    _ref="${_fragment#commit=}"
                ;;

                tag=*)
                    _ref_type="tag"
                    _ref="${_fragment#tag=}"
                ;;

                *)
                    _ref_type="auto"
                    _ref="$_fragment"
                ;;
            esac
        ;;

        *)
            _git_url="$_url"
            _ref_type="none"

            _ref=""
        ;;
    esac

    printf '%s\n' "$_git_url"
    printf '%s\n' "$_ref_type"
    printf '%s\n' "$_ref"
}

get_git_dirname() {
    _url="$1"

    _dirname="${_url##*/}"
    _dirname="${_dirname%.git}"

    case "$2" in
        none) printf '%s\n' "$_dirname" ;;
        *) printf '%s-%s\n' "$_dirname" "$3" ;;
    esac
}

is_git_source() {
    case "$1" in
        git+*) return 0 ;;
        *) return 1 ;;
    esac
}

get_filepath() {
    for i in $source; do
        case $i in
            *::*)
                _prefix="${i%::*}"
                _proto="${i#*::}"

                if is_git_source "$_proto"; then
                    printf '%s\n' "$SOURCE_DIR/$_prefix"
                else
                    printf '%s\n' "$SOURCE_DIR/$_prefix"
                fi
            ;;

            git+*)
                set -- $(parse_git_url "$i")
                printf '%s\n' "$SOURCE_DIR/$(get_git_dirname "$1" "$2" "$3")"
            ;;

            *://*) printf '%s\n' "$SOURCE_DIR/${i##*/}" ;;
            *) printf '%s\n' "$PWD/$i" ;;
        esac
    done
}

pkg_gen_checksums() {
    for i in $(get_filepath); do
        if [ -d "$i/.git" ]; then
            continue
        fi

        [ -f "$i" ] || {
            msg_error "File missing: $i"
            abort 1
        }
    done

    generate_checksum > .checksums
    msg_info ".checksums updated"
}

generate_checksum() {
    for s in $(get_filepath); do
        [ -d "$s/.git" ] && continue
        [ -f "$s" ] || continue

        b3sum "$s" | sed -e 's|  .*/|  |'
    done | sort -k 2
}

pkg_checksum() {
    [ -f .checksums ] || {
        pkg_gen_checksums
        return 0
    }

    case "$IGNORE_CHECKSUM" in
        1 | yes) ;;

        *)
            mismatch=0

            TMP_CHECKSUM="$WORK_DIR/checksumstmp.$$"
            DIFF_CHECKSUM="$WORK_DIR/checksumsdiff.$$"

            msg_info "Checking checksums..."
            generate_checksum > "$TMP_CHECKSUM"

            diff -U 0 .checksums "$TMP_CHECKSUM" | sed \
                -e '/---/d;/+++/d;/@@/d' \
                -e 's/^+/ new    : /' \
                -e 's/^-/ missing: /' \
            > "$DIFF_CHECKSUM"

            if [ -s "$DIFF_CHECKSUM" ]; then
                cat "$DIFF_CHECKSUM"
                msg_info "Checksum failed."

                mismatch=1
            fi

            rm -f "$TMP_CHECKSUM" "$DIFF_CHECKSUM"
            [ "$mismatch" -eq 1 ] && abort 1
        ;;
    esac
}

clone_or_update_git() {
    _url="$1"
    _dest="$2"
    _ref_type="$3"
    _ref="$4"

    if [ -d "$_dest/.git" ]; then
        msg_info "Updating git repository: $_dest"
        cd "$_dest" || return 1

        _current_remote=$(git remote get-url origin 2>/dev/null || git config --get remote.origin.url)

        if [ "$_current_remote" != "$_url" ]; then
            msg_info "Remote URL changed, re-cloning..."
            cd - >/dev/null || return 1

            rm -rf "$_dest"
        else
            git fetch --all --tags --prune || {
                msg_error "Failed to fetch updates"
                cd - >/dev/null

                return 1
            }

            case "$_ref_type" in
                none)
                    _latest_tag=$(git describe --tags --abbrev=0 2>/dev/null)

                    if [ -n "$_latest_tag" ]; then
                        msg_info "Checking out latest tag: $_latest_tag"

                        git checkout -f "$_latest_tag" || {
                            msg_error "Failed to checkout tag $_latest_tag"
                            cd - >/dev/null

                            return 1
                        }
                    else
                        git checkout -f FETCH_HEAD || {
                            msg_error "Failed to checkout FETCH_HEAD"
                            cd - >/dev/null

                            return 1
                        }
                    fi
                ;;

                branch)
                    msg_info "Checking out branch: $_ref"

                    git checkout -f -B "$_ref" "origin/$_ref" || {
                        msg_error "Failed to checkout branch $_ref"
                        cd - >/dev/null

                        return 1
                    }

                    git pull --ff-only || true
                ;;

                tag | auto)
                    msg_info "Checking out: $_ref"

                    git checkout -f "$_ref" || {
                        msg_error "Failed to checkout $_ref"
                        cd - >/dev/null

                        return 1
                    }
                ;;

                commit)
                    msg_info "Checking out commit: $_ref"

                    git checkout -f "$_ref" || {
                        msg_error "Failed to checkout commit $_ref"
                        cd - >/dev/null

                        return 1
                    }
                ;;
            esac

            cd - >/dev/null || return 1
            return 0
        fi
    fi

    msg_info "Cloning: $_url"

    git clone "$_url" "$_dest" || {
        msg_error "Failed to clone $_url"
        return 1
    }

    cd "$_dest" || return 1
        case "$_ref_type" in
            branch)
                msg_info "Switching to branch: $_ref"

                git checkout -b "$_ref" "origin/$_ref" 2>/dev/null || git checkout -f "$_ref" || {
                    msg_error "Failed to checkout branch $_ref"
                    cd - >/dev/null

                    return 1
                }
            ;;

            tag | auto)
                msg_info "Checking out: $_ref"

                git checkout -f "$_ref" || {
                    msg_error "Failed to checkout $_ref"
                    cd - >/dev/null

                    return 1
                }
            ;;

            commit)
                msg_info "Checking out commit: $_ref"

                git checkout -f "$_ref" || {
                    msg_error "Failed to checkout commit $_ref"
                    cd - >/dev/null

                    return 1
                }
            ;;
        esac
    cd - >/dev/null || return 1
}

pkg_fetch() {
    for i in $source; do
        COPT=""

        case $i in
            *::*)
                _prefix="${i%::*}"
                _proto="${i#*::}"

                if is_git_source "$_proto"; then
                    filepath="$SOURCE_DIR/$_prefix"
                    set -- $(parse_git_url "$_proto")

                    _git_url="$1"
                    _ref_type="$2"
                    _ref="$3"

                    if [ -d "$filepath/.git" ]; then
                        msg_info "Git repository found: $filepath"
                        _need_update=0

                        if [ "$_ref_type" != "none" ]; then
                            cd "$filepath" || abort 1
                                _current=$(git describe --tags --exact-match 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || git rev-parse --short HEAD)

                                if [ "$_current" != "$_ref" ]; then
                                    _need_update=1
                                fi
                            cd - >/dev/null || abort 1
                        fi

                        [ "$_need_update" -eq 0 ] && continue
                    fi

                    clone_or_update_git "$_git_url" "$filepath" "$_ref_type" "$_ref" || abort 1
                    continue
                fi

                filepath="$SOURCE_DIR/$_prefix"
                url="$_proto"
            ;;

            git+*)
                set -- $(parse_git_url "$i")

                _git_url="$1"
                _ref_type="$2"
                _ref="$3"

                filepath="$SOURCE_DIR/$(get_git_dirname "$_git_url" "$_ref_type" "$_ref")"

                if [ -d "$filepath/.git" ]; then
                    msg_info "Git repository found: $filepath"
                    _need_update=0

                    if [ "$_ref_type" != "none" ]; then
                        cd "$filepath" || abort 1
                            _current=$(git describe --tags --exact-match 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || git rev-parse --short HEAD)

                            if [ "$_current" != "$_ref" ]; then
                                _need_update=1
                            fi
                        cd - >/dev/null || abort 1
                    fi

                    [ "$_need_update" -eq 0 ] && continue
                fi

                clone_or_update_git "$_git_url" "$filepath" "$_ref_type" "$_ref" || abort 1
                continue
            ;;

            *://*)
                filepath="$SOURCE_DIR/${i##*/}"
                url="$i"
            ;;

            *) continue ;;
        esac

        [ -f "$filepath" ] && {
            msg_info "Source found: $filepath"
            continue
        }

        # check partial file
        if [ -f "$filepath.partial" ]; then
            if [ -s "$filepath.partial" ] && [ -r "$filepath.partial" ]; then
                COPT="-C -"
                msg_info "Continuing download: $i"
            else
                msg_info "Removing corrupted partial file"
                rm -f "$filepath.partial"
            fi
        fi

        msg_info "Fetching: $i"

        # shellcheck disable=SC2086
        curl ${COPT} -L --fail --retry 3 --retry-delay 3 -o "$filepath.partial" ${CURL_OPTS} "$url" || {
            msg_error "Fetching failed: $i"
            rm -f "$filepath.partial"

            abort 1
        }

        mv "$filepath.partial" "$filepath"
    done
}

pkg_unpack() {
    SRC="$WORK_DIR/$name/src"
    PKG="$WORK_DIR/$name/pkg"

    umask 022

    rm -rf "$WORK_DIR/$name"
    mkdir -p "$SRC" "$PKG"

    if [ -d "$PWD/files" ]; then
        msg_info "Preparing files directory"

        cp -r "$PWD/files" "$SRC" || {
            msg_error "Failed to copy files directory"
            abort 1
        }
    fi

    for i in $(get_filepath); do
        if [ ! -f "$i" ] && [ ! -d "$i" ]; then
            msg_error "Source missing: $i"
            abort 1
        fi

        if [ -d "$i" ] && [ -d "$i/.git" ]; then
            msg_info "Preparing git source: $i"

            cp -r "$i" "$SRC" || {
                msg_error "Preparing failed: $i"
                abort 1
            }

            continue
        fi

        for n in $noextract; do
            _basename="${i##*/}"

            if [ "$_basename" = "$n" ]; then
                msg_info "Preparing: $i"

                cp --reflink=auto "$i" "$SRC" || {
                    msg_error "Preparing failed: $i"
                    abort 1
                }

                continue 2
            fi
        done

        case "$i" in
            *.tar | *.tar.* | *.tgz | *.tbz2 | *.txz | *.zst | *.zip | *.rpm | *.7z)
                msg_info "Unpacking: $i"
                bsdtar -xpo -C "$SRC" -f "$i" 2>/dev/null || tar --no-same-owner -xpf "$i" -C "$SRC"
            ;;

            *)
                msg_info "Preparing: $i"
                cp --reflink=auto "$i" "$SRC"
            ;;
        esac || {
            msg_error "Unpacking/Preparing failed: $i"
            abort 1
        }
    done
}

pkg_build() {
    [ "$(id -u)" -ne 0 ] && {
        msg_error "You must build package as root, or use fakeroot."
        help

        abort 1
    }

    msg_info "Build start: $name-$version-$release"

    cd "$SRC" >/dev/null || abort 1
        if [ "$QUIET" ]; then
            (set -e; build) 2>/dev/null
        else
            (set -e -x; build 2>&1)
        fi

        if [ $? -ne 0 ]; then
            msg_error "Build failed: $name-$version-$release"
            abort 1
        fi

        msg_info "Build success: $name-$version-$release"
    cd - >/dev/null || return 1
}

pkg_lint() {
    lint_error=0

    # check empty PKG
    find "$PKG" -mindepth 1 -maxdepth 1 2>/dev/null | read -r _ || {
        msg_error "PKG is empty"
        abort 1
    }

    # check for backup file
    for f in $backup; do
        [ -f "$PKG/$f" ] || {
            msg_error "Backup file '$f' does not exist in PKG!"
            lint_error=1
        }
    done

    if [ "$lint_error" -eq 1 ]; then
        abort 1
    fi
}

strip_files() {
    # check skip files
    should_skip() {
        [ -z "$nostrip" ] && return 1

        for pattern in $nostrip; do
            case "$1" in
                *"$pattern"*) return 0 ;;
            esac
        done

        return 1
    }

    find . -type f -printf '%P\n' 2>/dev/null | while read -r binary; do
        should_skip "$binary" && continue

        case "$(file -bi "$binary")" in
            # Libraries (.so) | PIE executables
            *application/x-sharedlib* | *application/x-pie-executable*) "${CROSS_COMPILE}strip" --strip-unneeded "$binary" 2>/dev/null ;;

            # Libraries (.a)
            *application/x-archive*) "${CROSS_COMPILE}strip" --strip-debug "$binary" 2>/dev/null ;;

            *application/x-object*)
                case "$binary" in
                    # Kernel module
                    *.ko) "${CROSS_COMPILE}strip" --strip-unneeded "$binary" 2>/dev/null ;;
                    *) continue ;;
                esac
            ;;

            # Binaries
            *application/x-executable*) "${CROSS_COMPILE}strip" --strip-all "$binary" 2>/dev/null ;;
            *) continue ;;
        esac
    done
}

compress_info_man_pages() {
    find . -type f -path "*/share/man/*" | while read -r file; do
        if [ "$file" = "${file%%.gz}" ]; then
            gzip -9 -f "$file"
        fi
    done

    find . -type l -path "*/share/man/*" | while read -r file; do
        FILE="${file%%.gz}.gz"

        TARGET="$(readlink "$file")"
        TARGET="${TARGET##*/}"
        TARGET="${TARGET%%.gz}.gz"

        DIR="${FILE%/*}"
        rm -f "$file"

        if [ -e "$DIR/$TARGET" ]; then
            ln -sf "$TARGET" "$FILE"
        fi
    done

    find . -type f -path "*/share/info/*" | while read -r file; do
        if [ "$file" = "${file%%.gz}" ]; then
            gzip -9 -f "$file"
        fi
    done
}

pkg_package() {
    # lint $PKG before packaging
    pkg_lint

    cd "$PKG" >/dev/null || abort 1
        # remove possible conflict junks
        rm -f usr/share/info/dir usr/info/dir
        rm -f usr/lib/charset.alias # on musl system

        rm -rf usr/lib/systemd usr/lib/sysusers.d usr/lib/tmpfiles.d
        rm -rf usr/share/licenses usr/lib/python3.*/site-packages/*.dist-info/licenses

        find . \( -name perllocal.pod -o -name .packlist \) -delete
        [ -d usr/share/fonts ] && find usr/share/fonts \( -name fonts.dir -o -name fonts.scale \) -delete

        case "$KEEP_LIBTOOL" in
            0 | no) find . ! -type d -name "*.la" -delete ;;
        esac

        case "$KEEP_LOCALE" in
            0 | no) rm -fr usr/share/locale usr/locale usr/lib/locale ;;
        esac

        case "$KEEP_DOC" in
            0 | no) rm -fr usr/share/doc usr/share/gtk-doc usr/doc usr/gtk-doc ;;
        esac

        case "$KEEP_MAN" in
            0 | no) rm -fr usr/man usr/share/man ;;
        esac

        case "$NO_STRIP" in
            0 | no) strip_files ;;
        esac

        compress_info_man_pages

        for FILE in $backup; do
            mv "$FILE" "$FILE.epkgnew"
        done

        [ "$FORCE_REBUILD" ] && rm -f "$PACKAGE_DIR/$PKGNAME"

        case "$COMPRESSION_MODE" in
            xz) COMPRESS="xz -T0" ;;
            gz) COMPRESS="gzip -9" ;;
            bz2) COMPRESS="bz2" ;;
            lz4) COMPRESS="lz4" ;;
            zstd) COMPRESS="zstd -19 -T0" ;;
        esac

        # shellcheck disable=SC2035
        tar -c -I "$COMPRESS" -f "$PACKAGE_DIR/$PKGNAME" * || {
            rm -f "$PACKAGE_DIR/$PKGNAME"
            msg_error "Packaging failed: $PKGNAME"

            abort 1
        }

        # Capture listing once; reuse for display and pkgfiles (avoids re-reading the archive)
        _tar_list=$(tar -tvf "$PACKAGE_DIR/$PKGNAME")
        printf '%s\n' "$_tar_list" | sort -k 6

        msg_info "Packaging success: $PKGNAME ($(ls -lh "$PACKAGE_DIR/$PKGNAME" | awk '{print $5}'))"
    cd - >/dev/null || return 1

    if [ ! -f .pkgfiles ] || [ "$(head -n1 .pkgfiles)" != "$name-$version-$release" ]; then
        pkg_gen_pkgfiles "$_tar_list"
    fi
}

pkg_gen_pkgfiles() {
    [ -f "$PACKAGE_DIR/$PKGNAME" ] || {
        msg_error "Package not found: $PKGNAME"
        exit 1
    }

    printf '%s\n' "$name-$version-$release" > .pkgfiles

    # If a pre-captured listing is passed as $1, use it; otherwise read the archive
    if [ -n "$1" ]; then
        printf '%s\n' "$1"
    else
        tar -tvf "$PACKAGE_DIR/$PKGNAME"
    fi | awk '{
        $3 = $4 = $5 = "";
        print $0;
    }' | sort -k 3 >> .pkgfiles

    msg_info ".pkgfiles updated"
}

pkg_clean() {
    [ -e "$PACKAGE_DIR/$PKGNAME" ] && {
        rm -f "$PACKAGE_DIR/$PKGNAME"
        msg_info "Package removed: $PACKAGE_DIR/$PKGNAME"
    }

    for i in $(get_filepath); do
        case $i in
            "$PWD"/*) continue ;;
        esac

        if [ -d "$i/.git" ]; then
            rm -rf "$i"
            msg_info "Repository removed: $i"

            continue
        fi

        [ -e "$i" ] && {
            rm -f "$i"
            msg_info "File removed: $i"
        }

        [ -e "$i.partial" ] && {
            rm -f "$i.partial"
            msg_info "File removed: $i.partial"
        }
    done
}

check_buildscript() {
    # check the required field in buildscript
    [ "$name" ] || {
        msg_error "'name' is empty!"
        exit 1
    }

    case "$name" in
        *[A-Z]*)
            msg_error "Capital letters for port name are not allowed!"
            exit 1
        ;;
    esac

    [ "${PWD##*/}" = "$name" ] || {
        msg_error "Port name and Directory name is different!"
        exit 1
    }

    [ "$version" ] || {
        msg_error "'version' is empty!"
        exit 1
    }

    [ "$release" ] || {
        msg_error "'release' is empty!"
        exit 1
    }

    case "$release" in
        *[A-Z]* | *[a-z]* | *-* | *\.* | *_*)
            msg_error "only numeric allowed in 'release'"
            exit 1
        ;;
    esac

    command -v build >/dev/null 2>&1 || {
        msg_error "'build' function not exist!"
        exit 1
    }

    case "$version" in
        *-*)
            msg_error "'version' should not contain '-'."
            exit 1
        ;;
    esac

    if [ "$release" -gt 99 ] || [ "$release" -lt 1 ]; then
        msg_error "'release' should numeric between 1 to 99"
        exit 1
    fi

    [ "$description" ] || {
        msg_error "'description' is empty!"
        exit 1
    }
}

check_dir() {
    for DIR in "$@"; do
        if [ ! -d "$DIR" ]; then
            msg_error "Directory '$DIR' does not exist."
            exit 1
        elif [ ! -w "$DIR" ]; then
            msg_error "Directory '$DIR' not writable."
            exit 1
        elif [ ! -x "$DIR" ] || [ ! -r "$DIR" ]; then
            msg_error "Directory '$DIR' not readable."
            exit 1
        fi
    done
}

# cbuild - custom build option
cbuild_restore() {
    _rs_dest="$1"
    _rs_cfg="$CBUILD_DIR/${2:-$name}.cfg"

    [ -n "$_rs_dest" ] || {
        msg_error "cbuild_restore: destination path required"
        return 1
    }

    [ -f "$_rs_cfg" ] || return 1

    cp "$_rs_cfg" "$_rs_dest" || {
        msg_error "cbuild_restore: failed to copy to '$_rs_dest'"
        return 1
    }

    return 0
}

cbuild_save() {
    _sv_src="$1"
    _sv_cfg="$CBUILD_DIR/${2:-$name}.cfg"

    [ -n "$_sv_src" ] || {
        msg_error "cbuild_save: source path required"
        return 1
    }

    [ -f "$_sv_src" ] || {
        msg_error "cbuild_save: '$_sv_src' not found"
        return 1
    }

    cp "$_sv_src" "$_sv_cfg" || {
        msg_error "cbuild_save: failed to write '$_sv_cfg'"
        return 1
    }
}

cbuild_options() {
    _op_cfg="$CBUILD_DIR/${1:-$name}.opt"

    if [ -f "$_op_cfg" ]; then
        # shellcheck source=$_op_cfg
        . "$_op_cfg"
    fi
}

pkg_cleanup() {
    if [ ! "$KEEP_WORK" ] && [ "$name" ]; then
        # shellcheck disable=SC2115
        rm -rf "$WORK_DIR/$name"
    fi
}

interrupted() {
    printf '\n'
    abort 100
}

abort() {
    rm -f "$LOCK_FILE"
    pkg_cleanup

    exit "$1"
}

parse_opts() {
    while [ "$1" ]; do
        case $1 in
            -[!-]?*)
                _rest=${1#-}
                shift

                while [ -n "$_rest" ]; do
                    _chr="${_rest%"${_rest#?}"}"
                    set -- "-$_chr" "$@"

                    _rest=${_rest#?}
                done

                continue
            ;;
        esac

        case "$1" in
            -q | --quiet) QUIET=yes ;;
            -i | --install) INSTALL_PKG=yes ;;

            -u | --upgrade)
                UPGRADE_PKG=yes
                OPTS="$OPTS $1"
            ;;

            -r | --reinstall)
                REINSTALL_PKG=yes
                OPTS="$OPTS $1"
            ;;

            -c | --ignore-conflict) OPTS="$OPTS $1" ;;
            -v | --verbose) OPTS="$OPTS $1" ;;
            -f | --force-rebuild) FORCE_REBUILD=yes ;;
            -m | --skip-checksum) IGNORE_CHECKSUM=yes ;;
            -g | --genchecksum) UPDATE_CHECKSUM=yes ;;
            -o | --download) DOWNLOAD_ONLY=yes ;;
            -x | --extract) EXTRACT_ONLY=yes ;;
            -w | --keep-work) KEEP_WORK=yes ;;
            -p | --pkgfiles) GEN_PKGFILES=yes ;;
            -h | --help) SHOW_HELP=yes ;;
            -C | --clean) CLEANUP=yes ;;
            --no-backup) OPTS="$OPTS $1" ;;
            --root=*) OPTS="$OPTS $1" ;;
            --config=*) PKGBUILD_CONF="${1#*=}" ;;
            --srcdir=*) CUSTOM_SOURCE_DIR="${1#*=}" ;;
            --pkgdir=*) CUSTOM_PACKAGE_DIR="${1#*=}" ;;
            --workdir=*) CUSTOM_WORK_DIR="${1#*=}" ;;

            *)
                msg_info "Invalid ${0##*/} option! ($1)"
                exit 1
            ;;
        esac

        shift
    done
}

help() {
    cat <<'EOF'
Usage:
    pkgbuild <options> [<arg>]

Options:
    -q  --quiet            show only status messages and errors
    -i, --install          install package into system
    -u, --upgrade          upgrade package
    -r, --reinstall        reinstall package
    -c, --ignore-conflict  ignore conflict when installing package
    -v, --verbose          verbose install process
    -f, --force-rebuild    rebuild package
    -m, --skip-checksum    skip checksum checking
    -g, --genchecksum      generate checksum
    -o, --download         download only source file
    -x, --extract          extract only source file
    -p, --pkgfiles         generate list files in package
    -w, --keep-work        keep working directory
    -h, --help             show this help message
    -C, --clean            remove downloaded sources and prebuilt packages

Global options:
    --config=<config>      use custom config file
    --srcdir=<path>        override directory path for sources
    --pkgdir=<path>        override directory path for compiled package
    --workdir=<path>       override directory path for working dir
    --no-backup            skip backup configuration file when upgrading package
EOF
}

main() {
    parse_opts "$@"

    [ -f "$PKGBUILD_CONF" ] || {
        msg_error "Config file not found: $PKGBUILD_CONF"
        exit 1
    }

    # shellcheck source=@SYSCONFDIR@/emerald.conf
    . "$PKGBUILD_CONF"

    [ "$CUSTOM_SOURCE_DIR" ] && SOURCE_DIR="$CUSTOM_SOURCE_DIR"
    [ "$CUSTOM_PACKAGE_DIR" ] && PACKAGE_DIR="$CUSTOM_PACKAGE_DIR"
    [ "$CUSTOM_WORK_DIR" ] && WORK_DIR="$CUSTOM_WORK_DIR"

    # Ensure cbuild directory exists; non-fatal if it cannot be created
    [ -d "$CBUILD_DIR" ] || mkdir -p "$CBUILD_DIR" 2>/dev/null

    check_dir "$SOURCE_DIR" "$PACKAGE_DIR" "$WORK_DIR"

    # show usage
    [ "$SHOW_HELP" ] && {
        help
        exit 0
    }

    [ -f "$PKGBUILD_BSCRIPT" ] || {
        msg_error "'$PKGBUILD_BSCRIPT' file not found."
        exit 1
    }

    # shellcheck source=$PKGBUILD_BSCRIPT
    . ./"$PKGBUILD_BSCRIPT"
    check_buildscript

    case "$COMPRESSION_MODE" in
        gz | bz2 | xz | lz4 | zstd) PKGNAME="$name-$version-$release.epkg.tar.$COMPRESSION_MODE" ;;

        *)
            msg_error "Invalid compression mode: $COMPRESSION_MODE"
            exit 1
        ;;
    esac

    # generate .pkgfiles
    [ "$GEN_PKGFILES" ] && {
        pkg_gen_pkgfiles
        exit 0
    }

    # download source only
    [ "$DOWNLOAD_ONLY" ] && {
        pkg_fetch
        exit 0
    }

    # extract source only
    [ "$EXTRACT_ONLY" ] && {
        pkg_unpack
        exit 0
    }

    # update checksum
    [ "$UPDATE_CHECKSUM" ] && {
        pkg_gen_checksums
        exit 0
    }

    # remove source and package
    [ "$CLEANUP" ] && {
        pkg_clean
        exit 0
    }

    LOCK_FILE="/tmp/pkgbuild.$name.lock"

    # check for lock file
    [ -f "$LOCK_FILE" ] && {
        msg_error "Cannot build same package simultaneously."
        msg_error "remove '$LOCK_FILE' if no build process for '$name'."

        exit 1
    }

    # create lock file
    touch "$LOCK_FILE" 2>/dev/null || {
        msg_error "Cannot create lock file in '$LOCK_FILE'."
        exit 1
    }

    # build package
    if [ -f "$PACKAGE_DIR/$PKGNAME" ] && [ ! "$FORCE_REBUILD" ]; then
        if [ ! "$INSTALL_PKG" ] && [ ! "$REINSTALL_PKG" ] && [ ! "$UPGRADE_PKG" ]; then
            msg_info "Package is up-to-date: $PKGNAME"
            abort 0
        fi
    else
        msg_info "Building: $name-$version-$release"

        if [ "$QUIET" ]; then
            pkg_fetch 2>/dev/null
            pkg_checksum >/dev/null
            pkg_unpack >/dev/null
            pkg_build >/dev/null
            pkg_package >/dev/null
            pkg_cleanup
        else
            pkg_fetch
            pkg_checksum
            pkg_unpack
            pkg_build
            pkg_package
            pkg_cleanup
        fi
    fi

    # install package
    if [ "$INSTALL_PKG" ] || [ "$REINSTALL_PKG" ] || [ "$UPGRADE_PKG" ]; then
        pkgadd "$PACKAGE_DIR/$PKGNAME" $OPTS || abort 1
    fi

    abort 0
}

trap "interrupted" 1 2 3 15
export LC_ALL=C

PKGBUILD_CONF="@SYSCONFDIR@/emerald.conf"
PKGBUILD_BSCRIPT="@BUILD_SCRIPT@"

SOURCE_DIR="@CACHE_DIR@/sources"
PACKAGE_DIR="@CACHE_DIR@/packages"
WORK_DIR="@CACHE_DIR@/work"
CBUILD_DIR="@STATE_DIR@/cbuild"
CURL_OPTS=""
COMPRESSION_MODE="xz"
NO_STRIP="no"
IGNORE_CHECKSUM="no"
KEEP_LIBTOOL="no"
KEEP_LOCALE="no"
KEEP_DOC="no"
KEEP_MAN="no"

main "$@"
