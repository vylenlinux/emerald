#!/bin/sh

# shellcheck disable=SC2317
#
# pkgbuild - Package build utility
# POSIX-compliant shell script for build packages
#

msg_info() {
    printf "==> %s\n" "$1"
}

msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

do_service() {
    _scope=system

    case "$1" in
        system | user)
            _scope="$1"
            shift
        ;;
    esac

    _service_dir="/usr/lib/systemd/$_scope"

    for _svc in "$@"; do
        _svc_dir="$SRC/files/services/$_svc"

        [ -d "$_svc_dir" ] || {
            msg_error "Service directory not found: $_svc_dir"
            exit 1
        }

        found=0

        if [ -f "$_svc_dir/$_svc.service" ]; then
            install -Dm644 "$_svc_dir/$_svc.service" -t "$PKG/$_service_dir/"
            msg_info "Installed: $_service_dir/$_svc.service"

            found=1
        fi

        if [ -f "$_svc_dir/$_svc@.service" ]; then
            install -Dm644 "$_svc_dir/$_svc@.service" -t "$PKG/$_service_dir/"
            msg_info "Installed: $_service_dir/$_svc@.service"

            found=1
        fi

        if [ "$found" -eq 0 ]; then
            msg_error "No systemd service found for $_svc"
            exit 1
        fi

        if [ -f "$_svc_dir/$_svc.socket" ]; then
            install -Dm644 "$_svc_dir/$_svc.socket" -t "$PKG/$_service_dir/"
            msg_info "Installed: $_service_dir/$_svc.socket"
        fi

        if [ -f "$_svc_dir/$_svc.path" ]; then
            install -Dm644 "$_svc_dir/$_svc.path" -t "$PKG/$_service_dir/"
            msg_info "Installed: $_service_dir/$_svc.path"
        fi

        if [ -f "$_svc_dir/$_svc.timer" ]; then
            install -Dm644 "$_svc_dir/$_svc.timer" -t "$PKG/$_service_dir/"
            msg_info "Installed: $_service_dir/$_svc.timer"
        fi

        if [ -f "$_svc_dir/$_svc@.timer" ]; then
            install -Dm644 "$_svc_dir/$_svc@.timer" -t "$PKG/$_service_dir/"
            msg_info "Installed: $_service_dir/$_svc@.timer"
        fi
    done
}

do_sysusers() {
    for _name in "$@"; do
        _file="$_name.conf"

        [ -f "$SRC/files/sysusers/$_file" ] || {
            msg_error "sysusers file not found: $_file"
            exit 1
        }

        install -Dm644 "$SRC/files/sysusers/$_file" -t "$PKG/usr/lib/sysusers.d/"
        msg_info "Installed: /usr/lib/sysusers.d/$_file"
    done
}

do_tmpfiles() {
    for _name in "$@"; do
        _file="$_name.conf"

        [ -f "$SRC/files/tmpfiles/$_file" ] || {
            msg_error "tmpfiles file not found: $_file"
            exit 1
        }

        install -Dm644 "$SRC/files/tmpfiles/$_file" -t "$PKG/usr/lib/tmpfiles.d/"
        msg_info "Installed: /usr/lib/tmpfiles.d/$_file"
    done
}

do_udev_rules() {
    for _name in "$@"; do
        _file="$_name.rules"

        [ -f "$SRC/files/udev/$_file" ] || {
            msg_error "udev rules file not found: $_file"
            exit 1
        }

        install -Dm644 "$SRC/files/udev/$_file" -t "$PKG/usr/lib/udev/rules.d/"
        msg_info "Installed: /usr/lib/udev/rules.d/$_file"
    done
}

do_systemd_scripts() {
    for _name in "$@"; do
        [ -f "$SRC/files/systemd/scripts/$_name" ] || {
            msg_error "systemd script not found: $_name"
            exit 1
        }

        install -Dm755 "$SRC/files/systemd/scripts/$_name" -t "$PKG/usr/lib/systemd/scripts/"
        msg_info "Installed: /usr/lib/systemd/scripts/$_name"
    done
}

do_systemd_system_eg() {
    for _name in "$@"; do
        [ -f "$SRC/files/systemd/system-eg/$_name" ] || {
            msg_error "systemd environment generator not found: $_name"
            exit 1
        }

        install -Dm755 "$SRC/files/systemd/system-eg/$_name" -t "$PKG/usr/lib/systemd/system-environment-generators/"
        msg_info "Installed: /usr/lib/systemd/system-environment-generators/$_name"
    done
}

do_systemd_system_preset() {
    for _name in "$@"; do
        _file="$_name.preset"

        [ -f "$SRC/files/systemd/system-preset/$_file" ] || {
            msg_error "systemd system preset not found: $_name"
            exit 1
        }

        install -Dm755 "$SRC/files/systemd/system-preset/$_file" -t "$PKG/usr/lib/systemd/system-preset/"
        msg_info "Installed: /usr/lib/systemd/system-preset/$_file"
    done
}

do_pam() {
    for _pam in "$@"; do
        _pam_dir="$SRC/files/pam.d"

        [ -d "$_pam_dir" ] || {
            msg_error "PAM directory not found: $_pam_dir"
            exit 1
        }

        [ -f "$_pam_dir/$_pam" ] || {
            msg_error "No PAM config found for $_pam"
            exit 1
        }

        # Install pam.d config (required)
        install -Dm644 "$_pam_dir/$_pam" -t "$PKG/usr/lib/pam.d/"
        msg_info "Installed: /usr/lib/pam.d/$_pam"
    done
}

do_revdep() {
    _revdep_file="$SRC/files/$name.revdep"

    [ -f "$_revdep_file" ] || {
        msg_error "Revdep file not found: $_revdep_file"
        exit 1
    }

    install -d "$PKG/usr/lib/revdep.d"
    envsubst < "$_revdep_file" > "$PKG/usr/lib/revdep.d/$name.conf"

    msg_info "Installed: /usr/lib/revdep.d/$name.conf"
}

get_filepath() {
    for i in $source; do
        case $i in
            *::*) printf '%s\n' "$SOURCE_DIR/${i%::*}" ;;
            *://*) printf '%s\n' "$SOURCE_DIR/${i##*/}" ;;
            *) printf '%s\n' "$PWD/$i" ;;
        esac
    done
}

pkg_gen_checksums() {
    for i in $(get_filepath); do
        [ -f "$i" ] || {
            msg_error "File missing: $i"
            abort 1
        }
    done

    generate_checksum > "${CHECKSUMS_FILE}" || {
        msg_error "Failed to write ${CHECKSUMS_FILE}"
        abort 1
    }

    msg_info "${CHECKSUMS_FILE} updated"
}

generate_checksum() {
    for s in $(get_filepath); do
        [ -f "$s" ] || continue
        b3sum "$s" | sed -e 's|  .*/|  |'
    done | sort -k 2
}

pkg_checksum() {
    [ -f "${CHECKSUMS_FILE}" ] || {
        pkg_gen_checksums
        return 0
    }

    case "$IGNORE_CHECKSUM" in
        1 | yes) ;;

        *)
            mismatch=0

            TMP_CHECKSUM="$WORK_DIR/checksums_tmp.$$"
            DIFF_CHECKSUM="$WORK_DIR/checksums_diff.$$"

            msg_info "Checking checksums..."

            generate_checksum > "$TMP_CHECKSUM" || {
                msg_error "Failed to write temporary checksum file: $TMP_CHECKSUM"
                rm -f "$TMP_CHECKSUM" "$DIFF_CHECKSUM"

                abort 1
            }

            diff -U 0 "${CHECKSUMS_FILE}" "$TMP_CHECKSUM" | sed \
                -e '/---/d;/+++/d;/@@/d' \
                -e 's/^+/ new    : /' \
                -e 's/^-/ missing: /' \
            > "$DIFF_CHECKSUM" || {
                msg_error "Failed to write checksum diff file: $DIFF_CHECKSUM"
                rm -f "$TMP_CHECKSUM" "$DIFF_CHECKSUM"

                abort 1
            }

            if [ -s "$DIFF_CHECKSUM" ]; then
                cat "$DIFF_CHECKSUM"
                msg_info "Checksum failed."

                mismatch=1
            fi

            rm -f "$TMP_CHECKSUM" "$DIFF_CHECKSUM"
            [ "$mismatch" -eq 1 ] && abort 1
        ;;
    esac
}

pkg_check_partial() {
    filepath="$1"
    [ -f "$filepath.partial" ] || return 0

    if [ -s "$filepath.partial" ] && [ -r "$filepath.partial" ]; then
        msg_info "Continuing download: $2"
        return 1
    fi

    msg_info "Removing corrupted partial file"
    rm -f "$filepath.partial"

    return 0
}

pkg_fetch() {
    for i in $source; do
        COPT=""

        case $i in
            *::*)
                filepath="$SOURCE_DIR/${i%::*}"
                url="${i#*::}"
            ;;

            *://*)
                filepath="$SOURCE_DIR/${i##*/}"
                url="$i"
            ;;

            *) continue ;;
        esac

        if [ -f "$filepath" ]; then
            msg_info "Source found: $filepath"
            continue
        fi

        # check partial file
        pkg_check_partial "$filepath" "$i" || COPT="-C -"

        msg_info "Fetching: $i"
        [ "$QUIET" != "yes" ] || _curl_quiet="--silent"

        # shellcheck disable=SC2086
        curl ${COPT} ${_curl_quiet} -L --fail --retry 3 --retry-delay 3 -o "$filepath.partial" ${CURL_OPTS} "$url" || {
            msg_error "Fetching failed: $i"
            rm -f "$filepath.partial"

            abort 1
        }

        mv "$filepath.partial" "$filepath" || {
            msg_error "Failed to move downloaded file: $filepath"
            rm -f "$filepath.partial"

            abort 1
        }
    done
}

pkg_unpack() {
    SRC="$WORK_DIR/$name/src"
    PKG="$WORK_DIR/$name/pkg"

    umask 022

    # shellcheck disable=SC2115
    rm -rf "$WORK_DIR/$name"
    mkdir -p "$SRC" "$PKG"

    if [ -d "$PWD/files" ]; then
        msg_info "Preparing files directory"

        cp -r "$PWD/files" "$SRC" || {
            msg_error "Failed to copy files directory"
            abort 1
        }

        # shellcheck disable=SC2034
        FILES="$WORK_DIR/$name/src/files"
    fi

    for i in $(get_filepath); do
        [ -f "$i" ] || {
            msg_error "Source missing: $i"
            abort 1
        }

        for n in $noextract; do
            if [ "${i##*/}" = "$n" ]; then
                msg_info "Preparing: $i"

                cp --reflink=auto "$i" "$SRC" || {
                    msg_error "Preparing failed: $i"
                    abort 1
                }

                continue 2
            fi
        done

        case "$i" in
            *.tar | *.tar.* | *.tgz | *.tbz2 | *.txz | *.zst | *.zip | *.rpm | *.7z)
                msg_info "Unpacking: $i"
                tar --no-same-owner -xpf "$i" -C "$SRC" 2>/dev/null || bsdtar -xpo -C "$SRC" -f "$i" 2>/dev/null
            ;;

            *)
                msg_info "Preparing: $i"
                cp --reflink=auto "$i" "$SRC"
            ;;
        esac || {
            msg_error "Unpacking/Preparing failed: $i"
            abort 1
        }
    done
}

pkg_build() {
    if [ "$(id -u)" -ne 0 ]; then
        msg_error "You must build package as root, or use fakeroot."
        help

        abort 1
    fi

    msg_info "Build start: $name-$version-$release"

    cd "$SRC" >/dev/null || abort 1
        mkdir -p "${SRC}/.cache/cargo" \
            "${SRC}/.cache/go" \
            "${SRC}/.cache/zig" \
            "${SRC}/.cache/npm"

        export CARGO_HOME="${CARGO_HOME:-"${SRC}/.cache/cargo"}"
        export GOCACHE="${GOCACHE:-"${SRC}/.cache/go"}"
        export GOMODCACHE="${GOMODCACHE:-"${SRC}/.cache/go"}"
        export GOTMPDIR="${GOTMPDIR:-"${SRC}/.cache/go"}"
        export GOPATH="${GOPATH:-"${SRC}"}"
        export MESON_PACKAGE_CACHE_DIR="${SRC}"
        export ZIG_LOCAL_CACHE_DIR="${SRC}/.cache/zig"
        export ZIG_GLOBAL_CACHE_DIR="${SRC}/.cache/zig"
        export npm_config_cache="${SRC}/.cache/npm"

        export CGO_LDFLAGS="${LDFLAGS}"
        export CGO_CFLAGS="${CFLAGS}"
        export CGO_CPPFLAGS="${CPPFLAGS}"
        export CGO_CXXFLAGS="${CXXFLAGS}"

        export XML_CATALOG_FILES=/etc/xml/catalog
        export PYTHON=/usr/bin/python3
        export PYTHON_VERSION=3
        export PYTHON_VERSIONS=python3
        export INSTALLDIRS=vendor
        export PERL_INSTALLDIRS=vendor
        export PERL_MM_USE_DEFAULT=1

        PYTHON_SITE_PACKAGES="$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"));')"
        PYTHON_PVERSION="$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:2])));')"
        PERL_SITE_PERL="$(perl -MConfig -e 'print $Config {sitearchexp};')"

        export PYTHON_SITE_PACKAGES
        export PYTHON_PVERSION
        export PERL_SITE_PERL

        if [ "$QUIET" = "yes" ]; then
            (
                set -e
                command -v prepare >/dev/null 2>&1 && prepare

                build
            ) >/dev/null 2>&1
        else
            (
                set -e -x
                command -v prepare >/dev/null 2>&1 && prepare

                build
            ) 2>&1
        fi || {
            msg_error "Build failed: $name-$version-$release"
            abort 1
        }

        msg_info "Build success: $name-$version-$release"
    cd - >/dev/null || return 1
}

pkg_lint() {
    lint_error=0

    # check empty PKG
    find "$PKG" -mindepth 1 -maxdepth 1 2>/dev/null | read -r _ || {
        msg_error "PKG is empty"
        abort 1
    }

    # check for backup file
    for f in $backup; do
        [ -f "$PKG/$f" ] || {
            msg_error "Backup file '$f' does not exist in PKG!"
            lint_error=1
        }
    done

    if [ "$lint_error" -eq 1 ]; then
        abort 1
    fi
}

strip_files() {
    # nostrip uses EREs, so match with grep -E.
    # Build the pattern once to avoid extra grep calls when $nostrip is unset.
    if [ -n "$nostrip" ]; then
        nostrip_ere=""

        for _np in $nostrip; do
            nostrip_ere="${nostrip_ere:+$nostrip_ere|}$_np"
        done
    fi

    should_skip() {
        [ -z "$nostrip" ] && return 1
        printf '%s\n' "$1" | grep -Eq "$nostrip_ere"
    }

    find . -type f -printf '%P\n' 2>/dev/null | while read -r binary; do
        should_skip "$binary" && continue

        case "$(file -bi "$binary")" in
            # Libraries (.so) | PIE executables
            *application/x-sharedlib* | *application/x-pie-executable*) "${CROSS_COMPILE}strip" --strip-unneeded "$binary" 2>/dev/null ;;

            # Libraries (.a)
            *application/x-archive*) "${CROSS_COMPILE}strip" --strip-debug "$binary" 2>/dev/null ;;

            *application/x-object*)
                case "$binary" in
                    # Kernel module
                    *.ko) "${CROSS_COMPILE}strip" --strip-unneeded "$binary" 2>/dev/null ;;
                    *) continue ;;
                esac
            ;;

            # Binaries
            *application/x-executable*) "${CROSS_COMPILE}strip" --strip-all "$binary" 2>/dev/null ;;
            *) continue ;;
        esac
    done
}

compress_info_man_pages() {
    find . -type f \( \
        -path "*/share/man/*" -o \
        -path "*/share/info/*" \
    \) | while read -r file; do
        if [ "$file" = "${file%%.gz}" ]; then
            gzip -9 -f "$file"
        fi
    done

    find . -type l -path "*/share/man/*" | while read -r file; do
        FILE="${file%%.gz}.gz"

        TARGET="$(readlink "$file")"
        TARGET="${TARGET##*/}"
        TARGET="${TARGET%%.gz}.gz"

        DIR="${FILE%/*}"
        rm -f "$file"

        if [ -e "$DIR/$TARGET" ]; then
            ln -sf "$TARGET" "$FILE"
        fi
    done
}

pkg_package() {
    # lint $PKG before packaging
    pkg_lint

    cd "$PKG" >/dev/null || abort 1
        # remove possible conflict junks
        rm -f usr/share/info/dir usr/info/dir
        rm -f usr/lib/charset.alias # on musl system

        rm -rf usr/share/licenses usr/lib/python3.*/site-packages/*.dist-info/licenses

        find . \( \
            -name perllocal.pod -o \
            -name .packlist \
        \) -delete

        [ -d usr/share/fonts ] && find usr/share/fonts \( \
            -name fonts.dir -o \
            -name fonts.scale \
        \) -delete

        case "$KEEP_LIBTOOL" in
            0 | no) find . ! -type d -name "*.la" -delete ;;
        esac

        case "$KEEP_LOCALE" in
            0 | no) rm -rf usr/share/locale usr/locale usr/lib/locale ;;
        esac

        case "$KEEP_DOC" in
            0 | no) rm -rf usr/share/doc usr/share/gtk-doc usr/doc usr/gtk-doc ;;
        esac

        case "$KEEP_MAN" in
            0 | no) rm -rf usr/man usr/share/man ;;
        esac

        case "$KEEP_INFO" in
            0 | no) rm -rf usr/info usr/share/info ;;
        esac

        case "$KEEP_HELP" in
            0 | no) rm -rf usr/help usr/share/help ;;
        esac

        case "$NO_STRIP" in
            0 | no) strip_files ;;
        esac

        compress_info_man_pages

        for FILE in $backup; do
            mv "$FILE" "$FILE.@EPKGNEW_EXT@" || {
                msg_error "Failed to backup file: $FILE"
                abort 1
            }
        done

        [ "$FORCE_REBUILD" = "yes" ] && rm -f "$PACKAGE_DIR/$PKG_NAME"

        case "$COMPRESSION_MODE" in
            xz) COMPRESS="xz -T0" ;;
            gz) COMPRESS="gzip -9" ;;
            bz2) COMPRESS="bzip2" ;;
            lz4) COMPRESS="lz4" ;;
            zstd) COMPRESS="zstd -19 -T0" ;;
        esac

        # shellcheck disable=SC2035
        tar -c -I "$COMPRESS" -f "$PACKAGE_DIR/$PKG_NAME" * || {
            rm -f "$PACKAGE_DIR/$PKG_NAME"
            msg_error "Packaging failed: $PKG_NAME"

            abort 1
        }

        # Capture listing once; reuse for display and pkgfiles (avoids re-reading the archive)
        _tar_list=$(tar --quoting-style=literal -tvf "$PACKAGE_DIR/$PKG_NAME")
        [ "$QUIET" != "yes" ] && printf '%s\n' "$_tar_list" | sort -k 6

        msg_info "Packaging success: $PKG_NAME ($(ls -lh "$PACKAGE_DIR/$PKG_NAME" | awk '{print $5;}'))"
    cd - >/dev/null || return 1

    [ -f "${PKGFILES_FILE}" ] || pkg_gen_pkgfiles "$_tar_list"
}

pkg_gen_pkgfiles() {
    [ -f "$PACKAGE_DIR/$PKG_NAME" ] || {
        msg_error "Package not found: $PKG_NAME"
        abort 1
    }

    # If a pre-captured listing is passed as $1, use it; otherwise read the archive
    if [ -n "$1" ]; then
        printf '%s\n' "$1"
    else
        tar --quoting-style=literal -tvf "$PACKAGE_DIR/$PKG_NAME"
    fi | awk '{
        $3 = $4 = $5 = "";
        print $0;
    }' | sort -k 3 > "${PKGFILES_FILE}" || {
        msg_error "Failed to write ${PKGFILES_FILE}"
        exit 1
    }

    msg_info "${PKGFILES_FILE} updated"
}

pkg_clean() {
    if [ -e "$PACKAGE_DIR/$PKG_NAME" ]; then
        rm -f "$PACKAGE_DIR/$PKG_NAME"
        msg_info "Package removed: $PACKAGE_DIR/$PKG_NAME"
    fi

    for i in $(get_filepath); do
        case $i in
            "$PWD"/*) continue ;;
        esac

        if [ -e "$i" ]; then
            rm -f "$i"
            msg_info "File removed: $i"
        fi

        if [ -e "$i.partial" ]; then
            rm -f "$i.partial"
            msg_info "File removed: $i.partial"
        fi
    done
}

check_build_script() {
    # check the required field in buildscript
    if [ -z "$name" ]; then
        msg_error "'name' is empty!"
        exit 1
    fi

    case "$name" in
        *[A-Z]*)
            msg_error "Capital letters for port name are not allowed!"
            exit 1
        ;;
    esac

    [ "${PWD##*/}" = "$name" ] || {
        msg_error "Port name and Directory name is different!"
        exit 1
    }

    if [ -z "$version" ]; then
        msg_error "'version' is empty!"
        exit 1
    fi

    if [ -z "$release" ]; then
        msg_error "'release' is empty!"
        exit 1
    fi

    case "$release" in
        *[A-Z]* | *[a-z]* | *-* | *\.* | *_*)
            msg_error "only numeric allowed in 'release'"
            exit 1
        ;;
    esac

    command -v build >/dev/null 2>&1 || {
        msg_error "'build' function not exist!"
        exit 1
    }

    case "$version" in
        *-*)
            msg_error "'version' should not contain '-'."
            exit 1
        ;;
    esac

    if [ "$release" -gt 99 ] || [ "$release" -lt 1 ]; then
        msg_error "'release' should numeric between 1 to 99"
        exit 1
    fi

    if [ -z "$description" ]; then
        msg_error "'description' is empty!"
        exit 1
    fi
}

check_dir() {
    for DIR in "$@"; do
        [ -d "$DIR" ] || {
            msg_error "Directory '$DIR' does not exist."
            exit 1
        }

        [ -w "$DIR" ] || {
            msg_error "Directory '$DIR' not writable."
            exit 1
        }

        [ -x "$DIR" ] && [ -r "$DIR" ] && continue

        msg_error "Directory '$DIR' not readable."
        exit 1
    done
}

pkg_cleanup() {
    if [ "$KEEP_WORK" != "yes" ] && [ -n "$name" ]; then
        _pkg_work_dir="$WORK_DIR/$name"
        [ -e "$_pkg_work_dir" ] || return 0

        # Run chmod outside fakeroot to restore real write permissions.
        env -u LD_PRELOAD chmod -R u+rwX "$_pkg_work_dir" 2>/dev/null || :
        rm -rf "$_pkg_work_dir"
    fi
}

interrupted() {
    printf '\n'
    abort 100
}

abort() {
    rm -f "$LOCK_FILE"
    pkg_cleanup

    exit "$1"
}

parse_opts() {
    while [ -n "$1" ]; do
        case $1 in
            -[!-]?*)
                _rest=${1#-}
                shift

                while [ -n "$_rest" ]; do
                    _chr="${_rest%"${_rest#?}"}"
                    set -- "-$_chr" "$@"

                    _rest=${_rest#?}
                done

                continue
            ;;
        esac

        case "$1" in
            -q | --quiet) QUIET=yes ;;
            -i | --install) INSTALL_PKG=yes ;;

            -u | --upgrade)
                UPGRADE_PKG=yes
                OPTS="$OPTS $1"
            ;;

            -r | --reinstall)
                REINSTALL_PKG=yes
                OPTS="$OPTS $1"
            ;;

            -c | --ignore-conflict) OPTS="$OPTS $1" ;;
            -v | --verbose) OPTS="$OPTS $1" ;;
            -f | --force-rebuild) FORCE_REBUILD=yes ;;
            -m | --skip-checksum) IGNORE_CHECKSUM=yes ;;
            -g | --gen-checksum) UPDATE_CHECKSUM=yes ;;
            -o | --download) DOWNLOAD_ONLY=yes ;;
            -x | --extract) EXTRACT_ONLY=yes ;;
            -w | --keep-work) KEEP_WORK=yes ;;
            -p | --pkgfiles) GEN_PKGFILES=yes ;;
            -h | --help) SHOW_HELP=yes ;;
            -C | --clean) CLEANUP=yes ;;
            --no-backup) OPTS="$OPTS $1" ;;
            --root=*) OPTS="$OPTS $1" ;;
            --config=*) PKGBUILD_CONF="${1#*=}" ;;
            --srcdir=*) CUSTOM_SOURCE_DIR="${1#*=}" ;;
            --pkgdir=*) CUSTOM_PACKAGE_DIR="${1#*=}" ;;
            --workdir=*) CUSTOM_WORK_DIR="${1#*=}" ;;
            --jobs=*) CUSTOM_JOBS="${1#*=}" ;;

            *)
                msg_info "Invalid ${0##*/} option! ($1)"
                exit 1
            ;;
        esac

        shift
    done
}

help() {
    cat <<'EOF'
Usage:
    pkgbuild <options> [<arg>]

Options:
    -q  --quiet            show only status messages and errors
    -i, --install          install package into system
    -u, --upgrade          upgrade package
    -r, --reinstall        reinstall package
    -c, --ignore-conflict  ignore conflict when installing package
    -v, --verbose          verbose install process
    -f, --force-rebuild    rebuild package
    -m, --skip-checksum    skip checksum checking
    -g, --gen-checksum     generate checksum
    -o, --download         download only source file
    -x, --extract          extract only source file
    -p, --pkgfiles         generate list files in package
    -w, --keep-work        keep working directory
    -h, --help             show this help message
    -C, --clean            remove downloaded sources and prebuilt packages

Global options:
    --config=<config>      use custom config file
    --srcdir=<path>        override directory path for sources
    --pkgdir=<path>        override directory path for compiled package
    --workdir=<path>       override directory path for working dir
    --jobs=<N>             override parallel build jobs (default: JOBS in config, or nproc)
    --no-backup            skip backup configuration file when upgrading package
EOF
}

main() {
    parse_opts "$@"

    [ -f "$PKGBUILD_CONF" ] || {
        msg_error "Config file not found: $PKGBUILD_CONF"
        exit 1
    }

    # shellcheck source=@SYSCONFDIR@/emerald.conf
    . "$PKGBUILD_CONF"

    [ -z "$CUSTOM_SOURCE_DIR" ] || SOURCE_DIR="$CUSTOM_SOURCE_DIR"
    [ -z "$CUSTOM_PACKAGE_DIR" ] || PACKAGE_DIR="$CUSTOM_PACKAGE_DIR"
    [ -z "$CUSTOM_WORK_DIR" ] || WORK_DIR="$CUSTOM_WORK_DIR"

    # Parallel build jobs
    [ -z "$CUSTOM_JOBS" ] && CBUILD_JOBS="$MAKEFLAGS" || CBUILD_JOBS="$CUSTOM_JOBS" # from emerald.conf

    # Fallback to nproc if CBUILD_JOBS wasn't set in config or via --jobs, or is not numeric
    case "$CBUILD_JOBS" in
        '' | *[!0-9]*) CBUILD_JOBS="$(nproc 2>/dev/null)" || CBUILD_JOBS=1 ;;
    esac

    [ "$CBUILD_JOBS" -ge 1 ] 2>/dev/null || CBUILD_JOBS=1

    # Reassign parallelism for every build helper from the single $CBUILD_JOBS value.
    export MAKEFLAGS="-j$CBUILD_JOBS"
    export NINJAFLAGS="-j$CBUILD_JOBS"
    export CMAKE_BUILD_PARALLEL_LEVEL="$CBUILD_JOBS"
    export CARGO_BUILD_JOBS="$CBUILD_JOBS"
    export GOFLAGS="${GOFLAGS:+$GOFLAGS }-p=$CBUILD_JOBS"
    export CBUILD_JOBS

    # show usage
    if [ "$SHOW_HELP" = "yes" ]; then
        help
        exit 0
    fi

    check_dir "$SOURCE_DIR" "$PACKAGE_DIR" "$WORK_DIR"

    [ -f "$PKGBUILD_BSCRIPT" ] || {
        msg_error "'$PKGBUILD_BSCRIPT' file not found."
        exit 1
    }

    # shellcheck source=@BUILD_SCRIPT@
    . ./"$PKGBUILD_BSCRIPT"
    check_build_script

    case "$COMPRESSION_MODE" in
        gz | bz2 | xz | lz4 | zstd) PKG_NAME="$name-$version-$release.epkg.tar.$COMPRESSION_MODE" ;;

        *)
            msg_error "Invalid compression mode: $COMPRESSION_MODE"
            exit 1
        ;;
    esac

    # generate @PKGFILES_FILE@
    if [ "$GEN_PKGFILES" = "yes" ]; then
        pkg_gen_pkgfiles
        exit 0
    fi

    # download source only
    if [ "$DOWNLOAD_ONLY" = "yes" ]; then
        pkg_fetch
        [ -f "${CHECKSUMS_FILE}" ] || pkg_gen_checksums

        exit 0
    fi

    # extract source only
    if [ "$EXTRACT_ONLY" = "yes" ]; then
        pkg_unpack
        exit 0
    fi

    # update checksum
    if [ "$UPDATE_CHECKSUM" = "yes" ]; then
        pkg_gen_checksums
        exit 0
    fi

    # remove source and package
    if [ "$CLEANUP" = "yes" ]; then
        pkg_clean
        exit 0
    fi

    LOCK_FILE="/tmp/pkgbuild.$name.lock"

    # check for lock file
    if [ -f "$LOCK_FILE" ]; then
        msg_error "Cannot build same package simultaneously."
        msg_error "remove '$LOCK_FILE' if no build process for '$name'."

        exit 1
    fi

    # create lock file
    touch "$LOCK_FILE" 2>/dev/null || {
        msg_error "Cannot create lock file in '$LOCK_FILE'."
        exit 1
    }

    # build package
    if [ -f "$PACKAGE_DIR/$PKG_NAME" ] && [ "$FORCE_REBUILD" != "yes" ]; then
        if [ "$INSTALL_PKG" != "yes" ] && [ "$REINSTALL_PKG" != "yes" ] && [ "$UPGRADE_PKG" != "yes" ]; then
            msg_info "Package is up-to-date: $PKG_NAME"
            abort 0
        fi
    else
        msg_info "Building: $name-$version-$release"

        pkg_fetch
        pkg_checksum
        pkg_unpack
        pkg_build
        pkg_package
        pkg_cleanup
    fi

    # install package
    if [ "$INSTALL_PKG" = "yes" ] || [ "$REINSTALL_PKG" = "yes" ] || [ "$UPGRADE_PKG" = "yes" ]; then
        pkgadd "$PACKAGE_DIR/$PKG_NAME" $OPTS || abort 1
    fi

    abort 0
}

trap "interrupted" 1 2 3 15
export LC_ALL=C

PKGBUILD_CONF="@SYSCONFDIR@/emerald.conf"
PKGBUILD_BSCRIPT="@BUILD_SCRIPT@"
CHECKSUMS_FILE="@CHECKSUMS_FILE@"
PKGFILES_FILE="@PKGFILES_FILE@"

SOURCE_DIR="@CACHE_DIR@/sources"
PACKAGE_DIR="@CACHE_DIR@/packages"
WORK_DIR="@CACHE_DIR@/work"
CURL_OPTS=""
COMPRESSION_MODE="xz"
NO_STRIP="no"
IGNORE_CHECKSUM="no"
KEEP_LIBTOOL="no"
KEEP_LOCALE="yes"
KEEP_DOC="no"
KEEP_MAN="yes"
KEEP_INFO="yes"
KEEP_HELP="no"

main "$@"
