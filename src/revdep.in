#!/bin/sh

#
# revdep - Reverse dependency checker for broken packages
#
# This script checks for broken library linkages and identifies packages
# that need to be rebuilt due to missing shared library dependencies.

interrupted() {
    cleanup
    printf '\n'

    exit 1
}

cleanup() {
    rm -f "$FILE_LIST"
}

help() {
    cat <<'EOF'
Usage:
  revdep [option] [arg]

Options:
  -a, --all                         print all affected files
  -r, --rebuild                     rebuild & reinstall broken package
  -p, --package <pkg>               check for certain package
  -f, --no-filter                   skip filter (exclude) dirs, files and libraries
  -e, --exclude <pkg1 pkg2 pkgN>    exclude package when rebuild (use with -r/--rebuild)
  -y, --yes                         dont ask user confirmation to rebuild package (use with -r/--rebuild)
  -h, --help                        print this help message

EOF
}

confirm() {
    printf '%s (Y/n) ' "$1"
    read -r response

    case "$response" in
        [Nn][Oo] | [Nn])
            printf '%s\n' "$2";
            exit 2
        ;;

        *) : ;;
    esac
}

parse_opts() {
    while [ "$1" ]; do
        case $1 in
            -[!-]?*)
                _rest=${1#-}
                shift

                while [ -n "$_rest" ]; do
                    _chr="${_rest%"${_rest#?}"}"
                    set -- "-$_chr" "$@"

                    _rest=${_rest#?}
                done

                continue
            ;;
        esac

        case $1 in
            -a | --all) PRINTALL=1 ;;
            -r | --rebuild) REBUILD=1 ;;
            -y | --yes) NOCONFIRM=1 ;;
            -f | --no-filter) NO_FILTER=1 ;;

            -e | --exclude)
                while [ "$2" ]; do
                    case $2 in
                        -*) break ;;
                        *) [ -z "$expkg" ] && expkg="$2" || expkg="$expkg $2" ;;
                    esac

                    shift
                done
            ;;

            -p | --package)
                PKG=$2;
                shift
            ;;

            -h | --help)
                help;
                exit 0
            ;;

            *)
                printf 'Invalid option (%s)\n' "$1";
                exit 1
            ;;
        esac

        shift
    done
}

rebuild() {
    # Preserve topological order from emerald deplist, keeping only broken packages.
    for allpkg in $(emerald deplist $ALLPKG | awk '{print $2}'); do
        case " $ALLPKG " in
            *" $allpkg "*) order="${order:+$order} $allpkg" ;;
        esac
    done

    if [ -n "$order" ]; then
        if [ "$NOCONFIRM" = "" ]; then
            printf '\nPackage will be rebuild & reinstall by this order:\n'
            printf ' %s\n' "$order"
            printf '\n'

            confirm "Continue rebuild & reinstall broken packages?" "Operation cancelled."
        fi

        for p in $order; do
            emerald install -fr "$p" || {
                cleanup;
                exit 1
            }
        done
    fi
}

rev_exclude() {
    # excluded dirs
    EXCLUDE_DIRS="$(grep -v '^#' @SYSCONFDIR@/revdep.conf 2>/dev/null | grep '/$' | sort -u | sed 's/\/*$//g')"
    EXCLUDE_DIRS="$EXCLUDE_DIRS $(grep -v '^#' @SYSCONFDIR@/revdep.d/*.conf 2>/dev/null | cut -d : -f2 | grep '/$' | sort -u | sed 's/\/*$//g')"

    for dd in $EXCLUDE_DIRS; do
        if [ -d "$dd" ]; then
            _DIRS="$_DIRS $dd"
            ged="$ged -e ^$dd"
        fi
    done

    EXCLUDE_DIRS=$(printf '%s\n' $_DIRS | sort -u)

    for d in $EXCLUDE_DIRS; do
        EXCLUDED_DIRS="$EXCLUDED_DIRS -path $d -prune -o "
    done

    # excluded files
    EXCLUDE_FILES="$(grep -v '^#' @SYSCONFDIR@/revdep.conf 2>/dev/null | grep -v '/$' | grep '^/')"
    EXCLUDE_FILES="$EXCLUDE_FILES $(grep -v '^#' @SYSCONFDIR@/revdep.d/*.conf 2>/dev/null | cut -d : -f2 | grep -v '/$' | grep '^/')"

    for ff in $EXCLUDE_FILES; do
        if [ -f "$ff" ]; then
            _FILES="$_FILES $ff"
            gef="$gef -e ^$ff\$"
        fi
    done

    EXCLUDE_FILES=$(printf '%s\n' $_FILES | sort -u)

    for f in $EXCLUDE_FILES; do
        EXCLUDED_FILES="$EXCLUDED_FILES ! -path $f "
    done

    # excluded libraries
    EXCLUDE_LIBS="$(grep -v '^#' @SYSCONFDIR@/revdep.conf 2>/dev/null | grep -v '^/' | grep '.*.so.*')"
    EXCLUDE_LIBS="$EXCLUDE_LIBS $(grep -v '^#' @SYSCONFDIR@/revdep.d/*.conf 2>/dev/null | cut -d : -f2 | grep -v '^/' | grep '.*.so.*')"

    for _lib in $EXCLUDE_LIBS; do
        case " $EXCLUDED_LIBS " in
            *" $_lib "*) ;;
            *) EXCLUDED_LIBS="${EXCLUDED_LIBS:+$EXCLUDED_LIBS} $_lib" ;;
        esac
    done
}

check_python_modules() {
    command -v python3 >/dev/null 2>&1 || return
    pylibpath=$(python3 -c "import sys; print(':'.join(x for x in sys.path if x))" | tr ':' '\n' | sort | head -n1)

    for i in /usr/lib/python3.*; do
        [ -d "$i" ] || continue
        [ "$i" = "$pylibpath" ] && continue

        brokenpkg="$brokenpkg $(emerald provide "$i/" | awk '{print $1}')"
    done
}

check_perl_modules() {
    command -v perl >/dev/null 2>&1 || return

    perlpath=$(perl -MConfig -e 'print $Config{sitearch}')
    [ -d "$perlpath" ] || return

    for i in $(dirname "$perlpath")/*; do
        [ "$perlpath" = "$i" ] && continue
        [ -d "$i" ] || continue

        brokenpkg="$brokenpkg $(emerald provide "$i/" | awk '{print $1}')"
    done
}

check_ruby_gem() {
    command -v gem >/dev/null 2>&1 || return
    gempath=$(gem env gemdir)

    for i in $(dirname "$gempath")/*; do
        [ "$gempath" = "$i" ] && continue
        brokenpkg="$brokenpkg $(emerald provide "$i/" | awk '{print $1}')"
    done
}

# Trap signals for cleanup
trap "interrupted" 1 2 3 15

# Check for required command
command -v pkgadd >/dev/null 2>&1 || {
    printf "'pkgadd' not found in \$PATH!\n" >&2
    exit 1
}

# Package database directory
PKGDB_DIR="$(pkgadd --print-dbdir)"
SEARCH_DIRS="/bin /usr/bin /sbin /usr/sbin /lib /usr/lib /lib64 /usr/lib64 /usr/libexec"

parse_opts "$@"

# Check for root privileges when rebuilding
if [ "$(id -u)" != 0 ] && [ "$REBUILD" = 1 ]; then
    printf '%s need to run as root to rebuild & reinstall package\n' "$(basename "$0")" >&2
    help

    exit 1
fi

# Verify package is installed
if [ "$PKG" ] && [ ! -f "$PKGDB_DIR/$PKG" ]; then
    printf "ERROR: Package '%s' not installed\n" "$PKG" >&2
    cleanup

    exit 1
fi

# Get extra search directories from ld.so.conf
while read -r line; do
    case "$line" in
        /*) EXTRA_SEARCH_DIRS="$EXTRA_SEARCH_DIRS $line " ;;
    esac
done < /etc/ld.so.conf

# Process ld.so.conf.d directory
if [ -d /etc/ld.so.conf.d ]; then
    for dir in /etc/ld.so.conf.d/*.conf; do
        [ -f "$dir" ] || continue

        while read -r line; do
            case "$line" in
                /*) EXTRA_SEARCH_DIRS="$EXTRA_SEARCH_DIRS $line " ;;
            esac
        done < "$dir"
    done
fi

# Apply exclusion filters
if [ "$NO_FILTER" != 1 ]; then
    rev_exclude
fi

# Combine search directories
TARGET_SEARCH_DIRS="$SEARCH_DIRS $EXTRA_SEARCH_DIRS"
FILE_LIST="/tmp/.revdep.$$"

printf 'SEARCH DIRS:\n'
for d in $TARGET_SEARCH_DIRS; do
    if [ -d "$d" ]; then
        SEARCH_DIRS="$SEARCH_DIRS $d"
        printf ' %s\n' "$d"
    fi
done
printf '\n'

printf 'EXCLUDED DIRS:\n'
for dd in $EXCLUDE_DIRS; do
    printf ' %s\n' "$dd"
done
printf '\n'

printf 'EXCLUDED FILES:\n'
for ff in $EXCLUDE_FILES; do
    printf ' %s\n' "$ff"
done
printf '\n'

printf 'EXCLUDED LIBS:\n'
for ll in $EXCLUDED_LIBS; do
    printf ' %s\n' "$ll"
done
printf '\n'

# Build file list to check
if [ "$PKG" ]; then
    # Build grep patterns for target directories
    for D in $TARGET_SEARCH_DIRS; do
        gx="$gx -e ^$D"
    done

    gx="$gx -e '*\.so' -e '*\.so\.*'"

    # Set up filters
    if [ -n "$gef" ]; then
        filterfile="grep -v $gef"
    else
        filterfile=cat
    fi

    if [ -n "$ged" ]; then
        filterdir="grep -v $ged"
    else
        filterdir=cat
    fi

    printf "Find '%s' files... " "$PKG"
    tail -n +2 "$PKGDB_DIR/$PKG" | sed 's/^/\//' | grep $gx | $filterfile | $filterdir > "$FILE_LIST"
else
    printf 'Find all files... '

    # shellcheck disable=SC2086
    find $SEARCH_DIRS $EXCLUDED_DIRS $EXCLUDED_FILES -type f \( -perm /+u+x -o -name '*.so' -o -name '*.so.*' \) -print 2> /dev/null | sort -u > "$FILE_LIST"
fi

total=$(wc -l "$FILE_LIST" | awk '{print $1}')
count=0

printf '%s files found\n' "$total"
printf 'Checking for broken linkage...\n'

# Main checking loop
while read -r line; do
    count=$((count + 1))
    libname=${line##*/}

    printf ' %d%% %s\033[0K\r' "$((100 * count / total))" "$libname"

    case "$(file -bi "$line")" in
        *application/x-sharedlib* | *application/x-executable* | *application/x-pie-executable*)
            ldd_out=$(ldd "$line" 2>/dev/null)

            case "$ldd_out" in
                *"not found"*)
                    LIB_NAME=$(printf '%s\n' "$ldd_out" | awk '/not found/ && !seen[$1]++{print $1}')

                    # filter excluded libraries
                    for l in $LIB_NAME; do
                        case " $EXCLUDED_LIBS " in
                            *" $l "*) ;;
                            *) NEW_LIB_NAME="$NEW_LIB_NAME $l" ;;
                        esac
                    done

                    [ "$NEW_LIB_NAME" ] || continue
                    LIB_NAME=$NEW_LIB_NAME

                    PKG_NAME=${line#?}
                    PKG_NAME=$(grep -Fxl "$PKG_NAME" "$PKGDB_DIR"/*)

                    [ "$PKG_NAME" ] || continue
                    PKG_NAME=${PKG_NAME##*/}

                    case " $expkg " in
                        *" $PKG_NAME "*) continue ;;
                    esac

                    # Get required libraries
                    REQ_LIB=$(objdump -p "$line" 2>/dev/null | awk '/NEEDED/{printf "%s ", $2}')

                    for i in $LIB_NAME; do
                        [ "$PRINTALL" = 1 ] && printf ' %s -> %s (requires %s)\n' "$PKG_NAME" "$line" "$i"

                        case " $REQ_LIB" in
                            *" $i "*)
                                [ "$PRINTALL" = 1 ] || printf ' %s -> %s (requires %s)\n' "$PKG_NAME" "$line" "$i"

                                case " $ALLPKG " in
                                    *" $PKG_NAME "*) ;;
                                    *) ALLPKG="$ALLPKG $PKG_NAME" ;;
                                esac
                            ;;
                        esac
                    done
                ;;
            esac
        ;;
    esac

    unset NEW_LIB_NAME
done < "$FILE_LIST"

printf '\033[0K'

# Check for broken module packages
if [ -z "$PKG" ]; then
    printf '\n'
    printf 'Checking for broken packages...\n'

    check_python_modules
    check_perl_modules
    check_ruby_gem
fi

# Consolidate broken packages
if [ "$brokenpkg" ]; then
    for i in $brokenpkg; do
        case " $ALLPKG " in
            *" $i "*) ;;
            *) ALLPKG="$ALLPKG $i" ;;
        esac
    done
fi

# Report and optionally rebuild
if [ "$ALLPKG" ]; then
    printf '\nBroken package(s):\n'
    LISTALLPKG=$(printf '%s\n' $ALLPKG | uniq) # Remove duplicates
    printf ' %s\n' "$LISTALLPKG"

    if [ "$REBUILD" = 1 ]; then
        rebuild
    fi
else
    printf 'All packages are doing fine.\n'
fi

cleanup
exit 0
