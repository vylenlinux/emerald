#!/bin/sh

# portcreate - Create port templates with different build systems
# Usage: portcreate [-b builder] <portname>

msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

usage() {
    cat <<'EOF'
Usage:
    portcreate [-b builder] <portname>

Create a port template directory with @BUILD_SCRIPT@ file.

Options:
    -b <builder>  Specify build system (default: autotools)
                  Available: autotools, meson, cmake, go, python, rust

    -h            Show this help message

Examples:
    portcreate myport            # Creates autotools template
    portcreate -b meson myport   # Creates meson template
    portcreate -b cmake myport   # Creates cmake template
    portcreate -b go myport      # Creates go template
    portcreate -b python myport  # Creates python template
    portcreate -b rust myport    # Creates rust template
EOF
    exit 0
}

get_autotools_template() {
    cat <<'EOF'
#!/bin/sh

# shellcheck disable=SC2034
description=""
homepage=""
maintainer="Vylen Linux Team <@EMAIL@>"

name=%name%
version=
release=1
noextract=""
backup=""
source=""

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
EOF
}

get_meson_template() {
    cat <<'EOF'
#!/bin/sh

# shellcheck disable=SC2034
description=""
homepage=""
maintainer="Vylen Linux Team <@EMAIL@>"

name=%name%
version=
release=1
noextract=""
backup=""
source=""

build() {
    vylen-meson "${name}-${version}" build \
        -Doption=false \
        -Doption2=true

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
EOF
}

get_cmake_template() {
    cat <<'EOF'
#!/bin/sh

# shellcheck disable=SC2034
description=""
homepage=""
maintainer="Vylen Linux Team <@EMAIL@>"

name=%name%
version=
release=1
noextract=""
backup=""
source=""

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
EOF
}

get_go_template() {
    cat <<'EOF'
#!/bin/sh

# shellcheck disable=SC2034
description=""
homepage=""
maintainer="Vylen Linux Team <@EMAIL@>"

name=%name%
version=
release=1
noextract=""
backup=""
source=""

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOFLAGS="-buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    # shellcheck disable=SC2035
    go build *.go -o "bin/${name}"
    install -Dm755 "bin/${name}" -t "${PKG}/usr/bin/"
}
EOF
}

get_python_template() {
    cat <<'EOF'
#!/bin/sh

# shellcheck disable=SC2034
description=""
homepage=""
maintainer="Vylen Linux Team <@EMAIL@>"

name=%name%
version=
release=1
noextract=""
backup=""
source=""

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    python3 setup.py build

    python3 setup.py install \
        --prefix=/usr \
        --root="${PKG}"
}
EOF
}

get_rust_template() {
    cat <<'EOF'
#!/bin/sh

# shellcheck disable=SC2034
description=""
homepage=""
maintainer="Vylen Linux Team <@EMAIL@>"

name=%name%
version=
release=1
noextract=""
backup=""
source=""

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build \
        --release \
        --locked

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
EOF
}

# Default builder
BUILDER="autotools"

# Parse options
while getopts "b:h" opt; do
    case "${opt}" in
        b) BUILDER="${OPTARG}" ;;
        *) usage ;;
    esac
done

shift $((OPTIND - 1))

# Check if portname is provided
if [ -z "${1}" ]; then
    msg_error "Port name is required!"
    usage
fi

PORTNAME="${1}"

# Check if directory already exists
if [ -d "${PORTNAME}" ]; then
    msg_error "Directory '${PORTNAME}' already exists!"
    exit 1
fi

# Create directory
mkdir "${PORTNAME}" || {
    msg_error "Failed to create directory '${PORTNAME}'!"
    exit 1
}

# Generate appropriate template
case "${BUILDER}" in
    autotools | make) TEMPLATE=$(get_autotools_template) ;;
    meson) TEMPLATE=$(get_meson_template) ;;
    cmake) TEMPLATE=$(get_cmake_template) ;;
    go | golang) TEMPLATE=$(get_go_template) ;;
    python | python3) TEMPLATE=$(get_python_template) ;;
    rust | rs) TEMPLATE=$(get_rust_template) ;;

    *)
        msg_error "Unknown builder '${BUILDER}'!"
        printf "Available builders: autotools, meson, cmake, go, python, rust\n" >&2

        rm -rf "${PORTNAME}"
        exit 1
    ;;
esac

# Replace PORTNAME placeholder and write to file
printf "%s\n" "${TEMPLATE}" | sed "s/%name%/${PORTNAME}/" > "${PORTNAME}/@BUILD_SCRIPT@"
printf "Template port created for '%s' using '%s' build system.\n" "${PORTNAME}" "${BUILDER}"

exit 0
