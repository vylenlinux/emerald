#!/bin/sh

# shellcheck disable=SC2317
#
# xchroot - Script to enter chroot environment with proper mounts
# POSIX-compliant version for production use
#
# Description:
#   This script safely enters a chroot environment by mounting all necessary
#   filesystems (/dev, /proc, /sys, /run, /tmp, /etc/resolv.conf) and
#   provides automatic cleanup on exit. Concurrent sessions targeting the
#   same directory share these mounts; the last session unmounts them.
#
# Requirements:
#   - Root privileges
#   - Target directory must exist
#   - Standard Linux filesystem hierarchy
#   - flock(1), mountpoint(1), and sha256sum(1)
#
# Exit codes:
#   0   - Success
#   1   - Error (permission denied, invalid directory, mount failure)
#   129 - Terminated by SIGHUP
#   130 - Terminated by SIGINT
#   131 - Terminated by SIGQUIT
#   143 - Terminated by SIGTERM
#   Otherwise, the exit status of the command run inside the chroot.
#

# Directory holding the per-chroot lock files (tmpfs on the host)
LOCK_ROOT=/run/xchroot

# Display usage information
help() {
    cat <<'EOF'

Usage:
    xchroot <chroot-dir> [command]

If 'command' is unspecified, xchroot will launch /usr/bin/sh.

Arguments:
    <chroot-dir>  Directory to use as new root filesystem
    [command]     Command to execute inside chroot (optional)

Description:
    This script mounts necessary filesystems and enters a chroot environment.
    It automatically mounts: /dev, /proc, /sys, /run, /tmp, and /etc/resolv.conf
    Concurrent sessions targeting the same directory share mounts. They are
    unmounted when the last session exits.

Examples:
    xchroot /mnt/mysystem
    xchroot /mnt/mysystem portsync
    xchroot /mnt/mysystem emerald sysup -y
    xchroot /mnt/mysystem /usr/bin/bash
    xchroot /mnt/mysystem /usr/bin/mksh -c portsync

Notes:
    - If you want to run a command using a specific shell, use: shell -c 'command'
    - Arguments are passed directly to the command, preserving their structure
EOF
}

# Print info message to stdout
msg_info() {
    printf "==> %s\n" "$1"
}

# Print error message to stderr
msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

# Check for root privileges
if [ "$(id -u)" -ne 0 ]; then
    msg_error "this script requires root privileges!"
    help

    exit 1
fi

# Check for commands needed for concurrent-session tracking
for _command in flock mountpoint sha256sum; do
    command -v "$_command" >/dev/null 2>&1 || {
        msg_error "Required command '$_command' not found"
        exit 1
    }
done

# Mount a filesystem unless another xchroot session has already mounted it
# Usage: mount_if_needed <subdirectory> <mount arguments, without target>
mount_if_needed() {
    _subdir="$1"
    shift

    if mountpoint -q "$TARGET/$_subdir" 2>/dev/null; then
        return 0
    fi

    mount "$@" "$TARGET/$_subdir"
}

# Unmount all filesystems in reverse order
# Note: Uses reverse order to avoid "device busy" errors
umount_all() {
    [ -n "$TARGET" ] || return 0

    for t in etc/resolv.conf tmp sys/firmware/efi/efivars sys run proc dev/shm dev/pts dev; do
        if mountpoint -q "$TARGET/$t" 2>/dev/null; then
            # Try normal unmount first, fallback to lazy unmount
            umount "$TARGET/$t" 2>/dev/null || umount -l "$TARGET/$t" 2>/dev/null
        fi
    done
}

# Leave this session. Only the last member unmounts the shared filesystems.
# The mutex prevents another session from joining between the last-member
# check and cleanup. flock releases membership locks automatically on SIGKILL.
cleanup() {
    trap '' 1 2 3 15

    # Do not risk unmounting under other sessions if serialization fails
    flock 9 || return 0

    # Conversion succeeds only when this is the last session
    if flock -xn 8; then
        umount_all
    fi
}

# Validate that target directory argument is provided
if [ -z "$1" ]; then
    msg_error "Please specify a directory for chroot"
    help

    exit 1
fi

# Verify target directory exists before resolving it
[ -d "$1" ] || {
    msg_error "Directory '$1' does not exist"
    help

    exit 1
}

# Resolve the target to a physical absolute path so aliases share one lock
TARGET=$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) || {
    msg_error "Cannot resolve directory '$1'"
    help

    exit 1
}

# Never allow the host root as chroot target
if [ "$TARGET" = "/" ]; then
    msg_error "Refusing to use '/' as chroot target"
    help

    exit 1
fi

# Optional check: inform if target is already a mount point
if mountpoint -q "$TARGET" 2>/dev/null; then
    msg_info "Target '$TARGET' is already a mount point"
fi

# Shift to process command arguments
shift

# Determine command to execute in chroot
if [ -z "$1" ]; then
    set -- /usr/bin/sh
fi

# At this point $@ contains the command and all its arguments
# This preserves argument separation for commands like: ls -la /tmp

# Hash the canonical path to keep lock filenames short and unambiguous
KEY=$(printf '%s' "$TARGET" | sha256sum) || {
    msg_error "Could not calculate lock key for '$TARGET'"
    exit 1
}

KEY="${KEY%% *}"
LOCK_DIR="$LOCK_ROOT/$KEY"
MEMBERS="$LOCK_DIR/members"
MUTEX="$LOCK_DIR/mutex"

mkdir -p "$LOCK_ROOT" || {
    msg_error "Cannot create '$LOCK_ROOT'"
    exit 1
}

chmod 700 "$LOCK_ROOT" || {
    msg_error "Cannot secure '$LOCK_ROOT'"
    exit 1
}

mkdir -p "$LOCK_DIR" || {
    msg_error "Cannot create '$LOCK_DIR'"
    exit 1
}

chmod 700 "$LOCK_DIR" || {
    msg_error "Cannot secure '$LOCK_DIR'"
    exit 1
}

# Open per-chroot lock files. These descriptors must not be inherited by chroot.
exec 8>>"$MEMBERS" 9>>"$MUTEX" || {
    msg_error "Cannot open lock files for '$TARGET'"
    exit 1
}

# Serialize setup, then register this session as a member
flock 9 || {
    msg_error "Cannot lock '$MUTEX'"
    exit 1
}

flock -s 8 || {
    msg_error "Cannot lock '$MEMBERS'"
    exit 1
}

# Install traps after joining the session set and before mounting anything
# Signal numbers are used for maximum POSIX portability:
#   0  = EXIT  - normal script exit
#   1  = HUP   - hangup (terminal closed)
#   2  = INT   - interrupt (Ctrl+C)
#   3  = QUIT  - quit signal (Ctrl+\)
#   15 = TERM  - termination signal (kill default)
trap cleanup 0
trap 'cleanup; trap - 0; exit 129' 1
trap 'cleanup; trap - 0; exit 130' 2
trap 'cleanup; trap - 0; exit 131' 3
trap 'cleanup; trap - 0; exit 143' 15

msg_info "Preparing filesystems for chroot environment..."

# Mount required filesystems. Existing mounts are reused by concurrent sessions;
# die exits through cleanup, which unmounts only if this was the last session.
mount_if_needed dev -o bind /dev || {
    msg_error "Failed to mount /dev"
    exit 1
}

mount_if_needed dev/pts -t devpts devpts -o gid=5,mode=620 || {
    msg_error "Failed to mount /dev/pts"
    exit 1
}

mount_if_needed dev/shm -t tmpfs tmpfs -o nosuid,nodev || {
    msg_error "Failed to mount /dev/shm"
    exit 1
}

mount_if_needed proc -t proc proc || {
    msg_error "Failed to mount /proc"
    exit 1
}

mount_if_needed run -t tmpfs tmpfs || {
    msg_error "Failed to mount /run"
    exit 1
}

mount_if_needed sys -t sysfs sysfs || {
    msg_error "Failed to mount /sys"
    exit 1
}

# EFI variables are optional on systems without UEFI
mount_if_needed sys/firmware/efi/efivars -t efivarfs efivarfs 2>/dev/null || msg_info "EFI variables not mounted (may not be available)"

mount_if_needed tmp -t tmpfs tmpfs -o mode=1777,nosuid,nodev || {
    msg_error "Failed to mount /tmp"
    exit 1
}

# Handle DNS resolution configuration (do not bind it again if already mounted)
if [ -f /etc/resolv.conf ] && ! mountpoint -q "$TARGET/etc/resolv.conf" 2>/dev/null; then
    touch "$TARGET/etc/resolv.conf" 2>/dev/null || msg_info "Could not create resolv.conf in chroot"

    # Non-critical: DNS configuration may be unavailable in minimal chroots
    mount -o bind /etc/resolv.conf "$TARGET/etc/resolv.conf" 2>/dev/null || msg_info "Could not bind mount resolv.conf"
fi

# Mounts are ready: allow other sessions to join or leave
flock -u 9 || {
    msg_error "Cannot release setup lock '$MUTEX'"
    exit 1
}

msg_info "Entering chroot environment: $TARGET"
msg_info "Executing: $*"

# INT/QUIT also reach this script via the terminal's process group. Let the
# command handle them while retaining its exit status for cleanup.
trap : 2 3

# Enter chroot with clean environment
# /usr/bin/env -i creates fresh environment with only specified variables
# 8>&- 9>&- keep the lock fds out of the chroot: otherwise a process left
# running there would count as a live session forever.
chroot "$TARGET" /usr/bin/env -i HOME=/root TERM="$TERM" PS1='\u:\w\$ ' PATH=/usr/bin "$@" 8>&- 9>&-

# Capture chroot exit status immediately
# Must be done before any other command to preserve $?
retval="$?"

# Trap will automatically call umount_all on EXIT
# No need to call it manually here
msg_info "Exited chroot with status: $retval"

# Exit with same status as chrooted command
exit "$retval"
