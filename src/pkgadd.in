#!/bin/sh

# shellcheck disable=SC2317
#
# pkgadd - Package install utility
# POSIX-compliant shell script for install, reinstall or upgrade packages
#

trap "interrupted" 1 2 3 15
export LC_ALL=C

# Resolve a file path to its absolute physical path without using external 'realpath'
get_realpath() {
    case "$1" in
        */*)
            _dir="${1%/*}"
            _file="${1##*/}"
        ;;

        *)
            _dir=.
            _file="$1"
        ;;
    esac

    # Use a subshell to avoid changing the current directory permanently
    (CDPATH='' cd -P -- "$_dir" && printf '%s/%s\n' "$(pwd -P)" "$_file")
}

interrupted() {
    printf '\n'
    ret 1
}

msg_info() {
    printf "==> %s\n" "$1"
}

msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

help() {
    cat <<'EOF'
Usage:
    pkgadd <options> [<package.epkg.tar.xz>]

Options:
    -u, --upgrade          upgrade package
    -r, --reinstall        reinstall package
    -c, --ignore-conflict  ignore conflict when installing package
    -v, --verbose          print files installed
    -h, --help             show this help message

Global options:
    --no-backup            skip backup when upgrading package
    --print-db-dir         print package database path
    --root=<path>          install to custom root directory
EOF
}

parse_opts() {
    if [ -z "$1" ]; then
        SHOW_HELP=yes
        return 0
    fi

    while [ -n "$1" ]; do
        case $1 in
            -[!-]?*)
                _rest=${1#-}
                shift

                while [ -n "$_rest" ]; do
                    _chr="${_rest%"${_rest#?}"}"
                    set -- "-$_chr" "$@"

                    _rest=${_rest#?}
                done

                continue
            ;;
        esac

        case $1 in
            -u | --upgrade) UPGRADE_PKG=yes ;;
            -r | --reinstall) REINSTALL_PKG=yes ;;
            -c | --ignore-conflict) IGNORE_CONFLICT=yes ;;
            -v | --verbose) VERBOSE_INSTALL=yes ;;
            -h | --help) SHOW_HELP=yes ;;
            --no-backup) NO_BACKUP=yes ;;
            --print-db-dir) PRINT_DB_DIR=yes ;;
            --root=*) ROOT_DIR="${1#*=}" ;;
            *.epkg.tar.*) PKGNAME="$(get_realpath "$1")" ;;

            *)
                msg_info "Invalid option! ($1)"
                exit 1
            ;;
        esac

        shift
    done
}

ret() {
    # Remove lock and all tmp files on exit
    rm -f "$ROOT_DIR/$LOCK_FILE" "$TMP_PKGADD" "$TMP_PKGINSTALL"
    exit "$1"
}

# Process options
parse_opts "$@"

EMERALD_DIR="@STATE_DIR@"
PKGDB_DIR="$EMERALD_DIR/db"
LOCK_FILE="$EMERALD_DIR/epkg.lock"

ROOT_DIR="${ROOT_DIR%/}" # Remove trailing slash

if [ "$PRINT_DB_DIR" = "yes" ]; then
    printf '%s/%s\n' "$ROOT_DIR" "$PKGDB_DIR"
    exit 0
fi

# Show help page
if [ "$SHOW_HELP" = "yes" ] || [ -z "$PKGNAME" ]; then
    help
    exit 0
fi

[ -d "$ROOT_DIR/$PKGDB_DIR" ] || {
    msg_error "Package's database directory does not exist: $ROOT_DIR/$PKGDB_DIR"
    exit 1
}

# Check for root access
if [ "$(id -u)" -ne 0 ]; then
    msg_error "Installing packages requires root access!"
    help

    exit 1
fi

# Check for lock file
if [ -f "$ROOT_DIR/$LOCK_FILE" ]; then
    msg_error "Cannot install/remove package simultaneously."
    msg_error "remove '$ROOT_DIR/$LOCK_FILE' if no install/remove package process running."

    exit 1
fi

touch "$ROOT_DIR/$LOCK_FILE" 2>/dev/null || {
    msg_error "Cannot create lock file in '$ROOT_DIR/$LOCK_FILE'."
    exit 1
}

BASE_PKG_NAME="${PKGNAME##*/}"

# Check existence of package file
[ -f "$PKGNAME" ] || {
    msg_error "Package '$1' does not exist!"
    ret 1
}

stem="${BASE_PKG_NAME%.epkg.tar.*}"
release="${stem##*-}"
stem="${stem%-*}"
version="${stem##*-}"
name="${stem%-*}"

# Get package information if installed
if [ -s "$ROOT_DIR/$PKGDB_DIR/$name" ]; then
    read -r iversion irelease < "$ROOT_DIR/$PKGDB_DIR/$name" # read first line
    ALREADY_INSTALLED=yes
fi

if [ "$ALREADY_INSTALLED" = "yes" ] && [ "$UPGRADE_PKG" != "yes" ] && [ "$REINSTALL_PKG" != "yes" ]; then
    printf "Package '%s' already installed. (%s-%s)\n" "$name" "$iversion" "$irelease"
    ret 0
fi

# Can't reinstall if not installed and can't upgrade if up-to-date
if [ "$UPGRADE_PKG" = "yes" ] || [ "$REINSTALL_PKG" = "yes" ]; then
    if [ "$ALREADY_INSTALLED" != "yes" ]; then
        msg_error "Package '$name' not installed."
        ret 1
    fi

    if [ "$UPGRADE_PKG" = "yes" ] && [ "$version-$release" = "$iversion-$irelease" ]; then
        printf "Package '%s' is up-to-date. (%s-%s)\n" "$name" "$iversion" "$irelease"
        ret 0
    fi
fi

TMP_PKGADD="$ROOT_DIR/$EMERALD_DIR/.tmp_pkgadd"
TMP_PKGINSTALL="$ROOT_DIR/$EMERALD_DIR/.tmp_pkginstall"

# Check integrity of package and save list file/dirs to install, --quoting-style=literal (GNU tar)
# avoids octal-escaping non-ASCII filenames in the listing, so paths stored/compared here match
# the real bytes on disk exactly.
tar --quoting-style=literal -tvf "$PKGNAME" > "$TMP_PKGADD" 2>/dev/null || {
    msg_error "Package '$1' is corrupted!"
    ret 1
}

# Set operation whether install/upgrade/reinstall
opr=install
[ "$UPGRADE_PKG" = "yes" ] && opr=upgrade
[ "$REINSTALL_PKG" = "yes" ] && opr=reinstall
printf "%s: %s-%s-%s...\n" "$opr" "$name" "$version" "$release"

# Check for file conflict
if [ "$IGNORE_CONFLICT" != "yes" ]; then
    # Determine if we need to exclude the current package (upgrade/reinstall)
    conflicts=0

    while IFS= read -r line; do
        [ -n "$line" ] || continue

        # Remove .@EPKGNEW_EXT@ suffix if present
        case "$line" in
            *.@EPKGNEW_EXT@) line="${line%.@EPKGNEW_EXT@}" ;;
        esac

        # Check if file or symlink (including broken) exists in root
        if [ -e "$ROOT_DIR/$line" ] || [ -L "$ROOT_DIR/$line" ]; then
            # Skip if this file is already owned by the current package
            if [ "$UPGRADE_PKG" = "yes" ] || [ "$REINSTALL_PKG" = "yes" ]; then
                if grep -Fxq "$line" "$ROOT_DIR/$PKGDB_DIR/$name" 2>/dev/null; then
                    continue  # belongs to this package, skip conflict
                fi
            fi

            # Find which installed package owns this file
            owner=$(grep -lFx "$line" "$ROOT_DIR/$PKGDB_DIR"/* 2>/dev/null | head -n1)
            [ -n "$owner" ] && owner="${owner##*/}" || owner="(none)"

            printf '%s %s\n' "$owner" "$line"
            conflicts=1
        fi
    # List package files (excluding directories ending in '/') to check for conflicts with awk command
    done <<EOF
$(awk '!/\/$/{print $6;}' "$TMP_PKGADD")
EOF

    if [ "$conflicts" -eq 1 ]; then
        msg_error "File conflict found!"
        ret 1
    fi
fi

rm -f "$TMP_PKGINSTALL"

# Extract package into ROOT_DIR
tar --quoting-style=literal -xvhpf "$PKGNAME" -C "$ROOT_DIR/" | while read -r line; do
    case "$line" in
        *.@EPKGNEW_EXT@)
            line="${line%.@EPKGNEW_EXT@}"

            # Handle @EPKGNEW_EXT@ file in fresh install OR upgrade/reinstall when file is absent OR --no-backup is set
            if [ "$UPGRADE_PKG" != "yes" ] && [ "$REINSTALL_PKG" != "yes" ] || [ ! -e "$ROOT_DIR/$line" ] || [ "$NO_BACKUP" = "yes" ]; then
                cp --reflink=auto "$ROOT_DIR/$line.@EPKGNEW_EXT@" "$ROOT_DIR/$line"
                rm -f "$ROOT_DIR/$line.@EPKGNEW_EXT@"
            fi
        ;;
    esac

    [ "$VERBOSE_INSTALL" = "yes" ] && printf "extracted '%s'\n" "$line"
    printf '%s\n' "$line" >> "$TMP_PKGINSTALL"
done

# Remove old files from old package that do not exist in new package
if [ "$UPGRADE_PKG" = "yes" ] || [ "$REINSTALL_PKG" = "yes" ]; then
    # awk replacement for tail + tac (no POSIX)
    awk 'NR > 1 {
        lines[n++] = $0;
    } END {
        while (n--) print lines[n];
    }' "$ROOT_DIR/$PKGDB_DIR/$name" | while read -r line; do
        case $line in
            */)
                # Directory removal logic
                grep -Fxq "$line" "$TMP_PKGINSTALL" || grep -HFx "$line" "$ROOT_DIR/$PKGDB_DIR"/* 2>/dev/null | grep -Fqv "$ROOT_DIR/$PKGDB_DIR/$name:" || {
                    # Manual verbose printing, as 'rmdir -v' is not POSIX
                    [ "$VERBOSE_INSTALL" = "yes" ] && printf "removing directory '%s'\n" "$ROOT_DIR/$line"
                    rmdir "$ROOT_DIR/$line" 2>/dev/null
                }
            ;;

            *)
                # File removal logic
                grep -Fxq "$line" "$TMP_PKGINSTALL" || {
                    # Manual verbose printing, as 'rm -v' is not POSIX
                    [ "$VERBOSE_INSTALL" = "yes" ] && printf "removing '%s'\n" "$ROOT_DIR/$line"
                    rm -f "$ROOT_DIR/$line"
                }
            ;;
        esac
    done
fi

# Register package into database
printf '%s %s\n' "$version" "$release" > "$ROOT_DIR/$PKGDB_DIR/$name"
cat "$TMP_PKGINSTALL" >> "$ROOT_DIR/$PKGDB_DIR/$name"

# Running ldconfig
[ -x "$ROOT_DIR/usr/bin/ldconfig" ] && "$ROOT_DIR/usr/bin/ldconfig" -r "$ROOT_DIR/"
ret 0
