#!/bin/sh

#
# portsync - POSIX-compliant script for emerald that synchronizes ports
#

# Vars
PRUNE=0
RESET=0
HELP=0
SYNC_REPOS=""
_seen_repos=""

# Print informational messages
msg_info() {
    printf "==> %s\n" "$1"
}

msg_warning() {
    printf "WARNING: %s\n" "$1" >&2
}

msg_error() {
    printf "ERROR: %s\n" "$1" >&2
}

# Create directories if they don't exist
make_dir() {
    [ -d "$1" ] || mkdir -pv "$1" || {
        msg_error "Failed to create directory: $1"
        exit 1
    }
}

# Wrapper for git commands with specific paths
bare_git() {
    git --git-dir="$bare_dir/${port_dir}.git" --work-tree="$worktree/$port_dir" "$@"
}

# Show help message
usage() {
    cat <<'EOF'
Usage:
    portsync <options>

Options:
    -p, --prune	          prune local git repository
    -r, --reset	          reset git repositories
    -s, --source <repos>  sync specific repos only (space-separated)
    -h, --help	          show this help message

Examples:
    portsync                 sync all repos
    portsync --source main   sync only 'main'
    portsync -s main custom  sync 'main' and 'custom'
    portsync -r -s main      reset and sync only 'main'
EOF
}

# Parse command line options
parse_opts() {
    while [ -n "$1" ]; do
        case $1 in
            -p | --prune) PRUNE=1 ;;
            -r | --reset) RESET=1 ;;
            -h | --help) HELP=1 ;;

            -s | --source)
                shift

                while [ -n "$1" ]; do
                    case $1 in
                        -*) break ;;
                        *) SYNC_REPOS="$SYNC_REPOS $1" ;;
                    esac

                    shift
                done

                continue
            ;;

            *)
                msg_error "Invalid options: $1"
                exit 1
            ;;
        esac

        shift
    done
}

# Clean old objects from git repository
prune_local() {
    msg_info "pruning old objects from ${port_dir}..."

    # Expire all old commits and their objects
    bare_git reflog expire --expire-unreachable=now --all || {
        msg_warning "Failed to expire reflog for $port_dir"
        return 1
    }

    # Remove old objects
    bare_git gc --quiet --prune=all || {
        msg_warning "Failed to garbage collect for $port_dir"
        return 1
    }

    return 0
}

# Completely reset repositories
reset_repos() {
    printf "Removing REPOS...\n"

    while read -r _rr_dir _rr_url _ _; do
        case "$_rr_dir" in
            "" | "#"*) continue ;;
        esac

        _rr_port_dir="${_rr_dir##*/}"

        # Skip local repositories without a URL (manually maintained)
        [ -n "$_rr_url" ] || {
            msg_info "Skipping local repo '$_rr_dir' (no URL)"
            continue
        }

        if [ -n "$SYNC_REPOS" ]; then
            case " $SYNC_REPOS " in
                *" $_rr_port_dir "*) ;;
                *) continue ;;
            esac
        fi

        rm -rf "$bare_dir/${_rr_port_dir}.git" "$_rr_dir" || {
            msg_error "Failed to remove repo: $_rr_port_dir"
            exit 1
        }
    done < "$repo_file"

    msg_info "Repos reset completed!"
}

# Synchronize an individual repository
sync_repo() {
    # Usage:
    #   sync_repo <repo dir> <repo url> <repo branch>
    #
    # Arguments:
    #   $1 - Repository destination directory
    #   $2 - Remote repository URL
    #   $3 - Branch to synchronize (optional, default: main)

    repo_dir="$1"
    port_dir="${repo_dir##*/}"
    repo_url="$2"
    repo_branch="${3:-main}"

    msg_info "fetching $2"

    # Ensure worktree directory exists
    make_dir "$repo_dir" || {
        msg_error "Failed to create directory: $repo_dir"
        exit 1
    }

    # Create bare repository if it doesn't exist
    [ -d "$bare_dir/${port_dir}.git" ] || git init --quiet --bare "$bare_dir/${port_dir}.git" || {
        msg_error "Failed to initialize git repository for $port_dir"
        exit 1
    }

    # Ensure 'origin' remote exists and points to the correct URL
    bare_git remote set-url origin "$repo_url" 2>/dev/null || bare_git remote add origin "$repo_url" || {
        msg_error "Failed to configure remote for $port_dir"
        exit 1
    }

    # Shallow fetch (only latest commit), quiet mode
    bare_git fetch --quiet --depth=1 origin "$repo_branch" || {
        msg_error "Failed to fetch from $repo_url (branch: $repo_branch)."
        msg_error "Try running: 'portsync -r'"

        exit 1
    }

    # Update local branch and working tree in one step, quiet mode
    bare_git checkout --quiet -B "$repo_branch" FETCH_HEAD || {
        msg_error "Failed to checkout branch $repo_branch for $port_dir."
        msg_error "Try running: 'portsync -r'"

        exit 1
    }

    # Optional pruning
    [ "$PRUNE" -ne 1 ] || prune_local

    msg_info "${port_dir} ports synced in $repo_dir"
    return 0
}

# Parse command line options
parse_opts "$@"

# Show help if requested
[ "$HELP" -ne 1 ] || {
    usage
    exit 0
}

# Check root permissions
[ "$(id -u)" -eq 0 ] || {
    msg_error "This operation needs root access!"
    exit 1
}

# Define working directories
bare_dir="@CACHE_DIR@/repos"

make_dir "$bare_dir" || {
    msg_error "Failed to create cache directory"
    exit 1
}

worktree="@PORTS_DIR@"

make_dir "$worktree" || {
    msg_error "Failed to create worktree directory"
    exit 1
}

# Check that configuration file exists
repo_file="@SYSCONFDIR@/emerald.repo"

[ -e "$repo_file" ] || {
    msg_error "Missing repo file: $repo_file"
    exit 1
}

# Reset repositories if requested
[ "$RESET" -eq 1 ] && reset_repos

# Process each repository from configuration file
printf "Syncing PORTS...\n"

while read -r repo_dir repo_url repo_branch _; do
    case "$repo_dir" in
        "" | "#"*) continue ;;
    esac

    _port_dir="${repo_dir##*/}"

    if [ -n "$SYNC_REPOS" ]; then
        case " $SYNC_REPOS " in
            *" $_port_dir "*) _seen_repos="$_seen_repos $_port_dir" ;;
            *) continue ;;
        esac
    fi

    # Skip entries without a URL (local repositories)
    [ -n "$repo_url" ] || {
        msg_warning "No URL for repo '$repo_dir', skipping."
        continue
    }

    sync_repo "$repo_dir" "$repo_url" "${repo_branch:-main}" || {
        msg_error "Sync failed for repository $repo_dir"
        exit 1
    }
done < "$repo_file"

# Warn about any requested repositories that were not found in the config file
if [ -n "$SYNC_REPOS" ]; then
    for _req in $SYNC_REPOS; do
        case " $_seen_repos " in
            *" $_req "*) ;;
            *) msg_warning "Repo '$_req' not found in $repo_file" ;;
        esac
    done
fi

exit 0
