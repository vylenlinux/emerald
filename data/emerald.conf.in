#
# @SYSCONFDIR@/emerald.conf: emerald configuration file
#

export CFLAGS="-O2 -march=x86-64 -pipe"
export CXXFLAGS="${CFLAGS}"
export FCFLAGS="${CFLAGS}"
export FFLAGS="${CFLAGS}"
export MAKEFLAGS="-j$(nproc)"
export LDFLAGS="-Wl,-O1 -Wl,--as-needed -Wl,-z,pack-relative-relocs"

# SOURCE_DIR="@CACHE_DIR@/sources"
# PACKAGE_DIR="@CACHE_DIR@/packages"
# WORK_DIR="@CACHE_DIR@/work"
# CURL_OPTS=""
# COMPRESSION_MODE="xz"
# NO_STRIP="no"
# IGNORE_CHECKSUM="no"
# KEEP_DOC="no"
# KEEP_LIBTOOL="no"
# KEEP_LOCALE="yes"
# KEEP_MAN="yes"
# KEEP_INFO="yes"
# KEEP_HELP="no"
# NOCOLOR="no"
# THEME="vylen"   # variants: 'dracula', 'nord', 'vylen' (default)
