#compdef revdep

_revdep() {
    local state
    local ret=1

    _arguments -C \
        '(-a --all)'{-a,--all}'[check all installed ports]' \
        '(-r --rebuild)'{-r,--rebuild}'[rebuild ports with broken dependencies]' \
        '(-p --package)'{-p,--package}'[check reverse dependencies of this package]:installed port:->installed' \
        '(-f --no-filter)'{-f,--no-filter}'[do not filter results]' \
        '*'{-e,--exclude}'[exclude ports from rebuild]:port:->ports' \
        '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
        '(-h --help)'{-h,--help}'[show help message]' && ret=0

    case $state in
        installed) compadd -- ${${(f)"$(emerald installed 2>/dev/null)"}%% *} && ret=0 ;;
        ports) compadd -- ${(f)"$(emerald list 2>/dev/null)"} && ret=0 ;;
    esac

    return ret
}

_revdep "$@"
