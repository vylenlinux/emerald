#compdef portcreate

_portcreate() {
    local state
    local ret=1

    _arguments -C \
        '-b[build system of the new port]:builder:(autotools meson cmake golang python3 rust gpep517)' \
        '(-h --help)'{-h,--help}'[show help message]' \
        '1:new port name:' && ret=0

    return ret
}

_portcreate "$@"
