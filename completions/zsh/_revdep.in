#compdef revdep

_revdep() {
    local state
    local ret=1

    _arguments -C \
        '(-a --all)'{-a,--all}'[check all installed ports]' \
        '(-r --rebuild)'{-r,--rebuild}'[rebuild ports with broken dependencies]' \
        '(-f --no-filter)'{-f,--no-filter}'[do not filter results]' \
        '*'{-e,--exclude}'[exclude ports from rebuild]:installed port:->installed' \
        '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
        '(-h --help)'{-h,--help}'[show help message]' && ret=0

    case $state in
        installed) compadd -- ${${(f)"$(@PROJECT_NAME@ installed 2>/dev/null)"}%% *} && ret=0 ;;
    esac

    return ret
}

_revdep "$@"
