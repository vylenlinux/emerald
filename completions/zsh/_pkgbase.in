#compdef pkgbase

_pkgbase() {
    local state
    local ret=1

    _arguments -C \
        '(-n --dryrun)'{-n,--dryrun}'[show what would be removed without removing]' \
        '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
        '(-h --help)'{-h,--help}'[show help message]' \
        '*:installed port:->installed' && ret=0

    case $state in
        installed) compadd -- ${${(f)"$(@PROJECT_NAME@ installed 2>/dev/null)"}%% *} && ret=0 ;;
    esac

    return ret
}

_pkgbase "$@"
