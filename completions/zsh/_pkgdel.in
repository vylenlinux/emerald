#compdef pkgdel

_pkgdel() {
    local state
    local ret=1

    _arguments -C \
        '(-h --help)'{-h,--help}'[show help message]' \
        '(-v --verbose)'{-v,--verbose}'[print files removed]' \
        '--root=[remove from custom root directory]:root directory:_directories' \
        '1:installed port:->installed' && ret=0

    case $state in
        installed)
            local db_dir
            local -a pkgs

            db_dir=$(pkgadd --print-db-dir 2>/dev/null)
            pkgs=(${db_dir}/*(N:t))

            compadd -- $pkgs && ret=0
        ;;
    esac

    return ret
}

_pkgdel "$@"
