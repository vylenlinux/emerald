# bash completion for portsync

_portsync_repos() {
    awk '!/^[[:space:]]*(#|$)/ {
        n = split($1, a, "/");
        print a[n];
    }' @SYSCONFDIR@/@PROJECT_NAME@.repo 2>/dev/null
}

_portsync() {
    local cur
    local w
    local i
    local in_source=0

    COMPREPLY=()
    cur=${COMP_WORDS[COMP_CWORD]}

    for ((i = 1; i < COMP_CWORD; i++)); do
        w=${COMP_WORDS[i]}

        case $w in
            -s | --source) in_source=1 ;;
            -*) in_source=0 ;;
        esac
    done

    if [[ $cur != -* && $in_source -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$(_portsync_repos)" -- "$cur"))
        return
    fi

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "-p --prune -r --reset -s --source -h --help" -- "$cur"))
    fi
}

complete -F _portsync portsync
