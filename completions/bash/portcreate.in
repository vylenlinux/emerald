# bash completion for portcreate

_portcreate() {
    local cur
    local prev

    COMPREPLY=()
    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD - 1]}

    if [[ $prev == -b ]]; then
        COMPREPLY=($(compgen -W "autotools meson cmake golang python3 rust gpep517" -- "$cur"))
        return
    fi

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "-b -h" -- "$cur"))
    fi
}

complete -F _portcreate portcreate
