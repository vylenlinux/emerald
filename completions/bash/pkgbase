# bash completion for pkgbase

_pkgbase() {
    local cur
    COMPREPLY=()
    cur=${COMP_WORDS[COMP_CWORD]}

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "-n --dryrun -y --yes -h --help" -- "$cur"))
        return
    fi

    COMPREPLY=($(compgen -W "$(emerald installed 2>/dev/null | cut -d' ' -f1)" -- "$cur"))
}

complete -F _pkgbase pkgbase
