# bash completion for pkgbuild

_pkgbuild() {
    local cur prev
    COMPREPLY=()
    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD-1]}

    if [[ $prev == "=" ]]; then
        case ${COMP_WORDS[COMP_CWORD-2]} in
            --config)
                compopt -o filenames 2>/dev/null
                COMPREPLY=($(compgen -f -- "$cur"))
            ;;

            --srcdir | --pkgdir | --workdir | --root)
                compopt -o dirnames 2>/dev/null
                COMPREPLY=($(compgen -d -- "$cur"))
            ;;
        esac

        return
    fi

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "-q --quiet -i --install -u --upgrade -r --reinstall -c --ignore-conflict -v --verbose -f --force-rebuild -m --skip-checksum -g --gen-checksum -o --download -x --extract -p --pkgfiles -w --keep-work -h --help -C --clean --config= --srcdir= --pkgdir= --workdir= --jobs= --no-backup --root=" -- "$cur"))
    fi
}

complete -F _pkgbuild pkgbuild
