#compdef @PROJECT_NAME@ pkgadd pkgbase pkgbuild pkgdel pkgrebuild portcreate portsync revdep updateconf xchroot

# zsh completion for @PROJECT_NAME@

# {{{ @PROJECT_NAME@
_emerald() {
    local state
    local ret=1

    local -a cmds

    cmds=(
        'search:find ports in repo'
        'sync:update ports database'
        'build:build ports'
        'install:install ports'
        'upgrade:upgrade ports'
        'sysup:full system upgrade'
        'remove:remove installed ports'
        'deplist:print all dependencies for ports'
        'redeps:find redundant dependencies'
        'cache:clean packages and sources cache'
        'cat:print build script of a port'
        'config:print @PROJECT_NAME@ config'
        'dependent:print reverse dependencies'
        'depends:print dependencies'
        'conflicts:print conflicting ports'
        'dup:print duplicate ports'
        'files:print files installed'
        'foreign:print foreign ports'
        'help:print help'
        'hook:run port hook on demand'
        'info:print information about a port'
        'installed:print all installed ports'
        'integrity:check installed port integrity'
        'is-installed:check whether port is installed'
        'locate:print location of file in ports repo'
        'alias:manage aliased ports'
        'mask:manage masked ports'
        'missing-deps:print missing dependencies'
        'orphan:print orphan installed ports'
        'outdated:print outdated ports'
        'path:print path of port in repo'
        'provide:print port that provides file'
        'purge:remove installed ports and their orphan dependencies'
        'trigger:run system trigger'
        'world:print, add or remove world list'
        'list:print all available ports'
        'version:print version information'
    )

    _arguments -C \
        '--append-repo=[append custom local repo path]:directory:_directories' \
        '--prepend-repo=[prepend custom local repo path]:directory:_directories' \
        '--override-repo=[override repo file with custom local repo]:directory:_directories' \
        '--repo=[append custom repo path]:directory:_directories' \
        '--repo-file=[use custom repo file]:file:_files' \
        '--config-file=[use custom config file]:file:_files' \
        '--alias-file=[use custom alias file]:file:_files' \
        '--mask-file=[use custom mask file]:file:_files' \
        '1: :->command' \
        '*:: :->args' && ret=0

    case $state in
        command) _describe -t commands '@PROJECT_NAME@ command' cmds && ret=0 ;;

        args)
            case $words[1] in
                search)
                    _arguments \
                        '(-n --name)'{-n,--name}'[search in port names only]' \
                        '1:pattern:' && ret=0
                ;;

                sync)
                    _arguments \
                        '(-p --prune)'{-p,--prune}'[prune local git repository]' \
                        '(-r --reset)'{-r,--reset}'[reset git repositories]' \
                        '*'{-s,--source}'[sync only the given repositories]:repository:->repos' && ret=0
                ;;

                build)
                    _arguments \
                        '(-q --quiet)'{-q,--quiet}'[show only status messages and errors]' \
                        '(-i --install)'{-i,--install}'[install package after build]' \
                        '(-u --upgrade)'{-u,--upgrade}'[upgrade package after build]' \
                        '(-r --reinstall)'{-r,--reinstall}'[reinstall package after build]' \
                        '(-c --ignore-conflict)'{-c,--ignore-conflict}'[ignore conflicts when installing package]' \
                        '(-v --verbose)'{-v,--verbose}'[print files installed]' \
                        '(-f --force-rebuild)'{-f,--force-rebuild}'[force rebuild package]' \
                        '(-m --skip-checksum)'{-m,--skip-checksum}'[skip checksum checking]' \
                        '(-g --gen-checksum)'{-g,--gen-checksum}'[generate checksums]' \
                        '(-o --download)'{-o,--download}'[download sources only]' \
                        '(-x --extract)'{-x,--extract}'[extract sources only]' \
                        '(-p --pkgfiles)'{-p,--pkgfiles}'[generate package file list]' \
                        '(-w --keep-work)'{-w,--keep-work}'[keep working directory]' \
                        '-y[skip ask user confirmation]' \
                        '(-C --clean)'{-C,--clean}'[remove downloaded sources and prebuilt packages]' \
                        '--config=[use custom config file]:config file:_files' \
                        '--srcdir=[use custom source directory]:directory:_directories' \
                        '--pkgdir=[use custom package directory]:directory:_directories' \
                        '--workdir=[use custom work directory]:directory:_directories' \
                        '--root=[install to custom root directory]:root directory:_directories' \
                        '--log[log build process]' \
                        '--jobs=[override parallel build jobs]:jobs:' \
                        '--no-backup[skip backup when upgrading package]' \
                        '*:port:->ports' && ret=0
                ;;

                install)
                    _arguments \
                        '(-q --quiet)'{-q,--quiet}'[show only status messages and errors]' \
                        '(-i --install)'{-i,--install}'[install package after build]' \
                        '(-u --upgrade)'{-u,--upgrade}'[upgrade package after build]' \
                        '(-r --reinstall)'{-r,--reinstall}'[reinstall package after build]' \
                        '(-c --ignore-conflict)'{-c,--ignore-conflict}'[ignore conflicts when installing package]' \
                        '(-v --verbose)'{-v,--verbose}'[print files installed]' \
                        '(-f --force-rebuild)'{-f,--force-rebuild}'[force rebuild package]' \
                        '(-m --skip-checksum)'{-m,--skip-checksum}'[skip checksum checking]' \
                        '(-g --gen-checksum)'{-g,--gen-checksum}'[generate checksums]' \
                        '(-o --download)'{-o,--download}'[download sources only]' \
                        '(-x --extract)'{-x,--extract}'[extract sources only]' \
                        '(-p --pkgfiles)'{-p,--pkgfiles}'[generate package file list]' \
                        '(-w --keep-work)'{-w,--keep-work}'[keep working directory]' \
                        '-n[skip dependencies]' \
                        '(-y --yes)'{-y,--yes}'[skip ask user confirmation]' \
                        '--exclude=[exclude dependencies, comma separated]:ports:->ports' \
                        '--no-backup[skip backup when reinstalling package]' \
                        '--config=[use custom config file]:config file:_files' \
                        '--srcdir=[use custom source directory]:directory:_directories' \
                        '--pkgdir=[use custom package directory]:directory:_directories' \
                        '--workdir=[use custom work directory]:directory:_directories' \
                        '--root=[install to custom root directory]:root directory:_directories' \
                        '--jobs=[override parallel build jobs]:jobs:' \
                        '*:port:->ports' && ret=0
                ;;

                upgrade)
                    _arguments \
                        '(-q --quiet)'{-q,--quiet}'[show only status messages and errors]' \
                        '(-i --install)'{-i,--install}'[install package after build]' \
                        '(-u --upgrade)'{-u,--upgrade}'[upgrade package after build]' \
                        '(-r --reinstall)'{-r,--reinstall}'[reinstall package after build]' \
                        '(-c --ignore-conflict)'{-c,--ignore-conflict}'[ignore conflicts when installing package]' \
                        '(-v --verbose)'{-v,--verbose}'[print files installed]' \
                        '(-f --force-rebuild)'{-f,--force-rebuild}'[force rebuild package]' \
                        '(-m --skip-checksum)'{-m,--skip-checksum}'[skip checksum checking]' \
                        '(-g --gen-checksum)'{-g,--gen-checksum}'[generate checksums]' \
                        '(-o --download)'{-o,--download}'[download sources only]' \
                        '(-x --extract)'{-x,--extract}'[extract sources only]' \
                        '(-p --pkgfiles)'{-p,--pkgfiles}'[generate package file list]' \
                        '(-w --keep-work)'{-w,--keep-work}'[keep working directory]' \
                        '-n[skip dependencies]' \
                        '(-y --yes)'{-y,--yes}'[skip ask user confirmation]' \
                        '--exclude=[exclude dependencies, comma separated]:ports:->ports' \
                        '--no-backup[skip backup when upgrading package]' \
                        '--config=[use custom config file]:config file:_files' \
                        '--srcdir=[use custom source directory]:directory:_directories' \
                        '--pkgdir=[use custom package directory]:directory:_directories' \
                        '--workdir=[use custom work directory]:directory:_directories' \
                        '--root=[install to custom root directory]:root directory:_directories' \
                        '--jobs=[override parallel build jobs]:jobs:' \
                        '*:installed port:->installed' && ret=0
                ;;

                sysup)
                    _arguments \
                        '(-q --quiet)'{-q,--quiet}'[show only status messages and errors]' \
                        '(-i --install)'{-i,--install}'[install package after build]' \
                        '(-u --upgrade)'{-u,--upgrade}'[upgrade package after build]' \
                        '(-r --reinstall)'{-r,--reinstall}'[reinstall package after build]' \
                        '(-c --ignore-conflict)'{-c,--ignore-conflict}'[ignore conflicts when installing package]' \
                        '(-v --verbose)'{-v,--verbose}'[print files installed]' \
                        '(-f --force-rebuild)'{-f,--force-rebuild}'[force rebuild package]' \
                        '(-m --skip-checksum)'{-m,--skip-checksum}'[skip checksum checking]' \
                        '(-g --gen-checksum)'{-g,--gen-checksum}'[generate checksums]' \
                        '(-o --download)'{-o,--download}'[download sources only]' \
                        '(-x --extract)'{-x,--extract}'[extract sources only]' \
                        '(-p --pkgfiles)'{-p,--pkgfiles}'[generate package file list]' \
                        '(-w --keep-work)'{-w,--keep-work}'[keep working directory]' \
                        '-n[skip dependencies]' \
                        '(-y --yes)'{-y,--yes}'[skip ask user confirmation]' \
                        '--exclude=[exclude dependencies, comma separated]:ports:->ports' \
                        '--no-backup[skip backup when upgrading package]' \
                        '--config=[use custom config file]:config file:_files' \
                        '--srcdir=[use custom source directory]:directory:_directories' \
                        '--pkgdir=[use custom package directory]:directory:_directories' \
                        '--workdir=[use custom work directory]:directory:_directories' \
                        '--root=[install to custom root directory]:root directory:_directories' \
                        '--jobs=[override parallel build jobs]:jobs:' && ret=0
                ;;

                remove | purge)
                    _arguments \
                        '(-y --yes)'{-y,--yes}'[skip ask user confirmation]' \
                        '(-h --help)'{-h,--help}'[show help message]' \
                        '(-v --verbose)'{-v,--verbose}'[print files removed]' \
                        '--root=[remove from custom root directory]:root directory:_directories' \
                        '*:installed port:->installed' && ret=0
                ;;

                deplist)
                    _arguments \
                        '(-q --quick)'{-q,--quick}'[skip installed ports]' \
                        '--exclude=[exclude dependencies, comma separated]:ports:->ports' \
                        '*:port:->ports' && ret=0
                ;;

                redeps)
                    _arguments \
                        '(-w --world)'{-w,--world}'[check redundant entries in world]' \
                        '(-f --fix)'{-f,--fix}'[fix (remove) redundant entries]' \
                        '*:port:->ports' && ret=0
                ;;

                cache)
                    _arguments \
                        '(-p --pkg)'{-p,--pkg}'[clean packages cache only]' \
                        '(-s --src)'{-s,--src}'[clean sources cache only]' && ret=0
                ;;

                info)
                    _arguments \
                        '--field=[print only this field]:field:(description maintainer homepage path name version release commit installed aliased masked depends conflicts required-by)' \
                        '*:port:->ports' && ret=0
                ;;

                hook)
                    _arguments \
                        '1:stage:(pre post)' \
                        '2:action:(install upgrade remove)' \
                        '3:port:->ports' && ret=0
                ;;

                alias | mask)
                    _arguments \
                        '1:command:(list add remove help)' \
                        '*:port:->ports' && ret=0
                ;;

                locate | provide) _arguments '1:file:_files' && ret=0 ;;
                files | trigger | integrity | world) _arguments '*:installed port:->installed' && ret=0 ;;
                cat | depends | conflicts | dependent | path | is-installed) _arguments '*:port:->ports' && ret=0 ;;
            esac

            case $state in
                repos)
                    local -a repos

                    repos=(${(f)"$(awk '!/^[[:space:]]*(#|$)/ {
                        n = split($1, a, "/");
                        print a[n];
                    }' @SYSCONFDIR@/@PROJECT_NAME@.repo 2>/dev/null)"})

                    compadd -- $repos && ret=0
                ;;

                ports) compadd -- ${(f)"$(@PROJECT_NAME@ list 2>/dev/null)"} && ret=0 ;;
                installed) compadd -- ${${(f)"$(@PROJECT_NAME@ installed 2>/dev/null)"}%% *} && ret=0 ;;
            esac
        ;;
    esac

    return ret
}
# }}}

# {{{ pkgadd
_pkgadd() {
    _arguments \
        '(-u --upgrade)'{-u,--upgrade}'[upgrade package]' \
        '(-r --reinstall)'{-r,--reinstall}'[reinstall package]' \
        '(-c --ignore-conflict)'{-c,--ignore-conflict}'[ignore conflicts when installing package]' \
        '(-v --verbose)'{-v,--verbose}'[print files installed]' \
        '(-h --help)'{-h,--help}'[show help message]' \
        '--no-backup[skip backup when upgrading package]' \
        '--print-db-dir[print package database path]' \
        '--root=[install to custom root directory]:root directory:_directories' \
        '1:package file:_files -g "*.epkg.tar.*"'
}
# }}}

# {{{ pkgbase
_pkgbase() {
    local state
    local ret=1

    _arguments -C \
        '(-n --dryrun)'{-n,--dryrun}'[show what would be removed without removing]' \
        '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
        '(-h --help)'{-h,--help}'[show help message]' \
        '*:installed port:->installed' && ret=0

    case $state in
        installed) compadd -- ${${(f)"$(@PROJECT_NAME@ installed 2>/dev/null)"}%% *} && ret=0 ;;
    esac

    return ret
}
# }}}

# {{{ pkgbuild
_pkgbuild() {
    _arguments \
        '(-q --quiet)'{-q,--quiet}'[show only status messages and errors]' \
        '(-i --install)'{-i,--install}'[install package after build]' \
        '(-u --upgrade)'{-u,--upgrade}'[upgrade package after build]' \
        '(-r --reinstall)'{-r,--reinstall}'[reinstall package after build]' \
        '(-c --ignore-conflict)'{-c,--ignore-conflict}'[ignore conflicts when installing package]' \
        '(-v --verbose)'{-v,--verbose}'[print files installed]' \
        '(-f --force-rebuild)'{-f,--force-rebuild}'[force rebuild package]' \
        '(-m --skip-checksum)'{-m,--skip-checksum}'[skip checksum checking]' \
        '(-g --gen-checksum)'{-g,--gen-checksum}'[generate checksums]' \
        '(-o --download)'{-o,--download}'[download sources only]' \
        '(-x --extract)'{-x,--extract}'[extract sources only]' \
        '(-p --pkgfiles)'{-p,--pkgfiles}'[generate package file list]' \
        '(-w --keep-work)'{-w,--keep-work}'[keep working directory]' \
        '(-C --clean)'{-C,--clean}'[remove downloaded sources and prebuilt packages]' \
        '(-h --help)'{-h,--help}'[show help message]' \
        '--config=[use custom config file]:config file:_files' \
        '--srcdir=[use custom source directory]:directory:_directories' \
        '--pkgdir=[use custom package directory]:directory:_directories' \
        '--workdir=[use custom work directory]:directory:_directories' \
        '--jobs=[override parallel build jobs]:jobs:' \
        '--no-backup[skip backup when upgrading package]' \
        '--root=[install to custom root directory]:root directory:_directories'
}
# }}}

# {{{ pkgdel
_pkgdel() {
    local state
    local ret=1

    _arguments -C \
        '(-h --help)'{-h,--help}'[show help message]' \
        '(-v --verbose)'{-v,--verbose}'[print files removed]' \
        '--root=[remove from custom root directory]:root directory:_directories' \
        '1:installed port:->installed' && ret=0

    case $state in
        installed)
            local db_dir
            local -a pkgs

            db_dir=$(pkgadd --print-db-dir 2>/dev/null)
            pkgs=(${db_dir}/*(N:t))

            compadd -- $pkgs && ret=0
        ;;
    esac

    return ret
}
# }}}

# {{{ pkgrebuild
_pkgrebuild() {
    _arguments \
        '(-t --toolchain)'{-t,--toolchain}'[rebuild toolchain packages]' \
        '(-b --base)'{-b,--base}'[rebuild base packages]' \
        '(-h --help)'{-h,--help}'[show help message]'
}
# }}}

# {{{ portcreate
_portcreate() {
    local state
    local ret=1

    _arguments -C \
        '-b[build system of the new port]:builder:(autotools meson cmake golang python3 rust gpep517)' \
        '(-h --help)'{-h,--help}'[show help message]' \
        '1:new port name:' && ret=0

    return ret
}
# }}}

# {{{ portsync
_portsync() {
    local state
    local ret=1

    _arguments -C \
        '(-p --prune)'{-p,--prune}'[prune local git repository]' \
        '(-r --reset)'{-r,--reset}'[reset git repositories]' \
        '*'{-s,--source}'[sync only the given repositories]:repository:->repos' \
        '(-h --help)'{-h,--help}'[show help message]' && ret=0

    case $state in
        repos)
            local -a repos

            repos=(${(f)"$(awk '!/^[[:space:]]*(#|$)/ {
                n = split($1, a, "/");
                print a[n];
            }' @SYSCONFDIR@/@PROJECT_NAME@.repo 2>/dev/null)"})

            compadd -- $repos && ret=0
        ;;
    esac

    return ret
}
# }}}

# {{{ revdep
_revdep() {
    local state
    local ret=1

    _arguments -C \
        '(-a --all)'{-a,--all}'[check all installed ports]' \
        '(-r --rebuild)'{-r,--rebuild}'[rebuild ports with broken dependencies]' \
        '(-f --no-filter)'{-f,--no-filter}'[do not filter results]' \
        '*'{-e,--exclude}'[exclude ports from rebuild]:installed port:->installed' \
        '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
        '(-h --help)'{-h,--help}'[show help message]' && ret=0

    case $state in
        installed) compadd -- ${${(f)"$(@PROJECT_NAME@ installed 2>/dev/null)"}%% *} && ret=0 ;;
    esac

    return ret
}
# }}}

# {{{ updateconf
_updateconf() {
    _arguments '(-h --help)'{-h,--help}'[show help message]'
}
# }}}

# {{{ xchroot
_xchroot() {
    _arguments \
        '1:chroot directory:_directories' \
        '2:command:_command_names -e' \
        '*::command arguments:_normal'
}
# }}}

case $service in
    @PROJECT_NAME@) _@PROJECT_NAME@ ;;
    pkgadd) _pkgadd ;;
    pkgbase) _pkgbase ;;
    pkgbuild) _pkgbuild ;;
    pkgdel) _pkgdel ;;
    pkgrebuild) _pkgrebuild ;;
    portcreate) _portcreate ;;
    portsync) _portsync ;;
    revdep) _revdep ;;
    updateconf) _updateconf ;;
    xchroot) _xchroot ;;
esac
