# fish completion for pkgadd

complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -s u -l upgrade -d 'upgrade package'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -s r -l reinstall -d 'reinstall package'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -s c -l ignore-conflict -d 'ignore conflicts when installing package'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -s v -l verbose -d 'print files installed'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -s h -l help -d 'show help message'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -l no-backup -d 'skip backup when upgrading package'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -l print-db-dir -d 'print package database path'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -l root -r -a '(__fish_complete_directories)' -d 'install to custom root directory'
complete -c pkgadd -n 'not __fish_seen_argument -s h -l help' -a '(__fish_complete_suffix .epkg.tar.zst .epkg.tar.xz .epkg.tar.gz .epkg.tar.bz2 .epkg.tar)' -d 'package file'
