# fish completion for pkgdel

complete -c pkgdel -n 'not __fish_seen_argument -s h -l help' -s h -l help -d 'show help message'
complete -c pkgdel -n 'not __fish_seen_argument -s h -l help' -s v -l verbose -d 'print files removed'
complete -c pkgdel -n 'not __fish_seen_argument -s h -l help' -l root -r -a '(__fish_complete_directories)' -d 'remove from custom root directory'
complete -c pkgdel -n 'not __fish_seen_argument -s h -l help' -f -a '(ls (pkgadd --print-db-dir 2>/dev/null) 2>/dev/null)' -d 'installed port'
