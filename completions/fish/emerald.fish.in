complete -c @PROJECT_NAME@ -n 'not __fish_seen_argument -s h -l help' -l repo-file -r -F -d 'use custom repo file'
complete -c @PROJECT_NAME@ -n 'not __fish_seen_argument -s h -l help' -l config-file -r -F -d 'use custom config file'
complete -c @PROJECT_NAME@ -n 'not __fish_seen_argument -s h -l help' -l alias-file -r -F -d 'use custom alias file'
complete -c @PROJECT_NAME@ -n 'not __fish_seen_argument -s h -l help' -l mask-file -r -F -d 'use custom mask file'

