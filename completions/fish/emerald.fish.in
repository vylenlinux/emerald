# fish completion for @PROJECT_NAME@

complete -c @PROJECT_NAME@ -n 'not __fish_seen_argument -s h -l help' -f

complete -c @PROJECT_NAME@ -n 'not __fish_seen_argument -s h -l help' -l append-repo -r -a '(__fish_complete_directories)' -d 'append custom local repo path'
complete -c @PROJECT_NAME@ -n 'not __fish_seen_argument -s h -l help' -l repo -r -a '(__fish_complete_directories)' -d 'add custom local repo path'
