# fish completion for pkgrebuild

complete -c pkgrebuild -n 'not __fish_seen_argument -s h -l help' -s t -l toolchain -d 'rebuild toolchain packages'
complete -c pkgrebuild -n 'not __fish_seen_argument -s h -l help' -s b -l base -d 'rebuild base packages'
complete -c pkgrebuild -n 'not __fish_seen_argument -s h -l help' -s h -l help -d 'show help message'
