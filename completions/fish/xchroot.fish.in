# fish completion for xchroot

complete -c xchroot -n 'test (count (commandline -opc)) -eq 1; and not __fish_seen_argument -s h -l help' -f -a '(__fish_complete_directories)'
complete -c xchroot -n 'test (count (commandline -opc)) -eq 2; and not __fish_seen_argument -s h -l help' -f -a '(__fish_complete_command)'
