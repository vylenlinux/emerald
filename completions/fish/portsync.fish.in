# fish completion for portsync

complete -c portsync -n 'not __fish_seen_argument -s h -l help' -s p -l prune -d 'prune local git repository'
complete -c portsync -n 'not __fish_seen_argument -s h -l help' -s r -l reset -d 'reset git repositories'
complete -c portsync -n 'not __fish_seen_argument -s h -l help' -s s -l source -r -x -a '(cat @SYSCONFDIR@/@PROJECT_NAME@.repo 2>/dev/null | string match -rv '^\s*(#.*)?$' | string replace -r '\s.*' '' | string replace -r '.*/' '')' -d 'sync only the given repositories'
complete -c portsync -n 'not __fish_seen_argument -s h -l help' -s h -l help -d 'show help message'
