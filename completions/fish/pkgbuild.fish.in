# fish completion for pkgbuild

complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s q -l quiet -d 'show only status messages and errors'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s i -l install -d 'install package after build'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s u -l upgrade -d 'upgrade package after build'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s r -l reinstall -d 'reinstall package after build'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s c -l ignore-conflict -d 'ignore conflicts when installing package'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s v -l verbose -d 'print files installed'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s f -l force-rebuild -d 'force rebuild package'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s m -l skip-checksum -d 'skip checksum checking'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s g -l gen-checksum -d 'generate checksums'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s o -l download -d 'download sources only'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s x -l extract -d 'extract sources only'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s p -l pkgfiles -d 'generate package file list'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s w -l keep-work -d 'keep working directory'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s C -l clean -d 'remove downloaded sources and prebuilt packages'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -s h -l help -d 'show help message'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -l config -r -F -d 'use custom config file'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -l srcdir -r -a '(__fish_complete_directories)' -d 'use custom source directory'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -l pkgdir -r -a '(__fish_complete_directories)' -d 'use custom package directory'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -l workdir -r -a '(__fish_complete_directories)' -d 'use custom work directory'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -l jobs -r -d 'override parallel build jobs'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -l no-backup -d 'skip backup when upgrading package'
complete -c pkgbuild -n 'not __fish_seen_argument -s h -l help' -l root -r -a '(__fish_complete_directories)' -d 'install to custom root directory'
