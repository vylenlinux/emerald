# fish completion for @PROJECT_NAME@

# {{{ @PROJECT_NAME@
complete -c @PROJECT_NAME@ -f

complete -c @PROJECT_NAME@ -l append-repo -r -a '(__fish_complete_directories)' -d 'append custom local repo path'
complete -c @PROJECT_NAME@ -l prepend-repo -r -a '(__fish_complete_directories)' -d 'prepend custom local repo path'
complete -c @PROJECT_NAME@ -l override-repo -r -a '(__fish_complete_directories)' -d 'override repo file with custom local repo'
complete -c @PROJECT_NAME@ -l repo -r -a '(__fish_complete_directories)' -d 'append custom repo path'
complete -c @PROJECT_NAME@ -l repo-file -r -F -d 'use custom repo file'
complete -c @PROJECT_NAME@ -l config-file -r -F -d 'use custom config file'
complete -c @PROJECT_NAME@ -l alias-file -r -F -d 'use custom alias file'
complete -c @PROJECT_NAME@ -l mask-file -r -F -d 'use custom mask file'

complete -c @PROJECT_NAME@ -n __fish_use_subcommand -a search -d 'find ports in repo'
complete -c @PROJECT_NAME@ -n __fish_use_subcommand -a sync -d 'update ports database'
complete -c @PROJECT_NAME@ -n __fish_use_subcommand -a build -d 'build ports'
