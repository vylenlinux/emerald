project('emerald', 'c', version: '20260419')

subdir('data')

install_data([
    'emerald',
    'pkgadd',
    'pkgbase',
    'pkgbuild',
    'pkgdel',
    'pkgrebuild',
    'portcreate',
    'portsync',
    'revdep',
    'updateconf',
    'xchroot'
], install_dir: get_option('bindir'), install_mode: '-rwxr-xr-x')
